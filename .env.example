# Variables opcionales. En local no hace falta ninguna: Keystatic guarda en los archivos del proyecto.

# Proyecto de Keystatic Cloud «equipo/proyecto» (por defecto el de keystatic.config.ts).
PUBLIC_KEYSTATIC_CLOUD_PROJECT=portfolio-jesu/portfoliojesu

# Solo en local, para probar el panel en modo nube: cloud
PUBLIC_KEYSTATIC_MODO=
