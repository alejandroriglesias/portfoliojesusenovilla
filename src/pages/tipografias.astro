---
/**
 * TEMPORAL — página de prueba de la letra de títulos (no enlazada, noindex,
 * fuera del sitemap). El texto y el menú ya son Manrope. Cada bloque aplica
 * una letra candidata a --font-display sobre piezas reales de la web.
 * «Probar en toda la web» la aplica en todas las páginas, solo en este
 * navegador (ver PruebaFuentes).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Firma from '../components/marca/Firma.astro';
import { FUENTES_PRUEBA, CLAVE_PRUEBA } from '../lib/fuentes-prueba';
---

<BaseLayout titulo="Prueba de letras" noindex>
  <section class="tipos">
    <header class="tipos__cabeza">
      <p class="tipos__eti"><span class="punto" aria-hidden="true"></span>Página de prueba · no está enlazada</p>
      <h1 class="tipos__titulo">La letra grande</h1>
      <p class="tipos__intro">
        El menú y los textos ya están en <strong>Manrope</strong>. Cada bloque muestra las piezas grandes de la web (el
        nombre de la portada, los títulos de página y de obra, los datos de la cartela) con una letra distinta. Con
        «Probar en toda la web» puedes navegar por todas las páginas con esa letra (solo en este navegador).
      </p>
    </header>

    {
      FUENTES_PRUEBA.map((f, i) => (
        <article
          class:list={['pareja', { 'pareja--un-grosor': f.unGrosor }]}
          style={`--font-display: ${f.familia}; --anchura: ${f.anchura ?? 'normal'}`}
          data-fuente={f.id}
        >
          <div class="pareja__cabeza">
            <p class="pareja__n">{String(i + 1).padStart(2, '0')}</p>
            <div>
              <h2 class="pareja__nombre">{f.nombre}</h2>
              <p class="pareja__caracter">{f.caracter}</p>
            </div>
            <button type="button" class="pareja__probar" data-probar={f.id}>
              {f.id === 'syne' ? 'Volver a la actual' : 'Probar en toda la web'}
            </button>
          </div>

          <div class="muestra">
            <div class="muestra__portada">
              <p class="muestra__nombre">Jesús Senovilla</p>
              <p class="muestra__lema">Óleo · Acuarela · Grabado</p>
            </div>

            <div class="muestra__cuerpo">
              <div class="muestra__columna">
                <p class="muestra__pagina">
                  Obra<span class="acento">.</span>
                </p>
                <div class="muestra__sala">
                  <span class="muestra__n">02</span>
                  <span class="muestra__sala-titulo">Acuarela</span>
                </div>
              </div>

              <div class="muestra__columna">
                <p class="muestra__miga">Obra / Acuarela</p>
                <p class="muestra__h">Paisaje abstracto</p>
                <p class="muestra__parrafo">
                  Te confirmo la disponibilidad, el precio final con el envío y te paso los datos para el pago. La obra
                  queda reservada para ti.
                </p>
                <div class="muestra__cartela">
                  <p class="muestra__eti">La obra</p>
                  <dl>
                    <div><dt>Técnica</dt><dd>Acuarela</dd></div>
                    <div><dt>Año</dt><dd>2019</dd></div>
                  </dl>
                </div>
                <div class="muestra__pie-obra">
                  <span class="muestra__pie-titulo"><span class="punto" aria-hidden="true"></span>Repollo</span>
                  <span class="muestra__pie-meta">Óleo · 2019</span>
                </div>
              </div>
            </div>

            <div class="muestra__menu">
              <span class="muestra__firma">
                <Firma alto="40px" />
              </span>
              <nav class="muestra__nav" aria-hidden="true">
                <span class="is-activo">Obra</span>
                <span>Técnicas</span>
                <span>Sobre mí</span>
              </nav>
              <span class="muestra__cta">
                <span class="punto" aria-hidden="true"></span>Contacto
              </span>
            </div>
          </div>
        </article>
      ))
    }
  </section>
</BaseLayout>

<style>
  .tipos {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(48px, 6vw, 88px) var(--gutter) clamp(80px, 10vw, 140px);
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 4vw, 56px);
  }
  .tipos__cabeza {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 52em;
  }
  .tipos__eti,
  .muestra__miga,
  .muestra__eti,
  .muestra__cartela dt,
  .muestra__pie-meta,
  .muestra__lema,
  .muestra__n {
    margin: 0;
    font: 600 11px/1.3 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tipos__eti {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .punto {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }
  .acento {
    color: var(--accent);
  }
  .tipos__titulo {
    margin: 0;
    font-weight: 800;
    font-size: clamp(40px, 5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.04em;
  }
  .tipos__intro {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  /* ---------- Cada pareja ---------- */
  .pareja {
    border-top: 1px solid var(--line);
    padding-top: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  /* Todo lo que es «letra grande» dentro del bloque usa la candidata */
  .pareja :is(.pareja__nombre, .muestra__nombre, .muestra__pagina, .muestra__sala-titulo, .muestra__h, .muestra__cartela dd, .muestra__pie-titulo) {
    font-family: var(--font-display);
    font-stretch: var(--anchura);
  }
  /* Letras de un solo grosor: sin negrita artificial */
  .pareja--un-grosor :is(.pareja__nombre, .muestra__nombre, .muestra__pagina, .muestra__sala-titulo, .muestra__h, .muestra__cartela dd, .muestra__pie-titulo) {
    font-synthesis: none;
  }
  .pareja__cabeza {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px 20px;
  }
  .pareja__n {
    margin: 0;
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .pareja__nombre {
    margin: 0;
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
  }
  .pareja__caracter {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--text-soft);
  }
  .pareja__probar {
    min-height: var(--tap);
    padding: 0 20px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--ink);
    font: 600 14px/1 var(--font-body);
    cursor: pointer;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .pareja__probar:hover,
  .pareja.is-elegida .pareja__probar {
    background: var(--ink);
    color: var(--paper);
  }
  .pareja.is-elegida {
    border-top: 2px solid var(--accent);
  }

  /* ---------- La muestra ---------- */
  .muestra {
    border-radius: 16px;
    background: #efece6;
    overflow: hidden;
  }
  .muestra__portada {
    padding: clamp(36px, 5vw, 64px) 24px clamp(28px, 4vw, 44px);
    text-align: center;
    background: #f5f3ee;
    border-bottom: 1px solid var(--line);
  }
  .muestra__nombre {
    margin: 0;
    font-weight: 800;
    font-size: clamp(44px, 8.4vw, 128px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }
  .muestra__lema {
    margin-top: 16px;
    letter-spacing: 0.32em;
    color: var(--ink);
  }
  .muestra__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 28px 48px;
    padding: 32px 28px;
  }
  .muestra__columna {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }
  .muestra__pagina {
    margin: 0;
    font-weight: 800;
    font-size: clamp(64px, 9vw, 140px);
    line-height: 0.8;
    letter-spacing: -0.055em;
  }
  .muestra__sala {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .muestra__sala-titulo {
    font-weight: 800;
    font-size: clamp(40px, 5.4vw, 88px);
    line-height: 0.86;
    letter-spacing: -0.045em;
  }
  .muestra__h {
    margin: 0;
    font-weight: 700;
    font-size: clamp(32px, 3.4vw, 48px);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .muestra__parrafo {
    margin: 0;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  .muestra__cartela {
    padding: 18px 20px;
    border-radius: 14px;
    background: var(--paper);
  }
  .muestra__eti {
    color: var(--ink);
    margin-bottom: 12px;
  }
  .muestra__cartela dl {
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  .muestra__cartela dd {
    margin: 4px 0 0;
    font-weight: 600;
    font-size: 19px;
  }
  .muestra__pie-obra {
    align-self: flex-start;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 10px 16px 9px 12px;
    border-radius: 3px;
    background: rgba(250, 248, 242, 0.95);
    box-shadow: 0 6px 18px -8px rgba(20, 16, 10, 0.3);
  }
  .muestra__pie-titulo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 15px;
  }
  .muestra__pie-meta {
    padding-left: 14px;
    font-size: 10.5px;
  }
  .muestra__menu {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 10px 24px;
    background: rgba(250, 250, 248, 0.9);
    border-top: 1px solid var(--line);
  }
  .muestra__firma {
    justify-self: start;
    display: flex;
  }
  .muestra__nav {
    display: flex;
    gap: 36px;
    font-size: 15px;
    font-weight: 500;
  }
  .muestra__nav .is-activo {
    box-shadow: inset 0 -2px 0 var(--accent);
    padding-bottom: 4px;
  }
  .muestra__cta {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 11px 20px 11px 16px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font-size: 14px;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .pareja__cabeza {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .pareja__probar {
      grid-column: 1 / -1;
      justify-self: start;
    }
    .muestra__nombre {
      white-space: normal;
      font-size: clamp(40px, 13vw, 72px);
    }
    .muestra__cuerpo {
      grid-template-columns: minmax(0, 1fr);
    }
    .muestra__menu {
      grid-template-columns: 1fr auto;
    }
    .muestra__nav {
      grid-column: 1 / -1;
      grid-row: 2;
      gap: 18px;
    }
  }
</style>

<script define:vars={{ CLAVE_PRUEBA }}>
  const actual = (() => {
    try {
      return localStorage.getItem(CLAVE_PRUEBA) || 'syne';
    } catch {
      return 'syne';
    }
  })();
  document.querySelector(`[data-fuente="${actual}"]`)?.classList.add('is-elegida');
  document.querySelectorAll('[data-probar]').forEach((b) =>
    b.addEventListener('click', () => {
      try {
        if (b.dataset.probar === 'syne') localStorage.removeItem(CLAVE_PRUEBA);
        else localStorage.setItem(CLAVE_PRUEBA, b.dataset.probar);
      } catch {
        /* sin almacenamiento: la prueba no se puede aplicar */
      }
      location.href = '/';
    })
  );
</script>
