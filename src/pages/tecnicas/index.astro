---
/**
 * Técnicas: presentación de las tres técnicas (óleo, acuarela y grabado).
 *
 * - Cabecera con el título y tres paneles que se expanden al pasar el ratón,
 *   cada uno con una obra representativa; llevan a su capítulo.
 * - Un capítulo por técnica: la «materia» de cerca (detalle ampliado de una
 *   obra que se acerca al entrar en pantalla, con el mapa de la obra entera),
 *   el texto, los materiales, el proceso en pasos y, en grabado, sus técnicas
 *   con obra. Debajo, una tira de obras. El grabado va sobre fondo de tinta.
 * - Todo el texto sale del panel (Técnicas → lema, materiales, proceso y texto).
 */
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetalleObra from '../../components/ficha/DetalleObra.astro';
import TiraObras from '../../components/obra/TiraObras.astro';
import { getObras, getObrasDeTecnica, getTecnicas, esMarcador, slugTecnica } from '../../lib/contenido';

const principales = await getTecnicas('principal');
const subtecnicas = await getTecnicas('grabado');
const total = (await getObras()).length;
const n2 = (i: number) => String(i + 1).padStart(2, '0');
const TONOS: Record<string, 'banda' | 'papel' | 'tinta'> = { oleo: 'banda', acuarela: 'papel', grabado: 'tinta' };

const capitulos = await Promise.all(
  principales.map(async (t, i) => {
    const obras = await getObrasDeTecnica(t.id);
    const rep = obras.find((o) => o.data.destacada) ?? obras[0];

    // Panel de la cabecera: la imagen de la técnica (panel) o la de la obra
    // representativa; en grabado, mejor la plancha (se ve el grabado en sí).
    const imgPanel = t.data.imagen ?? (t.id === 'grabado' ? rep?.data.imagenPlancha : null) ?? rep?.data.imagen;
    const panel = imgPanel
      ? await getImage({ src: imgPanel, widths: [480, 720, 960].filter((w) => w <= imgPanel.width), format: 'webp', quality: 80 })
      : undefined;

    // La lupa: una obra con resolución para ampliarla sin que se vea borrosa.
    const macro = rep && rep.data.imagen.width >= 1400 ? rep : obras.find((o) => o.data.imagen.width >= 1400);
    let lupa;
    if (macro) {
      const im = macro.data.imagen;
      const grande = await getImage({ src: im, width: Math.min(im.width, 3000), format: 'webp', quality: 84 });
      const mini = await getImage({ src: im, width: Math.min(im.width, 260), format: 'webp', quality: 70 });
      lupa = {
        src: grande.src,
        mini: mini.src,
        ratio: im.width / im.height,
        x: macro.data.detalle.x,
        y: macro.data.detalle.y,
        auto: !macro.data.detalle.elegido,
        alt: macro.data.alt ?? macro.data.titulo,
        titulo: macro.data.titulo,
        anio: macro.data.anio,
        href: `/obra/${macro.id}`,
      };
    }

    const tira = obras.slice(0, 8);

    const anios = obras.map((o) => o.data.anio).filter((a): a is number => !!a);
    const desde = anios.length ? Math.min(...anios) : undefined;
    const hasta = anios.length ? Math.max(...anios) : undefined;
    const rango = desde ? (desde === hasta ? String(desde) : `${desde}–${hasta}`) : '';

    const subs =
      t.id === 'grabado'
        ? subtecnicas
            .map((s) => ({ id: s.id, nombre: s.data.nombre, n: obras.filter((o) => slugTecnica(o) === s.id).length }))
            .filter((s) => s.n > 0)
        : [];

    const { Content } = await render(t);
    const texto = t.body?.trim() ?? '';

    return {
      id: t.id,
      n: n2(i),
      tono: TONOS[t.id] ?? 'papel',
      nombre: t.data.nombre,
      lema: esMarcador(t.data.lema) ? undefined : t.data.lema,
      materiales: t.data.materiales.filter((m) => !esMarcador(m)),
      proceso: t.data.proceso.filter((p) => p.titulo && !esMarcador(p.titulo)),
      obras: obras.length,
      rango,
      panel,
      lupa,
      tira,
      subs,
      Content,
      tieneTexto: !!texto && !esMarcador(texto),
    };
  })
);
const nn = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  titulo="Técnicas"
  descripcion="Óleo, acuarela y grabado: las tres técnicas de Jesús Senovilla, de cerca. Materiales, proceso y obra."
>
  <section class="cabeza" aria-labelledby="tecnicas-h1">
    <div class="cabeza__in">
      <p class="cabeza__eti">
        <span class="punto" aria-hidden="true"></span>{nn(capitulos.length)} técnicas · {total} obras
      </p>
      <h1 id="tecnicas-h1" class="cabeza__titulo">Técnicas<span class="acento">.</span></h1>
      <p class="cabeza__intro">
        Tres maneras de hacer, tres tiempos distintos: la paciencia del óleo, el agua que decide en la acuarela y la
        plancha que espera al tórculo en el grabado.
      </p>
    </div>

    <nav class="paneles" aria-label="Las tres técnicas">
      {
        capitulos.map((c) => (
          <a class="panel" href={`#${c.id}`}>
            {c.panel && (
              <img
                class="panel__img"
                src={c.panel.src}
                srcset={c.panel.srcSet.attribute}
                sizes="(max-width: 760px) 100vw, 50vw"
                alt=""
                loading="eager"
                decoding="async"
              />
            )}
            <span class="panel__velo" aria-hidden="true" />
            <span class="panel__texto">
              <span class="panel__n">{c.n}</span>
              <span class="panel__nombre">{c.nombre}</span>
              {c.lema && <span class="panel__lema">{c.lema}</span>}
              <span class="panel__cuenta">
                {c.obras} obras{c.rango && ` · ${c.rango}`}
                <span class="panel__flecha" aria-hidden="true">
                  ↓
                </span>
              </span>
            </span>
          </a>
        ))
      }
    </nav>
  </section>

  {
    capitulos.map((c) => (
      <section id={c.id} class:list={['capitulo', `capitulo--${c.tono}`, { 'tema-claro': c.tono === 'tinta' }]} aria-labelledby={`cap-${c.id}`}>
        <div class="capitulo__in">
          <header class="capitulo__cabeza">
            <p class="capitulo__n">
              {c.n} / {nn(capitulos.length)}
            </p>
            <h2 id={`cap-${c.id}`} class="capitulo__titulo">
              {c.nombre}
            </h2>
            {c.lema && <p class="capitulo__lema">{c.lema}</p>}
            <p class="capitulo__datos">
              <span class="punto" aria-hidden="true" />
              {c.obras} obras{c.rango && ` · ${c.rango}`}
            </p>
          </header>

          <div class="capitulo__cuerpo">
            {c.lupa && (
              <figure class="capitulo__lupa">
                <DetalleObra
                  src={c.lupa.src}
                  mini={c.lupa.mini}
                  ratio={c.lupa.ratio}
                  x={c.lupa.x}
                  y={c.lupa.y}
                  auto={c.lupa.auto}
                  alt={c.lupa.alt}
                />
                <figcaption class="capitulo__pie">
                  De cerca: <a href={c.lupa.href}>«{c.lupa.titulo}»</a>
                  {c.lupa.anio && `, ${c.lupa.anio}`}
                </figcaption>
              </figure>
            )}

            <div class="capitulo__texto">
              {c.tieneTexto && (
                <div class="capitulo__desc">
                  <c.Content />
                </div>
              )}

              {c.materiales.length > 0 && (
                <div class="bloque">
                  <h3 class="bloque__eti">Materiales</h3>
                  <ul class="materiales" role="list">
                    {c.materiales.map((m) => (
                      <li>{m}</li>
                    ))}
                  </ul>
                </div>
              )}

              {c.proceso.length > 0 && (
                <div class="bloque">
                  <h3 class="bloque__eti">El proceso</h3>
                  <ol class="pasos" role="list">
                    {c.proceso.map((p, i) => (
                      <li class="paso" style={`--i: ${i}`}>
                        <span class="paso__n" aria-hidden="true">
                          {n2(i)}
                        </span>
                        <span class="paso__titulo">{p.titulo}</span>
                        {p.texto && <span class="paso__texto">{p.texto}</span>}
                      </li>
                    ))}
                  </ol>
                </div>
              )}

              {c.subs.length > 0 && (
                <div class="bloque">
                  <h3 class="bloque__eti">Técnicas de grabado con obra</h3>
                  <ul class="subs" role="list">
                    {c.subs.map((s) => (
                      <li>
                        <a href={`/tecnicas/${s.id}`}>
                          {s.nombre}
                          <sup>{s.n}</sup>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="capitulo__acciones">
                <a class="boton-cap" href={`/tecnicas/${c.id}`}>
                  <span class="punto" aria-hidden="true" />
                  Ver las {c.obras} obras
                  <span class="flecha" aria-hidden="true">
                    →
                  </span>
                </a>
              </div>
            </div>
          </div>

          <div class="capitulo__tira">
            <TiraObras
              obras={c.tira}
              etiqueta={`Obras en ${c.nombre.toLowerCase()}`}
              fin={{ href: `/tecnicas/${c.id}`, texto: `Ver las ${c.obras}` }}
            />
          </div>
        </div>
      </section>
    ))
  }

  <section class="cierre" aria-label="Seguir">
    <div class="cierre__in">
      <p class="cierre__titulo">¿Te interesa alguna obra<span class="acento">?</span></p>
      <div class="cierre__acciones">
        <a class="boton-cap" href="/obra">
          <span class="punto" aria-hidden="true"></span>Ver toda la obra <span class="flecha" aria-hidden="true">→</span>
        </a>
        <a class="cierre__enlace" href="/contacto">Escríbeme</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(html) {
      scroll-behavior: smooth;
    }
  }
  .punto {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }
  .acento {
    color: var(--accent);
  }

  /* ---------- Cabecera ---------- */
  .cabeza {
    background: var(--paper);
    padding-bottom: clamp(48px, 6vw, 88px);
  }
  .cabeza__in {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 104px) var(--gutter) clamp(32px, 4vw, 52px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 400px);
    grid-template-areas:
      'eti eti'
      'titulo intro';
    align-items: end;
    gap: 20px clamp(24px, 4vw, 64px);
  }
  .cabeza__eti {
    grid-area: eti;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cabeza__titulo {
    grid-area: titulo;
    margin: 0;
    font-size: clamp(80px, 15vw, 240px);
    line-height: 0.82;
    letter-spacing: -0.015em;
  }
  .cabeza__intro {
    grid-area: intro;
    margin: 0;
    padding-bottom: 0.6em;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  /* Tres paneles que se expanden al pasar el ratón */
  .paneles {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    gap: 10px;
    height: clamp(440px, 64svh, 720px);
  }
  .panel {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    overflow: hidden;
    border-radius: 6px;
    background: var(--card);
    color: var(--paper);
    text-decoration: none;
    transition: flex-grow 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .panel__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.08);
    transition: transform 1.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .panel__velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 12, 10, 0) 38%, rgba(14, 12, 10, 0.72));
    transition: background 0.6s ease;
  }
  .panel__texto {
    position: absolute;
    left: clamp(18px, 2vw, 28px);
    right: clamp(18px, 2vw, 28px);
    bottom: clamp(18px, 2vw, 26px);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .panel__n,
  .panel__cuenta {
    font: 600 11px/1 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(250, 250, 248, 0.85);
  }
  .panel__nombre {
    font-family: var(--font-display);
    font-size: clamp(48px, 5.4vw, 92px);
    line-height: 0.9;
    letter-spacing: -0.01em;
  }
  .panel__lema {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 1.6vw, 24px);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .panel__cuenta {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }
  .panel__flecha {
    font-size: 14px;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .panel:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  @media (hover: hover) and (min-width: 761px) {
    .paneles:hover .panel {
      flex-grow: 0.8;
    }
    .paneles .panel:hover,
    .paneles .panel:focus-visible {
      flex-grow: 1.9;
    }
    .panel:hover .panel__img,
    .panel:focus-visible .panel__img {
      transform: scale(1);
    }
    .panel:hover .panel__flecha {
      transform: translateY(4px);
    }
    /* El lema aparece en el panel que se abre */
    .panel__lema {
      max-height: 0;
      opacity: 0;
      transform: translateY(8px);
      transition:
        max-height 0.6s ease,
        opacity 0.5s ease,
        transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .panel:hover .panel__lema,
    .panel:focus-visible .panel__lema {
      max-height: 2em;
      opacity: 1;
      transform: none;
      transition-delay: 0.15s;
    }
  }

  /* ---------- Capítulos ---------- */
  .capitulo {
    --c-fondo: var(--paper);
    --c-texto: var(--ink);
    --c-suave: var(--text-soft);
    --c-tenue: var(--muted);
    --c-linea: var(--line);
    --c-boton: var(--ink);
    --c-sobre-boton: var(--paper);
    scroll-margin-top: 96px;
    padding: clamp(80px, 10vw, 150px) var(--gutter);
    background: var(--c-fondo);
    color: var(--c-texto);
  }
  .capitulo--banda {
    --c-fondo: var(--band);
  }
  .capitulo--tinta {
    --c-fondo: #141312;
    --c-texto: var(--paper);
    --c-suave: #cfccc5;
    --c-tenue: #a8a59e;
    --c-linea: rgba(250, 250, 248, 0.14);
    --c-boton: var(--paper);
    --c-sobre-boton: var(--ink);
  }
  .capitulo--tinta :focus-visible {
    outline-color: var(--accent-on-dark);
  }
  .capitulo__in {
    max-width: var(--container);
    margin: 0 auto;
  }

  .capitulo__cabeza {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'n n'
      'titulo titulo'
      'lema datos';
    align-items: end;
    gap: 14px 32px;
    padding-bottom: clamp(32px, 4vw, 56px);
    margin-bottom: clamp(40px, 5vw, 72px);
    border-bottom: 1px solid var(--c-linea);
  }
  .capitulo__n,
  .capitulo__datos,
  .bloque__eti {
    margin: 0;
    font: 600 11px/1.3 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-tenue);
  }
  .capitulo__n {
    grid-area: n;
  }
  .capitulo__titulo {
    grid-area: titulo;
    margin: 0;
    font-size: clamp(88px, 15vw, 248px);
    line-height: 0.8;
    letter-spacing: -0.015em;
  }
  .capitulo__lema {
    grid-area: lema;
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(24px, 2.8vw, 42px);
    line-height: 1.15;
  }
  .capitulo__datos {
    grid-area: datos;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--c-texto);
    padding-bottom: 0.6em;
  }

  .capitulo__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 104px);
    align-items: start;
  }
  /* La lupa se queda fija mientras se lee el texto */
  .capitulo__lupa {
    position: sticky;
    top: 104px;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .capitulo__lupa :global(.detalle) {
    height: min(74svh, 680px);
    min-height: 380px;
    border-radius: 4px;
  }
  .capitulo__pie {
    font-size: 13px;
    color: var(--c-tenue);
  }
  .capitulo__pie a {
    color: var(--c-texto);
    text-underline-offset: 3px;
  }

  .capitulo__texto {
    display: flex;
    flex-direction: column;
    gap: clamp(36px, 4vw, 52px);
  }
  .capitulo__desc {
    font-size: clamp(18px, 1.45vw, 21px);
    line-height: 1.6;
    color: var(--c-texto);
  }
  .capitulo__desc :global(p) {
    margin: 0 0 0.9em;
  }
  .capitulo__desc :global(p:last-child) {
    margin-bottom: 0;
  }
  .bloque {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .materiales,
  .subs {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .materiales li,
  .subs a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 16px;
    border: 1px solid var(--c-linea);
    border-radius: var(--radius-pill);
    font-size: 14px;
    color: var(--c-texto);
  }
  .subs a {
    gap: 2px;
    text-decoration: none;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease;
  }
  .subs sup {
    font-size: 10px;
    color: var(--c-tenue);
    transform: translateY(-0.4em);
  }
  .subs a:hover {
    background: var(--c-boton);
    border-color: var(--c-boton);
    color: var(--c-sobre-boton);
  }
  .subs a:hover sup {
    color: inherit;
  }

  .pasos {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 32px;
  }
  .paso {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--c-linea);
  }
  .paso__n {
    font: 600 11px/1 var(--font-body);
    letter-spacing: 0.12em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .capitulo--tinta .paso__n {
    color: var(--accent-on-dark);
  }
  .paso__titulo {
    font-family: var(--font-display);
    font-size: 24px;
    line-height: 1.1;
  }
  .paso__texto {
    font-size: 15px;
    line-height: 1.6;
    color: var(--c-suave);
  }

  .capitulo__acciones {
    display: flex;
  }
  .boton-cap {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    padding: 0 22px 0 18px;
    border-radius: var(--radius-pill);
    background: var(--c-boton, var(--ink));
    color: var(--c-sobre-boton, var(--paper));
    font: 600 14px/1 var(--font-body);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .boton-cap:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .boton-cap:hover .punto {
    background: var(--on-accent);
  }
  .flecha {
    display: inline-block;
    transition: transform 0.35s ease;
  }
  .boton-cap:hover .flecha {
    transform: translateX(4px);
  }

  .capitulo__tira {
    margin-top: clamp(56px, 7vw, 104px);
  }

  /* ---------- Cierre ---------- */
  .cierre {
    background: var(--paper);
    padding: clamp(80px, 10vw, 140px) var(--gutter);
  }
  .cierre__in {
    max-width: var(--container);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 28px 48px;
  }
  .cierre__titulo {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.01em;
  }
  .cierre__acciones {
    display: flex;
