---
/**
 * Índice de obra.
 * - Vista «Sala» (por defecto): una pared por técnica con las obras colgadas
 *   enteras (SalaObras), en la línea de la ficha de obra.
 * - Vista «Índice»: lista editorial con vista previa flotante (IndiceObras).
 * Pestañas por técnica con su número de obras y el mismo indicador de raya y
 * punto bermellón que la galería de la ficha. La vista elegida se recuerda.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import SalaObras from '../../components/obra/SalaObras.astro';
import IndiceObras from '../../components/obra/IndiceObras.astro';
import { etiquetaTecnica, getObras, getTecnicas } from '../../lib/contenido';

const obras = await getObras();
const etiquetas = await Promise.all(obras.map(etiquetaTecnica));
const principales = await getTecnicas('principal');

const grupos = principales
  .map((tecnica) => {
    const indices = obras.flatMap((o, i) => (o.data.tecnica.discriminant === tecnica.id ? [i] : []));
    return { tecnica, obras: indices.map((i) => obras[i]), etiquetas: indices.map((i) => etiquetas[i]) };
  })
  .filter((g) => g.obras.length > 0);

const pestanas = [
  { id: 'todo', nombre: 'Todo', n: obras.length },
  ...grupos.map((g) => ({ id: g.tecnica.id, nombre: g.tecnica.data.nombre, n: g.obras.length })),
];
---

<BaseLayout titulo="Obra" descripcion="Índice de la obra de Jesús Senovilla: óleo, acuarela y grabado." paleta="ficha">
  <div class="obra" data-obra data-vista="sala">
    <header class="cabeza">
      <div class="cabeza__in">
        <p class="cabeza__eti">
          <span class="punto" aria-hidden="true"></span>
          <span data-total>{obras.length}</span>&nbsp;{obras.length === 1 ? 'obra' : 'obras'}
        </p>
        <h1 class="cabeza__titulo">
          <span class="sr-only">Obra</span>
          <span class="cabeza__letras" aria-hidden="true">
            {[...'Obra'].map((l, i) => <span class="letra" style={`animation-delay: ${120 + i * 70}ms`}>{l}</span>)}
            <span class="letra acento" style="animation-delay: 420ms">.</span>
          </span>
        </h1>
        <p class="cabeza__intro">
          {grupos.map((g, i) => (i === 0 ? g.tecnica.data.nombre : g.tecnica.data.nombre.toLowerCase())).join(', ').replace(/, ([^,]*)$/, ' y $1')}. Cada obra, entera y en su pared:
          elige una para verla de cerca.
        </p>
      </div>

      <!-- «Técnicas» del menú apunta aquí: cada pared es una técnica -->
      <div class="barra" id="tecnicas">
        <div class="pestanas" role="group" aria-label="Filtrar por técnica">
          {
            pestanas.map((p, i) => (
              <button class="pestana" type="button" data-filtro={p.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {p.nombre}
                <sup class="pestana__n">{p.n}</sup>
              </button>
            ))
          }
          <span class="pestanas__raya" aria-hidden="true"></span>
        </div>
        <div class="pestanas pestanas--vista" role="group" aria-label="Vista">
          <button class="pestana" type="button" data-vista-boton="sala" aria-pressed="true">Sala</button>
          <button class="pestana" type="button" data-vista-boton="indice" aria-pressed="false">Índice</button>
          <span class="pestanas__raya" aria-hidden="true"></span>
        </div>
      </div>
    </header>

    {
      obras.length === 0 ? (
        <p class="obra__vacio">Todavía no hay obras publicadas.</p>
      ) : (
        <>
          <div class="panel-vista" data-panel="sala">
            <SalaObras grupos={grupos} />
          </div>
          <div class="panel-vista panel-vista--indice" data-panel="indice" hidden>
            <IndiceObras obras={obras} etiquetas={etiquetas} />
          </div>
        </>
      )
    }
  </div>
</BaseLayout>

<style>
  .cabeza {
    background: var(--paper);
  }
  .cabeza__in {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(48px, 7vw, 104px) var(--gutter) clamp(32px, 4vw, 56px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    grid-template-areas:
      'eti eti'
      'titulo intro';
    align-items: end;
    gap: 20px clamp(24px, 4vw, 64px);
  }
  .cabeza__eti {
    grid-area: eti;
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .cabeza__letras {
    display: inline-flex;
    overflow: hidden;
    padding-bottom: 0.06em;
    margin-bottom: -0.06em;
  }
  .letra {
    display: inline-block;
    animation: letra-sube 1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes letra-sube {
    from {
      transform: translateY(105%);
    }
  }
  .cabeza__eti,
  .cabeza__intro,
  .barra {
    animation: aparecer 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .cabeza__eti {
    animation-delay: 0.05s;
  }
  .cabeza__intro {
    animation-delay: 0.45s;
  }
  .barra {
    animation-delay: 0.6s;
  }
  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .cabeza__titulo {
    grid-area: titulo;
    margin: 0;
    font-weight: 800;
    font-size: clamp(72px, 15vw, 240px);
    line-height: 0.8;
    letter-spacing: -0.055em;
  }
  .acento {
    color: var(--accent);
  }
  .cabeza__intro {
    grid-area: intro;
    margin: 0;
    padding-bottom: 0.5em;
    font-size: 17px;
    line-height: 1.55;
    color: var(--text-soft);
  }

  /* ---------- Barra: pestañas de técnica y de vista ---------- */
  .barra {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    justify-content: space-between;
    gap: 0 32px;
    border-bottom: 1px solid var(--line);
  }
  .pestanas {
    display: flex;
    gap: clamp(18px, 3vw, 40px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .pestanas::-webkit-scrollbar {
    display: none;
  }
  .pestanas--vista {
    gap: 24px;
  }
  .pestana {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-height: 56px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: 600 13px/1 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: color 0.3s ease;
  }
  .pestana__n {
    font-size: 10px;
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    transform: translateY(-0.5em);
  }
  .pestana:hover,
  .pestana[aria-pressed='true'] {
    color: var(--ink);
  }
  /* Una sola raya por grupo, que se desliza hasta la pestaña activa,
     con el punto bermellón al final. */
  .pestanas {
    position: relative;
    padding-right: 14px;
  }
  .pestanas__raya {
    position: absolute;
    left: 0;
    bottom: 0;
    width: var(--w, 0px);
    height: 2px;
    background: var(--ink);
    transform: translateX(var(--x, 0px));
    transition:
      transform 0.65s cubic-bezier(0.65, 0, 0.2, 1),
      width 0.65s cubic-bezier(0.65, 0, 0.2, 1);
    pointer-events: none;
  }
  .pestanas__raya::after {
    content: '';
    position: absolute;
    right: -10px;
    top: 50%;
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-radius: 50%;
    background: var(--accent);
  }
  .pestanas__raya.sin-transicion {
    transition: none;
  }

  .panel-vista--indice {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(24px, 4vw, 48px) var(--gutter) clamp(80px, 10vw, 144px);
  }
  .panel-vista[hidden] {
    display: none;
  }
  .obra__vacio {
    max-width: var(--container);
    margin: 0 auto;
    padding: 48px var(--gutter) 120px;
    font-size: 20px;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .cabeza__in {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'eti'
        'titulo'
        'intro';
    }
    .barra {
      padding-right: 0;
    }
    .pestanas--vista {
      width: 100%;
      border-top: 1px solid var(--line);
      order: -1;
    }
    .pestanas {
      gap: 16px;
    }
    .pestana {
      font-size: 12px;
      letter-spacing: 0.06em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pestanas__raya,
    .letra,
    .cabeza__eti,
    .cabeza__intro,
    .barra {
      transition: none;
      animation: none;
    }
  }
</style>

<style is:global>
  /* Transiciones dentro de la página (filtrar, cambiar de vista): cada obra
     se desliza a su nuevo sitio; las que llegan suben y las que se van se
     desvanecen. */
  @media (prefers-reduced-motion: no-preference) {
    html.vt-interna::view-transition-old(root) {
      animation: vt-salir 0.4s ease both;
    }
    html.vt-interna::view-transition-new(root) {
      animation: vt-entrar 0.4s ease both;
    }
    ::view-transition-group(*.pieza) {
      animation-duration: 0.75s;
      animation-timing-function: cubic-bezier(0.65, 0, 0.2, 1);
    }
    ::view-transition-old(*.pieza),
    ::view-transition-new(*.pieza) {
      height: 100%;
    }
    ::view-transition-new(*.pieza):only-child {
      animation: vt-pieza-entra 0.65s cubic-bezier(0.2, 0.7, 0.2, 1) 0.18s both;
    }
    ::view-transition-old(*.pieza):only-child {
      animation: vt-pieza-sale 0.35s ease both;
    }
  }
  @keyframes vt-pieza-entra {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.96);
    }
  }
  @keyframes vt-pieza-sale {
    to {
      opacity: 0;
      transform: scale(0.96);
    }
  }
</style>

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';
  import { EVENTO_CAMBIO, permite } from '../../lib/consentimiento';

  // Clave nueva (antes «obra:vista»): así todo el mundo vuelve a empezar en «Sala».
  const CLAVE = 'obra:modo';
  const raiz = document.querySelector<HTMLElement>('[data-obra]');
  const reducir = matchMedia('(prefers-reduced-motion: reduce)');

  // Scroll suave con inercia (no con movimiento reducido).
  const lenis = reducir.matches ? undefined : new Lenis({ autoRaf: true, lerp: 0.09, anchors: true, allowNestedScroll: true });

  /** Coloca la raya de un grupo bajo su pestaña activa. */
  const moverRaya = (grupo: HTMLElement, animar = true, destino?: HTMLElement) => {
    const raya = grupo.querySelector<HTMLElement>('.pestanas__raya');
    // La raya sale ya hacia la pestaña pulsada, sin esperar a la transición.
    const activa = destino ?? grupo.querySelector<HTMLElement>('[aria-pressed="true"]');
    if (!raya || !activa) return;
    raya.classList.toggle('sin-transicion', !animar);
    raya.style.setProperty('--x', `${activa.offsetLeft}px`);
    raya.style.setProperty('--w', `${activa.offsetWidth}px`);
  };

  /**
   * Aplica un cambio (filtro o vista) con una View Transition: las obras y
   * filas cercanas a la pantalla reciben un nombre para deslizarse a su
   * nuevo sitio. Sin soporte o con movimiento reducido, el cambio es directo.
   */
  const conTransicion = (animables: HTMLElement[], cambio: () => void) => {
    if (!('startViewTransition' in document) || reducir.matches) {
      cambio();
      return;
    }
    const nombrar = () =>
      animables.forEach((el) => {
        const r = el.getBoundingClientRect();
        const cerca = r.height > 0 && r.bottom > -innerHeight * 0.25 && r.top < innerHeight * 1.25;
        el.style.setProperty('view-transition-name', cerca ? (el.dataset.vt ?? '') : '');
        el.style.setProperty('view-transition-class', cerca ? 'pieza' : '');
      });
    nombrar();
    // Fundido cruzado normal de la página (no el de cambio de página).
    document.documentElement.classList.add('vt-interna');
    const vt = document.startViewTransition(() => {
      cambio();
      nombrar();
    });
    vt.finished.finally(() => {
      document.documentElement.classList.remove('vt-interna');
      animables.forEach((el) => {
        el.style.removeProperty('view-transition-name');
        el.style.removeProperty('view-transition-class');
      });
    });
  };

  if (raiz) {
    const filtros = [...raiz.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
    const vistas = [...raiz.querySelectorAll<HTMLButtonElement>('[data-vista-boton]')];
    const paneles = [...raiz.querySelectorAll<HTMLElement>('[data-panel]')];
    const salas = [...raiz.querySelectorAll<HTMLElement>('[data-sala]')];
    const filas = [...raiz.querySelectorAll<HTMLElement>('[data-filtrable]')];
    const piezas = [...raiz.querySelectorAll<HTMLElement>('.pieza')];
    const total = raiz.querySelector('[data-total]');
    const barra = raiz.querySelector<HTMLElement>('.barra');
    const grupos = [...raiz.querySelectorAll<HTMLElement>('.pestanas')];
    piezas.forEach((p, i) => (p.dataset.vt = `pieza-${i}`));
    filas.forEach((f, i) => (f.dataset.vt = `fila-${i}`));
    const animables = [...piezas, ...filas];

    const filtrar = (id: string) => {
      filtros.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filtro === id)));
      salas.forEach((s) => (s.hidden = id !== 'todo' && s.dataset.sala !== id));
      let n = 0;
      filas.forEach((f) => {
        const ver = id === 'todo' || f.dataset.tecnica === id;
        f.hidden = !ver;
        if (ver) {
          n++;
          const num = f.querySelector('[data-num]');
          if (num) num.textContent = String(n).padStart(2, '0');
        }
      });
      if (total) total.textContent = String(n);
    };

    const elegirVista = (vista: string, guardar = true) => {
      vistas.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.vistaBoton === vista)));
      paneles.forEach((p) => (p.hidden = p.dataset.panel !== vista));
      raiz.dataset.vista = vista;
      // Recordar la vista es una «preferencia»: solo con permiso (aviso de cookies).
      if (!guardar || !permite('preferencias')) return;
      try {
        localStorage.setItem(CLAVE, vista);
      } catch {
        /* almacenamiento no disponible */
      }
    };

    // Si la barra quedó por encima, se vuelve a ella con suavidad.
    const volverABarra = () => {
      if (!barra || barra.getBoundingClientRect().top >= 0) return;
      const destino = barra.getBoundingClientRect().top + scrollY - 96;
      if (lenis) lenis.scrollTo(destino, { duration: 1.1 });
      else scrollTo({ top: destino });
    };

    filtros.forEach((b) =>
      b.addEventListener('click', () => {
        if (b.getAttribute('aria-pressed') === 'true') return;
        conTransicion(animables, () => filtrar(b.dataset.filtro ?? 'todo'));
        moverRaya(b.closest('.pestanas')!, true, b);
        volverABarra();
      })
    );
    vistas.forEach((b) =>
      b.addEventListener('click', () => {
        if (b.getAttribute('aria-pressed') === 'true') return;
        conTransicion(animables, () => elegirVista(b.dataset.vistaBoton ?? 'sala'));
        moverRaya(b.closest('.pestanas')!, true, b);
        volverABarra();
      })
    );

    try {
      localStorage.removeItem('obra:vista'); // clave antigua
      const guardada = permite('preferencias') ? localStorage.getItem(CLAVE) : null;
      if (guardada === 'sala' || guardada === 'indice') elegirVista(guardada, false);
    } catch {
      /* sin almacenamiento: vista por defecto */
    }

    // Si se aceptan las preferencias ahora, se recuerda la vista actual.
    document.addEventListener(EVENTO_CAMBIO, () => {
      if (permite('preferencias')) elegirVista(raiz.dataset.vista ?? 'sala');
    });

    // Raya en su sitio al cargar (sin animar) y al cambiar el tamaño.
    const colocarRayas = (animar: boolean) => grupos.forEach((g) => moverRaya(g, animar));
    colocarRayas(false);
    document.fonts?.ready.then(() => colocarRayas(false));
    addEventListener('resize', () => colocarRayas(false));
  }
</script>
