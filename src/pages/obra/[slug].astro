---
/**
 * Ficha de obra (v3): pantalla partida.
 * - Izquierda: las vistas de la obra apiladas, a pantalla completa (GaleriaObra).
 * - Derecha: panel fijo con ruta, título, texto, cartela con los datos y
 *   desplegables (técnica, envío).
 * Debajo: «Cómo se hizo» (si hay proceso) y anterior / siguiente.
 * Al llegar desde una miniatura, la imagen crece hasta su sitio (TransicionObras).
 */
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GaleriaObra from '../../components/ficha/GaleriaObra.astro';
import TiraProceso from '../../components/ficha/TiraProceso.astro';
import ComoComprar from '../../components/ficha/ComoComprar.astro';
import AnteriorSiguiente from '../../components/ficha/AnteriorSiguiente.astro';
import { getObras, slugTecnica, esMarcador, type Obra } from '../../lib/contenido';
import { paletaDe } from '../../lib/portada';
import { getAjustes } from '../../lib/ajustes';
import { obraJsonLd } from '../../lib/datos-estructurados';

export const getStaticPaths = (async () => {
  const obras = await getObras();
  return obras.map((obra, i) => ({
    params: { slug: obra.id },
    props: {
      obra,
      indice: i,
      total: obras.length,
      anterior: obras[(i - 1 + obras.length) % obras.length],
      siguiente: obras[(i + 1) % obras.length],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  obra: Obra;
  indice: number;
  total: number;
  anterior: Obra;
  siguiente: Obra;
}

const { obra, indice, total, anterior, siguiente } = Astro.props;
const d = obra.data;
const colorObra = (await paletaDe(obra))[0];
const t = d.tecnica;
const esGrabado = t.discriminant === 'grabado';
const ajustes = await getAjustes();

const principal = await getEntry('tecnicas', t.discriminant);
const sub = esGrabado ? await getEntry('tecnicas', t.value.subtecnica) : undefined;
const tecnicaConcreta = sub ?? principal;
const nombrePrincipal = principal?.data.nombre ?? t.discriminant;
const nombreConcreto = tecnicaConcreta?.data.nombre ?? slugTecnica(obra);

const n2 = (i: number) => String(i + 1).padStart(2, '0');
const edicion = esGrabado ? t.value.edicion : undefined;

// Texto alternativo: el del CMS o uno construido con los datos de la obra.
const altBase =
  d.alt ??
  [`${d.titulo}`, `${esGrabado ? 'grabado a la ' : ''}${nombreConcreto.toLowerCase()} de Jesús Senovilla`, d.anio]
    .filter(Boolean)
    .join(', ');

const vistas = [
  { imagen: d.imagen, etiqueta: esGrabado ? 'Estampa completa' : 'Obra completa' },
  ...(d.imagenPlancha ? [{ imagen: d.imagenPlancha, etiqueta: 'Plancha' }] : []),
  ...d.vistas.map((v, i) => ({ imagen: v.imagen, etiqueta: v.etiqueta ?? `Vista ${i + 2}` })),
];

// Vista «en casa»: tamaño real si las medidas de la ficha se pueden leer
// («50 × 60 cm»), si no uno típico de la técnica.
const numeros = esMarcador(d.medidas)
  ? []
  : (d.medidas?.match(/\d+(?:[.,]\d+)?/g) ?? []).map((x) => parseFloat(x.replace(',', '.')));
const ladoMedidas = numeros.length >= 2 ? Math.max(numeros[0], numeros[1]) : undefined;
const aEscala = !!ladoMedidas && ladoMedidas >= 5 && ladoMedidas <= 300;
const ambiente = {
  tipo: (t.discriminant === 'oleo' ? 'lienzo' : 'papel') as 'lienzo' | 'papel',
  ladoLargo: aEscala ? ladoMedidas! : t.discriminant === 'oleo' ? 70 : t.discriminant === 'acuarela' ? 42 : 45,
  aEscala,
};

const ESTADOS = {
  disponible: { texto: 'Disponible', color: '#1E6B4F' },
  vendida: { texto: 'Vendida', color: 'var(--accent)' },
  'no-a-la-venta': { texto: 'No a la venta', color: '#5F5E5A' },
} as const;
const estado = d.estado !== 'sin-indicar' ? ESTADOS[d.estado] : undefined;

const ficha = [
  { dt: 'Técnica', dd: nombreConcreto },
  { dt: 'Año', dd: d.anio ? String(d.anio) : undefined },
  { dt: 'Medidas', dd: d.medidas },
  { dt: esGrabado || t.discriminant === 'acuarela' ? 'Papel' : 'Soporte', dd: d.soporte },
  { dt: 'Edición', dd: edicion },
  { dt: 'Interpretación de', dd: d.interpretacionDe },
].filter((f) => f.dd);

const tieneDescripcion = !!obra.body?.trim();
const { Content: Descripcion } = await render(obra);
const tieneTecnica = !!tecnicaConcreta?.body?.trim();
const { Content: TextoTecnica } = tecnicaConcreta ? await render(tecnicaConcreta) : { Content: null };

// Consulta por correo (o, si no hay correo válido, a la página de contacto).
const emailValido = !!ajustes.email && !esMarcador(ajustes.email) && ajustes.email.includes('@');
const asunto = `Consulta sobre «${d.titulo}»${d.anio ? ` (${d.anio})` : ''}`;
const hrefConsulta = emailValido ? `mailto:${ajustes.email}?subject=${encodeURIComponent(asunto)}` : '/contacto';
const textoConsulta = d.estado === 'vendida' ? 'Preguntar por una obra similar' : 'Consultar esta obra';
const envio = ajustes.condicionesEnvio && !esMarcador(ajustes.condicionesEnvio) ? ajustes.condicionesEnvio : undefined;
// «Cómo comprar» solo tiene sentido si la obra se puede comprar.
const seVende = d.estado !== 'vendida' && d.estado !== 'no-a-la-venta';

// Letras del título: una por span, con retardo escalonado.
let k = 0;
const palabrasLetras = d.titulo.split(/\s+/).map((p) => [...p].map((ch) => ({ ch, retardo: 260 + k++ * 32 })));

const og = await getImage({ src: d.imagen, width: 1200, format: 'jpg', quality: 78 });
const descripcionSeo =
  d.entradilla && !d.entradilla.startsWith('[')
    ? d.entradilla
    : `${d.titulo}: ${nombrePrincipal.toLowerCase()}${esGrabado ? ` (${nombreConcreto.toLowerCase()})` : ''}${d.anio ? `, ${d.anio}` : ''}. Obra de Jesús Senovilla.`;

const jsonLd = Astro.site
  ? [
      await obraJsonLd(obra, Astro.site, nombreConcreto, nombrePrincipal),
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Obra', item: new URL('/obra', Astro.site).href },
          { '@type': 'ListItem', position: 2, name: nombrePrincipal, item: new URL(`/tecnicas/${t.discriminant}`, Astro.site).href },
          { '@type': 'ListItem', position: 3, name: d.titulo },
        ],
      },
    ]
  : undefined;
---

<BaseLayout
  titulo={d.titulo}
  descripcion={descripcionSeo}
  cabecera="superpuesta"
  paleta="ficha"
  imagenOg={og.src}
  jsonLd={jsonLd}
>
  <div class="obra">
    <GaleriaObra vistas={vistas} alt={altBase} ambiente={ambiente} detalle={d.detalle} color={colorObra} />

    <section class="panel" aria-labelledby="titulo-obra">
      <div class="panel__in">
        {
          import.meta.env.DEV && (!d.publicada || d.ejemplo) && (
            <p class="aviso-dev">{d.ejemplo ? 'Obra de ejemplo' : 'Obra oculta'}: no se publica. {d.notas}</p>
          )
        }
        <div class="panel__cabeza">
          <nav class="miga" aria-label="Ruta">
            <a href="/obra">Obra</a>
            <span aria-hidden="true">/</span>
            <a href={`/tecnicas/${t.discriminant}`}>{nombrePrincipal}</a>
            {
              sub && (
                <>
                  <span aria-hidden="true">/</span>
                  <a href={`/tecnicas/${sub.id}`}>{sub.data.nombre}</a>
                </>
              )
            }
          </nav>
          <p class="panel__pos">
            <span class="sr-only">Obra </span>{n2(indice)}<span class="panel__total"><span class="sr-only"> de</span> / {String(total).padStart(2, '0')}</span>
          </p>
        </div>

        <h1 id="titulo-obra" class="panel__titulo">
          <span class="sr-only">{d.titulo}</span>
          {
            palabrasLetras.map((letras) => (
              <span class="palabra" aria-hidden="true">
                {letras.map((l) => (
                  <span class="letra" style={`animation-delay: ${l.retardo}ms`}>
                    {l.ch}
                  </span>
                ))}
              </span>
            ))
          }
        </h1>

        {
          (d.entradilla || tieneDescripcion) && (
            <div class="panel__texto">
              {d.entradilla && <p class="panel__entradilla">{d.entradilla}</p>}
              {tieneDescripcion && (
                <div class="panel__descripcion">
                  <Descripcion />
                </div>
              )}
            </div>
          )
        }

        <div class="cartela">
          <div class="cartela__cabeza">
            <h2 class="cartela__etiqueta">La obra</h2>
            <p class="cartela__tipo">{esGrabado ? 'Grabado original' : 'Obra original'}</p>
          </div>
          <dl class="cartela__datos">
            {
              ficha.map((f) => (
                <div>
                  <dt>{f.dt}</dt>
                  <dd>{f.dd}</dd>
                </div>
              ))
            }
            {
              estado && (
                <div>
                  <dt>Estado</dt>
                  <dd class="cartela__estado">
                    <span class="punto" style={`background:${estado.color}`} aria-hidden="true" />
                    {estado.texto}
                  </dd>
                </div>
              )
            }
          </dl>
          {
            d.paleta && (
              <div class="cartela__colores">
                <span class="cartela__mini">Colores</span>
                <span class="muestras">
                  {d.paleta.map((c) => (
                    <span class="muestra" style={`background:${c}`} title={c} />
                  ))}
                </span>
              </div>
            )
          }
          <a class="cartela__consulta" href={hrefConsulta} id="consultar">
            <span class="punto punto--acento" aria-hidden="true"></span>
            {textoConsulta}
            <span class="flecha" aria-hidden="true">→</span>
          </a>
        </div>

        <div class="desplegables">
          {
            tieneTecnica && TextoTecnica && (
              <details class="desplegable">
                <summary>Sobre la técnica · {nombreConcreto}</summary>
                <div class="desplegable__cuerpo">
                  <TextoTecnica />
                  <a class="desplegable__enlace" href={`/tecnicas/${tecnicaConcreta!.id}`}>
                    Más obras en {nombreConcreto.toLowerCase()} →
                  </a>
                </div>
              </details>
            )
          }
          {
            seVende && (
              <a class="desplegable desplegable--enlace" href="#comprar">
                Cómo comprar · transferencia o Bizum <span aria-hidden="true">↓</span>
              </a>
            )
          }
          {
            d.proceso.length > 0 && (
              <a class="desplegable desplegable--enlace" href="#proceso">
                Cómo se hizo <span aria-hidden="true">↓</span>
              </a>
            )
          }
          {
            envio && (
              <details class="desplegable">
                <summary>Envío</summary>
                <div class="desplegable__cuerpo">
                  <p>{envio}</p>
                </div>
              </details>
            )
          }
          <details class="desplegable">
            <summary>Consultas y encargos</summary>
            <div class="desplegable__cuerpo">
              <p>
                Para preguntar por esta obra, su disponibilidad o un encargo, escribe
                {emailValido ? <> a <a href={hrefConsulta}>{ajustes.email}</a></> : <> desde la <a href="/contacto">página de contacto</a></>}.
              </p>
            </div>
          </details>
        </div>
      </div>
    </section>
  </div>

  {seVende && <ComoComprar titulo={d.titulo} hrefConsulta={hrefConsulta} email={emailValido ? ajustes.email : undefined} envio={envio} taller={ajustes.taller && !esMarcador(ajustes.taller) ? ajustes.taller : undefined} />}

  <TiraProceso pasos={d.proceso} titulo={d.titulo} numero="" />

  {
    total > 1 && (
      <AnteriorSiguiente
        anterior={{ href: `/obra/${anterior.id}`, titulo: anterior.data.titulo, numero: n2((indice - 1 + total) % total) }}
        siguiente={{ href: `/obra/${siguiente.id}`, titulo: siguiente.data.titulo, numero: n2((indice + 1) % total) }}
      />
    )
  }
</BaseLayout>

<style>
  .aviso-dev {
    margin: 0;
    padding: 12px 16px;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: 14px;
  }

  /* ---------- Pantalla partida ---------- */
  .obra {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(min(100%, 380px), 1fr);
    background: var(--textura), var(--paper);
  }
  .panel {
    position: relative;
    background: var(--textura), var(--paper);
  }
  .panel__in {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow-y: auto;
    scrollbar-width: thin;
    padding: clamp(112px, 14vh, 150px) clamp(24px, 1rem + 3vw, 72px) clamp(40px, 6vh, 64px);
    display: flex;
    flex-direction: column;
    gap: clamp(28px, 4vh, 40px);
    container-type: inline-size;
  }

  .panel__cabeza {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
  }
  .miga,
  .panel__pos {
    margin: 0;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--muted);
  }
  .miga {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 8px;
  }
  .miga a,
  .desplegable__enlace,
  .panel__descripcion :global(a),
  .desplegable__cuerpo :global(a) {
    position: relative;
    color: inherit;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat right bottom / 0 1px;
    transition: background-size 0.5s var(--ease-out);
  }
  .miga a:hover,
  .desplegable__enlace:hover,
  .panel__descripcion :global(a:hover),
  .desplegable__cuerpo :global(a:hover) {
    background-position: left bottom;
    background-size: 100% 1px;
  }
  .panel__pos {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .panel__total {
    color: var(--muted);
  }

  /* Título: se adapta al ancho del panel (cqi) */
  .panel__titulo {
    margin: -8px 0 0;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.24em;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(36px, min(9.5cqi, 7vh), 84px);
    line-height: 0.98;
    letter-spacing: -0.012em;
    overflow-wrap: anywhere;
  }
  .palabra {
    display: inline-flex;
    flex-wrap: wrap;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .letra {
    display: inline-block;
    animation: subir 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes subir {
    from {
      transform: translateY(105%);
    }
    to {
      transform: none;
    }
  }

  .panel__texto {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 36em;
    margin-top: -8px;
    animation: aparecer 0.8s ease 0.45s both;
  }
  .panel__entradilla {
    margin: 0;
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink);
  }
  .panel__descripcion {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  .panel__descripcion :global(p) {
    margin: 0 0 0.9em;
  }
  .panel__descripcion :global(p:last-child) {
    margin-bottom: 0;
  }
  @keyframes aparecer {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  /* ---------- Cartela ---------- */
  .cartela {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: clamp(22px, 3cqi, 32px);
    background: var(--textura), var(--band);
    border-radius: 14px;
    animation: aparecer 0.8s ease 0.6s both;
  }
  .cartela__cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }
  .cartela__etiqueta,
  .cartela__mini,
  .cartela__datos dt {
    margin: 0;
    font: 600 11px/1.2 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cartela__etiqueta {
    color: var(--ink);
  }
  .cartela__tipo {
    margin: 0;
    font-size: 13px;
    color: var(--muted);
  }
  .cartela__datos {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 24px;
  }
  .cartela__datos div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }
  .cartela__datos dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 1.6vw, 24px);
    line-height: 1.25;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .cartela__estado {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .punto--acento {
    background: var(--accent);
  }
  .cartela__colores {
    display: flex;
    align-items: center;
    gap: 16px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }
  .muestras {
    display: flex;
    gap: 8px;
  }
  .muestra {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }
  .cartela__consulta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    padding: 0 20px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font: 600 14px/1 var(--font-body);
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: background 0.3s ease;
  }
  .cartela__consulta:hover {
    background: var(--accent);
  }
  .cartela__consulta:hover .punto--acento {
    background: var(--textura), var(--paper);
  }
  .flecha {
    display: inline-block;
    transition: transform 0.35s ease;
  }
  .cartela__consulta:hover .flecha {
    transform: translateX(5px);
  }

  /* ---------- Desplegables ---------- */
  .desplegables {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
    animation: aparecer 0.8s ease 0.75s both;
  }
  .desplegable {
    border-bottom: 1px solid var(--line);
  }
  .desplegable summary,
  .desplegable--enlace {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 52px;
    font: 600 12px/1.3 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    cursor: pointer;
    list-style: none;
  }
  .desplegable summary::-webkit-details-marker {
    display: none;
  }
  .desplegable summary::after {
    content: '+';
    font: 400 20px/1 var(--font-body);
    transition: transform 0.35s var(--ease-out);
  }
  .desplegable[open] summary::after {
    transform: rotate(45deg);
  }
  .desplegable--enlace span {
    font-size: 15px;
  }
  .desplegable__cuerpo {
    padding: 0 0 22px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  .desplegable__cuerpo :global(p) {
    margin: 0 0 0.9em;
  }
  .desplegable__enlace {
    display: inline-block;
    font-weight: 600;
    color: var(--ink);
  }
  .desplegable[open] .desplegable__cuerpo {
    animation: aparecer 0.45s ease both;
  }

  /* ---------- Móvil y tableta: una columna ---------- */
  @media (max-width: 900px) {
    .obra {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel__in {
      position: static;
      height: auto;
      overflow: visible;
      padding: 28px var(--gutter) 72px;
    }
    .panel__titulo {
      font-size: clamp(36px, 11cqi, 64px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .letra,
    .panel__texto,
    .cartela,
    .desplegables,
    .desplegable[open] .desplegable__cuerpo {
      animation: none;
    }
  }
</style>
