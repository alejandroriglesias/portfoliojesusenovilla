---
/**
 * Ficha de obra (v2) — prototipo 11-ficha-v2.
 */
import type { GetStaticPaths } from 'astro';
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lupa from '../../components/ficha/Lupa.astro';
import TiraProceso from '../../components/ficha/TiraProceso.astro';
import SobreLaTecnica from '../../components/ficha/SobreLaTecnica.astro';
import ConsultaObra from '../../components/ficha/ConsultaObra.astro';
import AnteriorSiguiente from '../../components/ficha/AnteriorSiguiente.astro';
import { getObras, slugTecnica, type Obra } from '../../lib/contenido';
import { obraJsonLd } from '../../lib/datos-estructurados';

export const getStaticPaths = (async () => {
  const obras = await getObras();
  return obras.map((obra, i) => ({
    params: { slug: obra.id },
    props: {
      obra,
      indice: i,
      total: obras.length,
      anterior: obras[(i - 1 + obras.length) % obras.length],
      siguiente: obras[(i + 1) % obras.length],
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  obra: Obra;
  indice: number;
  total: number;
  anterior: Obra;
  siguiente: Obra;
}

const { obra, indice, total, anterior, siguiente } = Astro.props;
const d = obra.data;
const t = d.tecnica;
const esGrabado = t.discriminant === 'grabado';

const principal = await getEntry('tecnicas', t.discriminant);
const sub = esGrabado ? await getEntry('tecnicas', t.value.subtecnica) : undefined;
const tecnicaConcreta = sub ?? principal;
const nombrePrincipal = principal?.data.nombre ?? t.discriminant;
const nombreConcreto = tecnicaConcreta?.data.nombre ?? slugTecnica(obra);

const n2 = (i: number) => String(i + 1).padStart(2, '0');
const edicion = esGrabado ? t.value.edicion : undefined;

// Texto alternativo: el del CMS o uno construido con los datos de la obra.
const altBase =
  d.alt ??
  [`${d.titulo}`, `${esGrabado ? 'grabado a la ' : ''}${nombreConcreto.toLowerCase()} de Jesús Senovilla`, d.anio]
    .filter(Boolean)
    .join(', ');

const vistas = [
  { imagen: d.imagen, etiqueta: esGrabado ? 'Estampa completa' : 'Obra completa' },
  ...(d.imagenPlancha ? [{ imagen: d.imagenPlancha, etiqueta: 'Plancha' }] : []),
  ...d.vistas.map((v, i) => ({ imagen: v.imagen, etiqueta: v.etiqueta ?? `Vista ${i + 2}` })),
];

const ESTADOS = {
  disponible: { texto: 'Disponible', color: '#1E6B4F' },
  vendida: { texto: 'Vendida', color: 'var(--accent)' },
  'no-a-la-venta': { texto: 'No a la venta', color: '#5F5E5A' },
} as const;
const estado = d.estado !== 'sin-indicar' ? ESTADOS[d.estado] : undefined;

const ficha = [
  { dt: 'Técnica', dd: nombreConcreto },
  { dt: 'Año', dd: d.anio ? String(d.anio) : undefined },
  { dt: 'Medidas', dd: d.medidas },
  { dt: esGrabado || t.discriminant === 'acuarela' ? 'Papel' : 'Soporte', dd: d.soporte },
  { dt: 'Edición', dd: edicion },
  { dt: 'Interpretación de', dd: d.interpretacionDe },
].filter((f) => f.dd);

const tieneDescripcion = !!obra.body?.trim();
const { Content: Descripcion } = await render(obra);

// Letras del título: una por span, con retardo escalonado.
const palabras = d.titulo.split(/\s+/);
const letrasMax = Math.max(...palabras.map((p) => p.length));
let k = 0;
const palabrasLetras = palabras.map((p) => [...p].map((ch) => ({ ch, retardo: 150 + k++ * 90 })));

const og = await getImage({ src: d.imagen, width: 1200, format: 'jpg', quality: 78 });
const descripcionSeo =
  d.entradilla && !d.entradilla.startsWith('[')
    ? d.entradilla
    : `${d.titulo}: ${nombrePrincipal.toLowerCase()}${esGrabado ? ` (${nombreConcreto.toLowerCase()})` : ''}${d.anio ? `, ${d.anio}` : ''}. Obra de Jesús Senovilla.`;

const jsonLd = Astro.site
  ? [
      await obraJsonLd(obra, Astro.site, nombreConcreto, nombrePrincipal),
      {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Obra', item: new URL('/obra', Astro.site).href },
          { '@type': 'ListItem', position: 2, name: nombrePrincipal, item: new URL(`/tecnicas/${t.discriminant}`, Astro.site).href },
          { '@type': 'ListItem', position: 3, name: d.titulo },
        ],
      },
    ]
  : undefined;

let num = 1;
const sec = () => `(${String(num++).padStart(2, '0')})`;
const nFicha = sec();
const nProceso = d.proceso.length ? sec() : '';
const nTecnica = tecnicaConcreta?.body?.trim() ? sec() : '';
const nConsulta = sec();
---

<BaseLayout
  titulo={d.titulo}
  descripcion={descripcionSeo}
  cabecera="superpuesta"
  paleta="ficha"
  imagenOg={og.src}
  jsonLd={jsonLd}
>
  <section class="hero" aria-labelledby="titulo-obra">
    <div class="hero__in">
      {
        import.meta.env.DEV && (!d.publicada || d.ejemplo) && (
          <p class="aviso-dev">{d.ejemplo ? 'Obra de ejemplo' : 'Obra oculta'}: no se publica. {d.notas}</p>
        )
      }
      <div class="hero__barra">
        <a class="hero__volver" href="/obra">
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6"></path></svg>
          Índice
        </a>
        <span>
          <a href={`/tecnicas/${t.discriminant}`}>{nombrePrincipal}s</a>
          {sub && (
            <>
              {' / '}
              <a href={`/tecnicas/${sub.id}`}>{sub.data.nombre}</a>
            </>
          )}
        </span>
        <span class="hero__pos">
          <span class="sr-only">Obra </span>{n2(indice)} <span class="hero__total"><span class="sr-only">de</span>/ {String(total).padStart(2, '0')}</span>
        </span>
      </div>

      <Lupa vistas={vistas} alt={altBase} zoom={3} pie={edicion}>
        <p slot="info" class="hero__dato">
          {nombrePrincipal}{d.anio && ` · ${d.anio}`}
        </p>
      </Lupa>

      <h1 id="titulo-obra" class="hero__titulo" style={`--n: ${letrasMax}`} data-ajustar>
        <span class="sr-only">{d.titulo}</span>
        {
          palabrasLetras.map((letras) => (
            <span class="palabra" aria-hidden="true">
              {letras.map((l) => (
                <span class="letra" style={`animation-delay: ${l.retardo}ms`}>
                  {l.ch}
                </span>
              ))}
            </span>
          ))
        }
      </h1>
    </div>
  </section>

  <section class="ficha" aria-labelledby="ficha-titulo">
    <h2 id="ficha-titulo" class="etiqueta ficha__etiqueta">{nFicha} Ficha</h2>
    <dl class="ficha__datos">
      {
        ficha.map((f) => (
          <div class="ficha__dato">
            <dt>{f.dt}</dt>
            <dd>{f.dd}</dd>
          </div>
        ))
      }
      {
        estado && (
          <div class="ficha__dato">
            <dt>Estado</dt>
            <dd class="ficha__estado">
              <span class="punto" style={`background:${estado.color}`} aria-hidden="true" />
              {estado.texto}
            </dd>
          </div>
        )
      }
    </dl>

    <div class="ficha__texto">
      {d.entradilla ? <p class="ficha__entradilla">{d.entradilla}</p> : <span />}
      <div class="ficha__cuerpo">
        {
          tieneDescripcion && (
            <div class="ficha__descripcion">
              <Descripcion />
            </div>
          )
        }
        <div class="ficha__botones">
          <a class="boton boton--acento" href="#consultar">Consultar esta obra</a>
          {d.proceso.length > 0 && <a class="boton boton--borde" href="#proceso">Ver el proceso</a>}
        </div>
      </div>
    </div>
  </section>

  <TiraProceso pasos={d.proceso} titulo={d.titulo} numero={nProceso} />

  {tecnicaConcreta && <SobreLaTecnica tecnica={tecnicaConcreta} numero={nTecnica} />}

  <ConsultaObra titulo={d.titulo} anio={d.anio} estado={d.estado} numero={nConsulta} />

  {
    total > 1 && (
      <AnteriorSiguiente
        anterior={{ href: `/obra/${anterior.id}`, titulo: anterior.data.titulo, numero: n2((indice - 1 + total) % total) }}
        siguiente={{ href: `/obra/${siguiente.id}`, titulo: siguiente.data.titulo, numero: n2((indice + 1) % total) }}
      />
    )
  }
</BaseLayout>

<style>
  .aviso-dev {
    margin: 0 0 24px;
    padding: 12px 16px;
    border: 1px solid var(--accent-on-dark);
    color: var(--accent-on-dark);
    font-size: 14px;
  }

  /* ---------- Hero negro ---------- */
  .hero {
    background: var(--black);
    color: var(--paper);
    padding: clamp(96px, 9vw, 128px) var(--gutter) 24px;
    overflow: hidden;
  }
  .hero__in {
    max-width: 1344px;
    margin: 0 auto;
  }
  .hero__barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: 13px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 600;
    color: #a8a59e;
  }
  .hero__barra a {
    color: inherit;
    text-decoration: none;
  }
  .hero__barra a:hover {
    color: var(--paper);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .hero__volver {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    color: var(--paper) !important;
  }
  .hero__pos {
    font-variant-numeric: tabular-nums;
    color: var(--paper);
  }
  .hero__total {
    color: #a8a59e;
  }
  .hero :focus-visible {
    outline-color: var(--accent-on-dark);
  }
  .hero__dato {
    margin: 0;
    font-size: 13px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--accent-on-dark);
  }

  /* Título gigante: se adapta a la palabra más larga para no desbordar. */
  .hero__titulo {
    position: relative;
    z-index: 2;
    margin: -0.3em 0 0;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.25em;
    font-weight: 800;
    font-size: clamp(
      48px,
      min(24vw, calc((min(100vw, 1440px) - 2 * var(--gutter)) / (var(--n) * 1.04))),
      380px
    );
    line-height: 0.8;
    letter-spacing: -0.055em;
    color: var(--paper);
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .palabra {
    white-space: nowrap;
  }
  .letra {
    display: inline-block;
    animation: subir 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes subir {
    from {
      transform: translateY(45%) rotate(4deg);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .letra {
      animation: none;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding-top: 124px;
    }
    .hero__titulo {
      margin-top: 0.15em;
    }
  }

  /* ---------- Ficha ---------- */
  .ficha {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(64px, 8vw, 112px) var(--gutter);
  }
  .ficha__etiqueta {
    font-family: var(--font-body);
    margin-bottom: 32px;
  }
  .ficha__datos {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 190px), 1fr));
    column-gap: 32px;
  }
  .ficha__dato {
    padding: 24px 0;
    border-top: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ficha__dato dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .ficha__dato dd {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(22px, 2.2vw, 30px);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .ficha__estado {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .punto {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .ficha__texto {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 40px 80px;
    margin-top: clamp(56px, 7vw, 96px);
    align-items: start;
  }
  .ficha__entradilla {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.03em;
  }
  .ficha__cuerpo {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .ficha__descripcion {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-soft);
  }
  .ficha__descripcion :global(p) {
    margin: 0 0 1em;
  }
  .ficha__descripcion :global(p:last-child) {
    margin-bottom: 0;
  }
  .ficha__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
