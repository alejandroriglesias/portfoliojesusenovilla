---
/** Contacto: bloque a pantalla completa en color de acento (02) + colofón (03). */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAjustes, usuarioInstagram } from '../lib/ajustes';
import { esMarcador } from '../lib/contenido';

const a = await getAjustes();
const emailValido = !!a.email && !esMarcador(a.email) && a.email.includes('@');
const mailto = emailValido ? `mailto:${a.email}` : undefined;
const insta = usuarioInstagram(a.instagram);

const datos = [
  { dt: 'Email', dd: a.email, href: mailto },
  { dt: 'Instagram', dd: insta, href: a.instagram ?? undefined, externo: true },
  { dt: 'Taller', dd: a.taller },
  { dt: 'Encargos', dd: a.encargos },
].filter((x) => x.dd);
---

<BaseLayout titulo="Contacto" descripcion="Escribe a Jesús Senovilla para consultar obras, precios o encargos.">
  <section class="contacto" aria-labelledby="contacto-h1">
    <div class="contacto__in">
      <p class="etiqueta contacto__etiqueta">Contacto</p>
      <h1 id="contacto-h1" class="contacto__h1">
        {
          mailto ? (
            <a href={mailto} data-ajustar>
              Hablemos
              <br />
              <span class="nowrap">
                de una obra&nbsp;<span class="flecha" aria-hidden="true">→</span>
              </span>
            </a>
          ) : (
            <span data-ajustar>
              Hablemos
              <br />
              de una obra
            </span>
          )
        }
      </h1>
      <p class="contacto__texto">Escríbeme para consultar disponibilidad, precios o encargos.</p>
      <div class="contacto__enlaces">
        {mailto ? <a href={mailto}>{a.email}</a> : <span>{a.email}</span>}
        {a.instagram && <a href={a.instagram} rel="me noopener">Instagram · {insta}</a>}
      </div>
    </div>
  </section>

  <section class="colofon" aria-labelledby="colofon-h2">
    <div class="colofon__in">
      <h2 id="colofon-h2" class="colofon__h2" data-ajustar>Colofón</h2>
      <dl class="colofon__lista">
        {
          datos.map((x) => (
            <div class="colofon__fila">
              <dt>{x.dt}</dt>
              <dd>{x.href ? <a href={x.href} rel={x.externo ? 'me noopener' : undefined}>{x.dd}</a> : x.dd}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  .contacto {
    background: var(--accent);
    color: var(--on-accent);
  }
  .contacto__in {
    max-width: var(--container);
    margin: 0 auto;
    min-height: min(78vh, 820px);
    padding: clamp(72px, 10vw, 144px) var(--gutter);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 40px;
  }
  .contacto__etiqueta {
    color: inherit;
  }
  .contacto__h1 {
    font-weight: 800;
    font-size: clamp(40px, 9vw, 156px);
    line-height: 0.9;
    letter-spacing: -0.015em;
  }
  .contacto__h1 a,
  .contacto__h1 > span {
    display: block;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
  }
  .nowrap {
    white-space: nowrap;
  }
  .flecha {
    display: inline-block;
    transition: transform 0.35s ease;
  }
  .contacto__h1 a:hover .flecha {
    transform: translateX(18px);
  }
  .contacto__texto {
    margin: 0;
    max-width: 560px;
    font-size: 20px;
  }
  .contacto__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    font-size: 18px;
  }
  .contacto__enlaces a,
  .contacto__enlaces span {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: inherit;
    text-underline-offset: 5px;
  }
  .contacto :focus-visible {
    outline-color: var(--on-accent);
  }

  .colofon {
    background: var(--textura), var(--band);
  }
  .colofon__in {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(72px, 9vw, 128px) var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 40px 80px;
    align-items: start;
  }
  .colofon__h2 {
    font-weight: 800;
    font-size: clamp(48px, 8.5vw, 140px);
    line-height: 0.86;
    letter-spacing: -0.015em;
  }
  .colofon__lista {
    margin: 0;
    font-size: 17px;
    border-bottom: 1px solid var(--ink);
  }
  .colofon__fila {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    border-top: 1px solid var(--ink);
  }
  .colofon__fila dt {
    padding: 16px 0;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .colofon__fila dd {
    margin: 0;
    padding: 14px 0;
    overflow-wrap: anywhere;
  }
  .colofon__fila a {
    color: var(--ink);
    text-underline-offset: 4px;
  }
  @media (max-width: 480px) {
    .colofon__fila {
      grid-template-columns: 110px minmax(0, 1fr);
    }
  }
</style>
