---
/**
 * Portada 07 · Deriva — un muro de obras a pantalla completa que deriva
 * despacio y sin fin en diagonal. La posición del cursor orienta y acelera la
 * deriva; al pasar por una obra el muro se detiene y aparece su cartela.
 * El nombre, enorme y en blanco con mix-blend-mode: difference, cambia de
 * color con cada obra que pasa por debajo. Debajo, las secciones comunes.
 *
 * Navegable: se arrastra con el ratón o el dedo (con inercia al soltar) y con
 * el desplazamiento lateral del trackpad. Tras arrastrar, el clic no abre la
 * obra. En táctil, el gesto vertical sigue desplazando la página.
 *
 * Infinito: cada fila contiene sus obras dos veces (se desplaza en módulo del
 * ancho de una tanda) y el escenario contiene las filas dos veces (módulo del
 * alto de una tanda). Solo la primera copia de cada obra es enfocable.
 */
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDatosPortada } from '../lib/portada';
import { esMarcador } from '../lib/ajustes';
import Redes from '../components/Redes.astro';
import type { Props as PropsPortada } from './tipos';

type Props = PropsPortada;
const { canonica, noindex } = Astro.props;
const datos = await getDatosPortada();
const { obras, etiquetas, ajustes } = datos;

const FILAS = 4;
// Obras por fila: suficientes para que una tanda sea más ancha que la pantalla.
const porFila = Math.max(5, Math.ceil(obras.length / FILAS));

const piezas = await Promise.all(
  obras.map(async (o, i) => {
    const src = o.data.imagen;
    const img = await getImage({ src, width: Math.min(src.width, 720), format: 'webp', quality: 78 });
    return {
      href: `/obra/${o.id}`,
      src: img.src,
      ratio: +(src.width / src.height).toFixed(4),
      titulo: o.data.titulo,
      meta: [etiquetas[i], o.data.anio].filter(Boolean).join(' · '),
      alt: o.data.alt ?? o.data.titulo,
    };
  })
);

// Reparto: cada fila arranca en un punto distinto de la lista para que las
// vecinas no coincidan (con pocas obras se repiten, como en un muro real).
const filas = Array.from({ length: FILAS }, (_, f) =>
  Array.from({ length: porFila }, (_, j) => piezas[(f * porFila + j) % Math.max(1, piezas.length)])
);
const primeraAparicion = new Set<string>();
const filasConFoco = filas.map((fila) =>
  fila.map((p) => {
    const enfocable = !primeraAparicion.has(p.href);
    primeraAparicion.add(p.href);
    return { ...p, enfocable };
  })
);
const aviso = ajustes.avisoPortada && !esMarcador(ajustes.avisoPortada) ? ajustes.avisoPortada : undefined;
// La portada es solo el muro: el pie común no aparece y sus enlaces legales
// van aquí, superpuestos (como en la portada de referencia).
const legales = (await getCollection('legal')).sort((a, b) => a.data.orden - b.data.orden);
---

<BaseLayout cabecera="superpuesta" paleta="deriva" canonica={canonica} noindex={noindex} pie={false}>
  <section id="inicio" class="deriva" aria-labelledby="deriva-titulo">
    <muro-deriva class="deriva__muro" data-filas={FILAS}>
      <div class="deriva__escenario" data-escenario>
        {
          [0, 1].map((tanda) =>
            filasConFoco.map((fila, f) => (
              <div class="fila" data-fila={f} aria-hidden={tanda === 1 ? 'true' : undefined}>
                {[0, 1].map((copia) => (
                  <div class="fila__tanda" data-tanda={copia === 0 ? '' : undefined} aria-hidden={copia === 1 ? 'true' : undefined}>
                    {fila.map((p) => {
                      const foco = tanda === 0 && copia === 0 && p.enfocable;
                      return (
                        <a
                          class="pieza"
                          href={p.href}
                          tabindex={foco ? undefined : -1}
                          aria-hidden={foco ? undefined : 'true'}
                          style={`--ratio: ${p.ratio}`}
                        >
                          <img src={p.src} alt={foco ? p.alt : ''} decoding="async" draggable="false" fetchpriority={tanda === 0 && f < 2 ? 'high' : 'low'} />
                          <span class="pieza__cartela">
                            <span class="pieza__titulo">{p.titulo}</span>
                            <span class="pieza__meta">{p.meta}</span>
                          </span>
                        </a>
                      );
                    })}
                  </div>
                ))}
              </div>
            ))
          )
        }
      </div>
    </muro-deriva>

    <div class="deriva__velo" aria-hidden="true"></div>

    <h1 id="deriva-titulo" class="deriva__nombre" data-ajustar><span>Jesús</span> <span>Senovilla</span></h1>
    <p class="deriva__lema" aria-hidden="true">Óleo · Acuarela · Grabado</p>

    <div class="deriva__pie">
      <p class="deriva__pista" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 9l-3 3 3 3M9 5l3-3 3 3M15 19l-3 3-3-3M19 9l3 3-3 3M2 12h20M12 2v20" /></svg>
        <span class="deriva__pista-raton">Arrastra para recorrer</span><span class="deriva__pista-tactil">Desliza para recorrer</span>
      </p>
      <div class="deriva__izq">
        {
          aviso && (
            <p class="deriva__aviso">
              <span class="punto" aria-hidden="true" />
              {aviso}
            </p>
          )
        }
        <nav class="deriva__rapidos" aria-label="Información legal">
          {legales.map((l) => {
            const corto = l.data.titulo.replace(/^Política de /, '');
            return <a href={`/${l.id}`}>{corto.charAt(0).toUpperCase() + corto.slice(1)}</a>;
          })}
          <button type="button" data-abrir-cookies>Configurar cookies</button>
        </nav>
      </div>
      <div class="deriva__der">
        <Redes tono="claro" etiqueta="Sigue mi obra" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .deriva {
    --alto: clamp(240px, 46vh, 520px);
    --hueco: clamp(28px, 4.4vw, 64px);
    position: relative;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    background: var(--bg);
  }
  .deriva__muro {
    position: absolute;
    inset: 0;
    display: block;
    cursor: grab;
    user-select: none;
    -webkit-user-select: none;
    /* El gesto vertical en táctil sigue siendo de la página */
    touch-action: pan-y pinch-zoom;
  }
  .deriva__muro.is-arrastrando,
  .deriva__muro.is-arrastrando * {
    cursor: grabbing;
  }
  /* Mientras se arrastra, ni realces ni cartelas */
  .deriva__muro.is-arrastrando .pieza {
    pointer-events: none;
  }
  .deriva__escenario {
    position: absolute;
    left: 0;
    top: 0;
    will-change: transform;
  }
  .fila {
    display: flex;
    width: max-content;
    margin-bottom: var(--hueco);
    will-change: transform;
  }
  .fila__tanda {
    display: flex;
    gap: var(--hueco);
    padding-right: var(--hueco);
  }
  .pieza {
    position: relative;
    display: block;
    flex: 0 0 auto;
    height: var(--alto);
    width: calc(var(--alto) * var(--ratio));
    overflow: hidden;
    color: var(--ink);
    text-decoration: none;
    transition:
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pieza img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--card);
    user-select: none;
    transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pieza:hover,
  .pieza:focus-visible {
    transform: translateY(-6px);
    box-shadow: 0 28px 56px -18px rgba(20, 16, 10, 0.4);
    z-index: 2;
  }
  /* La obra se acerca un poco dentro de su marco */
  .pieza:hover img,
  .pieza:focus-visible img {
    transform: scale(1.045);
  }
  .pieza:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  /* ---------- Cartela de museo dentro del cuadro ----------
     Una tarjeta de papel en la esquina inferior que se despliega de izquierda
     a derecha; el título sube y los datos lo siguen. Al salir se recoge
     más deprisa para no estorbar. */
  .pieza__cartela {
    position: absolute;
    left: 12px;
    bottom: 12px;
    max-width: calc(100% - 24px);
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 11px 16px 10px 14px;
    border-radius: 3px;
    background: rgba(250, 248, 242, 0.95);
    box-shadow: 0 6px 18px -8px rgba(20, 16, 10, 0.35);
    pointer-events: none;
    clip-path: inset(0 100% 0 0 round 3px);
    transition: clip-path 0.38s cubic-bezier(0.5, 0, 0.75, 0);
  }
  .pieza:hover .pieza__cartela,
  .pieza:focus-visible .pieza__cartela {
    clip-path: inset(0 0 0 0 round 3px);
    transition: clip-path 0.7s cubic-bezier(0.65, 0, 0.2, 1) 0.08s;
  }
  .pieza__titulo,
  .pieza__meta {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }
  .pieza__titulo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  /* El punto bermellón de la web, delante del título */
  .pieza__titulo::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.14em;
    transform: scale(0);
    transition: transform 0.3s ease;
  }
  .pieza__meta {
    padding-left: 14px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .pieza:hover .pieza__titulo,
  .pieza:hover .pieza__meta,
  .pieza:focus-visible .pieza__titulo,
  .pieza:focus-visible .pieza__meta {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.5s ease 0.32s,
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.32s;
  }
  .pieza:hover .pieza__meta,
  .pieza:focus-visible .pieza__meta {
    transition-delay: 0.42s;
  }
  .pieza:hover .pieza__titulo::before,
  .pieza:focus-visible .pieza__titulo::before {
    transform: scale(1);
    transition: transform 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) 0.55s;
  }
  @media (prefers-reduced-motion: reduce) {
    .pieza img,
    .pieza__cartela,
    .pieza__titulo,
    .pieza__meta,
    .pieza__titulo::before {
      transition: none !important;
    }
    .pieza:hover img,
    .pieza:focus-visible img {
      transform: none;
    }
  }

  /* Un velo muy suave en los bordes para que el texto respire */
  .deriva__velo {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgba(245, 243, 238, 0.55), transparent 18%, transparent 78%, rgba(245, 243, 238, 0.7)),
      radial-gradient(ellipse at center, transparent 55%, rgba(245, 243, 238, 0.25));
  }

  .deriva__nombre {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    top: 50%;
    transform: translateY(-58%);
    margin: 0;
    text-align: center;
    white-space: nowrap;
    font-weight: 800;
    /* «Jesús Senovilla» en Syne 800 ≈ 12em: cabe entero; data-ajustar corrige lo que falte */
    font-size: clamp(36px, calc((100vw - 2 * var(--gutter)) / 12.4), 210px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .deriva__lema {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(50% + clamp(36px, calc((100vw - 2 * var(--gutter)) / 12.4), 210px) * 0.5);
    margin: 0;
    text-align: center;
    font-size: 13px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-weight: 600;
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .deriva__pie {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 22px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 14px 24px;
    pointer-events: none;
  }
  .deriva__izq,
  .deriva__der {
    pointer-events: auto;
  }
  .deriva__izq {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .deriva__aviso {
    position: relative;
    max-width: 42ch;
    margin: 0;
    padding-left: 18px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .deriva__aviso .punto {
    position: absolute;
    left: 0;
    top: 0.5em;
  }
  /* El punto late despacio, como un aviso vivo */
  .deriva__aviso .punto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--accent);
    animation: latido 2.8s ease-out infinite;
  }
  @keyframes latido {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    60%,
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }
  .deriva__rapidos {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }
  .deriva__rapidos a,
  .deriva__rapidos button {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat right 75% / 0 1px;
    transition: background-size 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .deriva__rapidos button {
    padding: 0;
    border: 0;
    font-family: inherit;
    cursor: pointer;
  }
  .deriva__rapidos a:hover,
  .deriva__rapidos button:hover {
    background-position: left 75%;
    background-size: 100% 1px;
  }
  /* La pista va justo encima de la fila del pie, centrada */
  .deriva__pista {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 10px);
    transform: translateX(-50%);
    margin: 0;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
    mix-blend-mode: difference;
    white-space: nowrap;
    transition: opacity 0.6s ease;
  }
  .deriva__pista-tactil {
    display: none;
  }
  @media (hover: none) {
    .deriva__pista-raton {
      display: none;
    }
    .deriva__pista-tactil {
      display: inline;
    }
  }
  /* Tras el primer arrastre ya no hace falta */
  .deriva.ya-arrastrado .deriva__pista {
    opacity: 0;
  }
  .punto {
    position: relative;
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .deriva__aviso .punto::after {
      animation: none;
    }
  }
  @media (max-width: 640px) {
    .deriva {
      --alto: clamp(180px, 34vh, 300px);
      height: 100svh;
      min-height: 520px;
    }
    /* En móvil, el nombre en dos líneas y mucho más grande */
    .deriva__nombre {
      white-space: normal;
      font-size: clamp(40px, calc((100vw - 2 * var(--gutter)) / 7.6), 96px);
      line-height: 0.88;
      transform: translateY(-62%);
    }
    .deriva__nombre span {
      display: block;
    }
    .deriva__lema {
      top: calc(50% + clamp(40px, calc((100vw - 2 * var(--gutter)) / 7.6), 96px) * 1.05);
    }
    /* En móvil, banda clara esmerilada para que se lea sobre las obras */
    .deriva__pie {
      left: 0;
      right: 0;
      bottom: 0;
      gap: 10px 16px;
      padding: 14px var(--gutter) 14px;
      background: rgba(245, 243, 238, 0.9);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      pointer-events: auto;
    }
    .deriva__izq {
      width: 100%;
      gap: 8px;
    }
    .deriva__rapidos {
      flex-wrap: nowrap;
      gap: 0 18px;
      overflow-x: auto;
      scrollbar-width: none;
      margin-right: calc(-1 * var(--gutter));
      padding-right: var(--gutter);
    }
    .deriva__rapidos::-webkit-scrollbar {
      display: none;
    }
    .deriva__rapidos a,
    .deriva__rapidos button {
      white-space: nowrap;
    }
    .deriva__aviso {
      font-size: 11px;
    }
    .deriva__lema {
      letter-spacing: 0.2em;
      font-size: 11px;
    }
    .deriva__pista {
      bottom: calc(100% + 6px);
      font-size: 11px;
    }
  }
</style>

<script>
  import { abrirAjustesCookies } from '../lib/consentimiento';

  // Velocidad base (px/s) y cuánto la orienta el cursor.
  const BASE = { x: -14, y: -10 };
  const GUIA = 46;

  class MuroDeriva extends HTMLElement {
    private escenario!: HTMLElement;
    private filas: HTMLElement[] = [];
    private anchos: number[] = [];
    private desfases: number[] = [];
    private altoTanda = 0;
    private x = 0;
    private y = 0;
    private v = { ...BASE };
    private objetivo = { ...BASE };
    private pausa = false;
    private visible = true;
    private ultimo = 0;
    private marco = 0;
    /** Arrastre en curso (puntero, última posición y tiempo, recorrido total). */
    private arrastre: { id: number; x: number; y: number; t: number; recorrido: number } | null = null;
    /** Velocidad que queda al soltar (px/s); se frena poco a poco. */
    private inercia = { x: 0, y: 0 };
    private reducir = matchMedia('(prefers-reduced-motion: reduce)');

    connectedCallback() {
      this.escenario = this.querySelector('[data-escenario]')!;
      this.filas = [...this.querySelectorAll<HTMLElement>('.fila')];
      const nFilas = Number(this.dataset.filas) || 4;
      this.desfases = this.filas.map((_, i) => ((i % nFilas) * 0.37) % 1);
      this.medir();
      new ResizeObserver(() => this.medir()).observe(this);
      // Las imágenes cargadas tarde no cambian el ancho (lo fija la proporción), pero por si acaso:
      addEventListener('load', () => this.medir(), { once: true });

      const reducir = this.reducir;
      const seccion = this.closest('section')!;
      this.navegacion(seccion);

      // El cursor orienta la deriva: hacia donde apunta, hacia allí se viaja.
      seccion.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        const c = seccion.getBoundingClientRect();
        const dx = (e.clientX - c.left) / c.width - 0.5;
        const dy = (e.clientY - c.top) / c.height - 0.5;
        this.objetivo = { x: BASE.x - dx * GUIA * 2, y: BASE.y - dy * GUIA * 2 };
      });
      seccion.addEventListener('pointerleave', () => (this.objetivo = { ...BASE }));

      // Se detiene sobre una obra o con el foco del teclado dentro.
      this.addEventListener('pointerover', (e) => {
        if ((e.target as HTMLElement).closest('.pieza')) this.pausa = true;
      });
      this.addEventListener('pointerout', (e) => {
        if (!(e.relatedTarget as HTMLElement | null)?.closest?.('.pieza')) this.pausa = false;
      });
      this.addEventListener('focusin', () => (this.pausa = true));
      this.addEventListener('focusout', (e) => {
        if (!this.contains(e.relatedTarget as Node)) this.pausa = false;
      });

      new IntersectionObserver(([en]) => {
        this.visible = en.isIntersecting;
        if (this.visible && !reducir.matches) this.arrancar();
      }).observe(this);
      document.addEventListener('visibilitychange', () => {
        if (!document.hidden && this.visible && !reducir.matches) this.arrancar();
      });

      this.pintar();
      if (!reducir.matches) this.arrancar();
    }

    /** Arrastre con ratón o dedo, con inercia; desplazamiento lateral del trackpad. */
    private navegacion(seccion: HTMLElement) {
      const UMBRAL = 6;
      this.addEventListener('dragstart', (e) => e.preventDefault());

      this.addEventListener('pointerdown', (e) => {
        if (e.button !== 0) return;
        this.arrastre = { id: e.pointerId, x: e.clientX, y: e.clientY, t: performance.now(), recorrido: 0 };
        this.inercia = { x: 0, y: 0 };
      });

      addEventListener(
        'pointermove',
        (e) => {
          const a = this.arrastre;
          if (!a || e.pointerId !== a.id) return;
          const ahora = performance.now();
          const dx = e.clientX - a.x;
          // En táctil el eje vertical es del scroll de la página.
          const dy = e.pointerType === 'touch' ? 0 : e.clientY - a.y;
          const ms = Math.max(8, ahora - a.t);
          a.x = e.clientX;
          a.y = e.clientY;
          a.t = ahora;
          a.recorrido += Math.abs(dx) + Math.abs(dy);
          if (a.recorrido > UMBRAL && !this.classList.contains('is-arrastrando')) {
            this.classList.add('is-arrastrando');
            seccion.classList.add('ya-arrastrado');
            try {
              this.setPointerCapture(a.id);
            } catch {
              /* sin captura: seguimos con los eventos de la ventana */
            }
          }
          this.x += dx;
          this.y += dy;
          // Velocidad suavizada (px/s) para lanzar el muro al soltar.
          this.inercia = { x: this.inercia.x * 0.3 + (dx / ms) * 700, y: this.inercia.y * 0.3 + (dy / ms) * 700 };
          if (this.reducir.matches || !this.visible) this.pintar();
        },
        { passive: true }
      );

      const soltar = (e: PointerEvent) => {
        const a = this.arrastre;
        if (!a || e.pointerId !== a.id) return;
        this.arrastre = null;
        // Si se quedó quieto antes de soltar, no hay lanzamiento.
        if (performance.now() - a.t > 90 || this.reducir.matches) this.inercia = { x: 0, y: 0 };
        // Tope para que un gesto brusco no lo dispare.
        const tope = 2600;
        this.inercia.x = Math.max(-tope, Math.min(tope, this.inercia.x));
        this.inercia.y = Math.max(-tope, Math.min(tope, this.inercia.y));
        this.classList.remove('is-arrastrando');
        if (a.recorrido > UMBRAL) {
          // El clic que sigue a un arrastre no abre la obra (ni prepara su transición).
          const bloquear = (ev: Event) => {
            ev.preventDefault();
            ev.stopPropagation();
          };
          addEventListener('click', bloquear, { capture: true, once: true });
          setTimeout(() => removeEventListener('click', bloquear, { capture: true }), 0);
        }
        if (!this.reducir.matches) this.arrancar();
      };
      addEventListener('pointerup', soltar);
      addEventListener('pointercancel', soltar);

      // Trackpad: el gesto lateral mueve el muro; el vertical, la página.
      seccion.addEventListener(
        'wheel',
        (e) => {
          if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
          e.preventDefault();
          this.x -= e.deltaX;
          seccion.classList.add('ya-arrastrado');
          this.pintar();
        },
        { passive: false }
      );
    }

    private medir() {
      this.anchos = this.filas.map((f) => (f.querySelector<HTMLElement>('[data-tanda]')?.offsetWidth ?? 1) || 1);
      const nFilas = Number(this.dataset.filas) || 4;
      const primera = this.filas[0];
      const paso = primera ? primera.offsetHeight + parseFloat(getComputedStyle(primera).marginBottom) : 1;
      this.altoTanda = paso * nFilas || 1;
      this.pintar();
    }

    private arrancar() {
      cancelAnimationFrame(this.marco);
      this.ultimo = performance.now();
      this.marco = requestAnimationFrame((t) => this.paso(t));
    }

    private paso(t: number) {
      if (!this.visible || document.hidden) return;
      const dt = Math.min(0.05, (t - this.ultimo) / 1000);
      this.ultimo = t;
      // Suavizado: la velocidad se acerca al objetivo (o a cero en pausa).
      // Arrastrando, el muro sigue al dedo; parado sobre una obra, quieto.
      const meta = this.arrastre || this.pausa ? { x: 0, y: 0 } : this.objetivo;
      const k = 1 - Math.exp(-dt * 3);
      this.v.x += (meta.x - this.v.x) * k;
      this.v.y += (meta.y - this.v.y) * k;
      // La inercia del último arrastre se frena poco a poco.
      const freno = Math.exp(-dt * 3.2);
      this.inercia.x *= freno;
      this.inercia.y *= freno;
      this.x += (this.v.x + this.inercia.x) * dt;
      this.y += (this.v.y + this.inercia.y) * dt;
      this.pintar();
      this.marco = requestAnimationFrame((n) => this.paso(n));
    }

    private pintar() {
      const mod = (a: number, n: number) => ((a % n) + n) % n;
      const ty = -mod(-this.y, this.altoTanda);
      this.escenario.style.transform = `translate3d(0, ${ty}px, 0)`;
      this.filas.forEach((f, i) => {
        const w = this.anchos[i] || 1;
        const tx = -mod(-this.x + this.desfases[i] * w, w);
        f.style.transform = `translate3d(${tx}px, 0, 0)`;
      });
    }
  }

  if (!customElements.get('muro-deriva')) customElements.define('muro-deriva', MuroDeriva);

  // «Configurar cookies» del pie superpuesto
  document.querySelectorAll('[data-abrir-cookies]').forEach((b) => b.addEventListener('click', abrirAjustesCookies));
</script>
