<script>
  // Mancheta: cada letra cambia de peso (400–800) según su cercanía al cursor.
  const m = document.querySelector<HTMLElement>('[data-mancheta]');
  if (m && matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const letras = [...m.querySelectorAll<HTMLElement>('.mletra')];
    m.addEventListener('pointermove', (e) => {
      const c = m.getBoundingClientRect();
      const x = (e.clientX - c.left) / c.width;
      letras.forEach((l, i) => {
        const d = (i + 0.5) / letras.length - x;
        l.style.setProperty('--w', String(Math.round(420 + 380 * Math.exp(-(d * d) / 0.01))));
      });
    });
    m.addEventListener('pointerleave', () => letras.forEach((l) => l.style.removeProperty('--w')));
  }
</script>
