---
/**
 * «Cómo comprar»: sin pasarela de pago. Cuatro pasos (consulta, confirmación,
 * pago por transferencia o Bizum, envío) y las dos formas de pago.
 * La línea que une los pasos se dibuja al hacer scroll; con movimiento
 * reducido aparece ya dibujada.
 * No se muestra en obras vendidas o que no están a la venta.
 */
interface Props {
  titulo: string;
  /** mailto: con el asunto ya puesto, o /contacto. */
  hrefConsulta: string;
  /** Condiciones de envío de Ajustes (si no son un marcador). */
  envio?: string;
}
const { titulo, hrefConsulta, envio } = Astro.props;

const pasos = [
  {
    titulo: 'Consulta',
    texto: `Escríbeme indicando la obra («${titulo}») y dónde quieres recibirla.`,
  },
  {
    titulo: 'Confirmación',
    texto: 'Te confirmo la disponibilidad, el precio final con el envío y te paso los datos para el pago. La obra queda reservada para ti.',
  },
  {
    titulo: 'Pago',
    texto: 'Por transferencia bancaria o Bizum. Sin pasarela ni intermediarios: nunca te pediré los datos de tu tarjeta.',
  },
  {
    titulo: 'Envío',
    texto: envio ?? 'Con el pago recibido, la obra se embala con cuidado y sale hacia ti. Te aviso con el seguimiento.',
  },
];
---

<section id="comprar" class="comprar" aria-labelledby="comprar-titulo">
  <div class="comprar__in">
    <div class="comprar__cabeza">
      <p class="comprar__eti"><span class="punto" aria-hidden="true"></span>Sin pasarela de pago</p>
      <h2 id="comprar-titulo" class="comprar__titulo">Cómo<br />comprar<span class="acento">.</span></h2>
      <p class="comprar__intro">Trato directo con el artista, de principio a fin. Pagas solo cuando todo está confirmado por escrito.</p>

      <ul class="metodos" role="list" aria-label="Formas de pago">
        <li class="metodo">
          <span class="metodo__icono" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18M12 3l9 5H3z" /></svg>
          </span>
          <span class="metodo__texto">
            <span class="metodo__nombre">Transferencia</span>
            <span class="metodo__nota">Bancaria, en euros</span>
          </span>
        </li>
        <li class="metodo">
          <span class="metodo__icono" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="3" /><path d="M10.5 18.5h3M12.8 7.5l-2.6 4h3.6l-2.6 4" /></svg>
          </span>
          <span class="metodo__texto">
            <span class="metodo__nombre">Bizum</span>
            <span class="metodo__nota">Al instante, desde tu móvil</span>
          </span>
        </li>
      </ul>

      <div class="comprar__acciones">
        <a class="comprar__boton" href={hrefConsulta}>
          Consultar esta obra <span class="flecha" aria-hidden="true">→</span>
        </a>
        <a class="comprar__enlace" href="/condiciones-de-venta">Condiciones de venta</a>
      </div>
    </div>

    <ol class="pasos" role="list">
      {
        pasos.map((p, i) => (
          <li class="paso">
            <span class="paso__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="paso__cuerpo">
              <h3 class="paso__titulo">{p.titulo}</h3>
              <p class="paso__texto">{p.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="comprar__aviso">
    <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z" /><path d="M9 12l2 2 4-4" /></svg>
    Los datos de pago te llegarán siempre desde el correo del artista. Si alguien te pide pagar por otra vía, no lo hagas y escríbeme.
  </p>
</section>

<style>
  .comprar {
    --linea: rgba(250, 250, 248, 0.16);
    background: var(--black);
    color: var(--paper);
    padding: clamp(72px, 9vw, 136px) var(--gutter) clamp(40px, 5vw, 64px);
  }
  .comprar :focus-visible {
    outline-color: var(--accent-on-dark);
  }
  .comprar__in {
    max-width: var(--container);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: start;
  }

  /* ---------- Cabecera y formas de pago ---------- */
  .comprar__cabeza {
    display: flex;
    flex-direction: column;
    gap: 24px;
    position: sticky;
    top: 110px;
  }
  .comprar__eti {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #a8a59e;
  }
  .punto {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent-on-dark);
  }
  .comprar__titulo {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    /* «comprar.» ≈ 5 em en Syne 800: que quepa en su columna */
    font-size: clamp(48px, 5.2vw, 88px);
    line-height: 0.86;
    letter-spacing: -0.045em;
  }
  .acento {
    color: var(--accent-on-dark);
  }
  .comprar__intro {
    margin: 0;
    max-width: 30em;
    font-size: 17px;
    line-height: 1.6;
    color: #c9c6bf;
  }

  .metodos {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }
  .metodo {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--linea);
    border-radius: 16px;
    background: linear-gradient(160deg, rgba(250, 250, 248, 0.07), rgba(250, 250, 248, 0.02));
    transition:
      border-color 0.4s ease,
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .metodo:hover {
    border-color: rgba(242, 113, 79, 0.6);
    transform: translateY(-3px);
  }
  .metodo__icono {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(242, 113, 79, 0.14);
    color: var(--accent-on-dark);
  }
  .metodo__texto {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .metodo__nombre {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 17px;
  }
  .metodo__nota {
    font-size: 13px;
    color: #a8a59e;
  }

  .comprar__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 24px;
    margin-top: 8px;
  }
  .comprar__boton {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 26px;
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font: 600 15px/1 var(--font-body);
    text-decoration: none;
    transition: background 0.3s ease, color 0.3s ease;
  }
  .comprar__boton:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .flecha {
    display: inline-block;
    transition: transform 0.35s ease;
  }
  .comprar__boton:hover .flecha {
    transform: translateX(5px);
  }
  .comprar__enlace {
    font: 600 14px/1.4 var(--font-body);
    color: var(--paper);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 100% 1px;
    transition: background-size 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .comprar__enlace:hover {
    background-position: right bottom;
    background-size: 0 1px;
  }

  /* ---------- Pasos con línea que se dibuja ---------- */
  .pasos {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }
  .pasos::before,
  .pasos::after {
    content: '';
    position: absolute;
    left: 31px;
    top: 32px;
    bottom: 32px;
    width: 1px;
    background: var(--linea);
  }
  .pasos::after {
    background: var(--accent-on-dark);
    transform-origin: top;
  }
  .paso {
    position: relative;
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 28px;
    padding: 0 0 clamp(36px, 5vw, 56px);
  }
  .paso:last-child {
    padding-bottom: 0;
  }
  .paso__n {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border: 1px solid var(--linea);
    border-radius: 50%;
    background: var(--black);
    font: 700 18px/1 var(--font-display);
    font-variant-numeric: tabular-nums;
    color: var(--paper);
    transition: border-color 0.5s ease, background 0.5s ease;
  }
  .paso:hover .paso__n {
    border-color: var(--accent-on-dark);
  }
  .paso__cuerpo {
    padding-top: 14px;
  }
  .paso__titulo {
    margin: 0 0 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(24px, 2.4vw, 34px);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .paso__texto {
    margin: 0;
    max-width: 34em;
    font-size: 16px;
    line-height: 1.65;
    color: #c9c6bf;
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pasos::after {
        animation: dibujar linear both;
        animation-timeline: view();
        animation-range: entry 40% cover 70%;
      }
      .paso {
        animation: paso-entra linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 30%;
      }
    }
  }
  @keyframes dibujar {
    from {
      transform: scaleY(0);
    }
  }
  @keyframes paso-entra {
    from {
      opacity: 0;
      transform: translateY(36px);
      animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }

  .comprar__aviso {
    max-width: var(--container);
    margin: clamp(56px, 7vw, 96px) auto 0;
    padding-top: 24px;
    border-top: 1px solid var(--linea);
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    line-height: 1.55;
    color: #a8a59e;
  }
  .comprar__aviso svg {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--accent-on-dark);
  }

  @media (max-width: 900px) {
    .comprar__in {
      grid-template-columns: minmax(0, 1fr);
    }
    .comprar__cabeza {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .metodos {
      grid-template-columns: minmax(0, 1fr);
    }
    .paso {
      grid-template-columns: 48px minmax(0, 1fr);
      gap: 18px;
    }
    .paso__n {
      width: 48px;
      height: 48px;
      font-size: 15px;
    }
    .pasos::before,
    .pasos::after {
      left: 23px;
      top: 24px;
      bottom: 24px;
    }
    .paso__cuerpo {
      padding-top: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .metodo,
    .metodo:hover,
    .flecha {
      transition: none;
      transform: none;
    }
  }
</style>
