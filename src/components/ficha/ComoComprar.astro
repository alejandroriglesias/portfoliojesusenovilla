---
/**
 * «Cómo comprar»: sin pasarela de pago. Cuatro pasos (consulta, confirmación,
 * pago por transferencia o Bizum, envío) y las dos formas de pago.
 * Mismo lenguaje que el panel de la ficha: fondo claro, tarjetas suaves con
 * el color de pared, rayas finas y el punto bermellón. La raya que une los
 * pasos se dibuja al hacer scroll.
 * No se muestra en obras vendidas o que no están a la venta.
 */
interface Props {
  titulo: string;
  /** mailto: con el asunto ya puesto, o /contacto. */
  hrefConsulta: string;
  /** Condiciones de envío de Ajustes (si no son un marcador). */
  envio?: string;
}
const { titulo, hrefConsulta, envio } = Astro.props;

const pasos = [
  {
    titulo: 'Consulta',
    texto: `Escríbeme indicando la obra («${titulo}») y dónde quieres recibirla.`,
  },
  {
    titulo: 'Confirmación',
    texto: 'Te confirmo la disponibilidad, el precio final con el envío y te paso los datos para el pago. La obra queda reservada para ti.',
  },
  {
    titulo: 'Pago',
    texto: 'Por transferencia bancaria o Bizum. Sin pasarela ni intermediarios: nunca te pediré los datos de tu tarjeta.',
  },
  {
    titulo: 'Envío',
    texto: envio ?? 'Con el pago recibido, la obra se embala con cuidado y sale hacia ti. Te aviso con el seguimiento.',
  },
];
---

<section id="comprar" class="comprar" aria-labelledby="comprar-titulo">
  <div class="comprar__in">
    <header class="comprar__cabeza">
      <div class="comprar__titulos">
        <p class="comprar__eti"><span class="punto" aria-hidden="true"></span>Sin pasarela de pago</p>
        <h2 id="comprar-titulo" class="comprar__titulo">Cómo comprar</h2>
        <p class="comprar__intro">Trato directo con el artista, de principio a fin. Pagas solo cuando todo está confirmado por escrito.</p>
      </div>

      <ul class="metodos" role="list" aria-label="Formas de pago">
        <li class="metodo">
          <span class="metodo__icono" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10h18M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20h18M12 3l9 5H3z" /></svg>
          </span>
          <span class="metodo__texto">
            <span class="metodo__nombre">Transferencia</span>
            <span class="metodo__nota">Bancaria, en euros</span>
          </span>
        </li>
        <li class="metodo">
          <span class="metodo__icono" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="2.5" width="12" height="19" rx="3" /><path d="M10.5 18.5h3M12.8 7.5l-2.6 4h3.6l-2.6 4" /></svg>
          </span>
          <span class="metodo__texto">
            <span class="metodo__nombre">Bizum</span>
            <span class="metodo__nota">Al instante, desde tu móvil</span>
          </span>
        </li>
      </ul>
    </header>

    <ol class="pasos" role="list">
      {
        pasos.map((p, i) => (
          <li class="paso" style={`--i: ${i}`}>
            <span class="paso__n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="paso__titulo">{p.titulo}</h3>
            <p class="paso__texto">{p.texto}</p>
          </li>
        ))
      }
    </ol>

    <div class="comprar__pie">
      <div class="comprar__acciones">
        <a class="comprar__boton" href={hrefConsulta}>
          <span class="punto" aria-hidden="true"></span>
          Consultar esta obra <span class="flecha" aria-hidden="true">→</span>
        </a>
        <a class="comprar__enlace" href="/condiciones-de-venta">Condiciones de venta</a>
      </div>
      <p class="comprar__aviso">
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.4 8.2-8 9-4.6-.8-8-4.5-8-9V6z" /><path d="M9 12l2 2 4-4" /></svg>
        Los datos de pago te llegarán siempre desde el correo del artista. Si alguien te pide pagar por otra vía, no lo hagas y escríbeme.
      </p>
    </div>
  </div>
</section>

<style>
  .comprar {
    background: var(--textura), var(--paper);
    border-top: 1px solid var(--line);
    padding: clamp(64px, 7vw, 104px) var(--gutter) clamp(56px, 6vw, 88px);
  }
  .comprar__in {
    max-width: var(--container);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }

  /* ---------- Cabecera: título y formas de pago ---------- */
  .comprar__cabeza {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 520px);
    align-items: end;
    gap: 28px clamp(32px, 5vw, 80px);
  }
  .comprar__titulos {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .comprar__eti {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font: 600 11px/1 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }
  .comprar__titulo {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(34px, 3.6vw, 56px);
    line-height: 1;
    letter-spacing: -0.012em;
  }
  .comprar__intro {
    margin: 0;
    max-width: 34em;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .metodos {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .metodo {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 14px;
    background: var(--textura), var(--band);
  }
  .metodo__icono {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--textura), var(--paper);
    color: var(--ink);
  }
  .metodo__texto {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .metodo__nombre {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
  }
  .metodo__nota {
    font-size: 13px;
    color: var(--muted);
  }

  /* ---------- Pasos: en fila, unidos por una raya fina ---------- */
  .pasos {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px clamp(20px, 3vw, 44px);
  }
  .pasos::before,
  .pasos::after {
    content: '';
    position: absolute;
    left: 18px;
    right: 18px;
    top: 18px;
    height: 1px;
    background: var(--line);
  }
  .pasos::after {
    background: var(--ink);
    transform-origin: left;
  }
  .paso {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .paso__n {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 8px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--textura), var(--paper);
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    transition:
      border-color 0.4s ease,
      background 0.4s ease,
      color 0.4s ease;
  }
  .paso:hover .paso__n {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--paper);
  }
  .paso__titulo {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    letter-spacing: -0.015em;
  }
  .paso__texto {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-soft);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .pasos::after {
        animation: dibujar linear both;
        animation-timeline: view();
        animation-range: entry 30% cover 55%;
      }
      .paso {
        animation: paso-entra linear both;
        animation-timeline: view();
        animation-range: entry 5% cover 30%;
      }
    }
  }
  @keyframes dibujar {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes paso-entra {
    from {
      opacity: 0;
      transform: translateY(20px);
      animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
    }
  }

  /* ---------- Pie: acciones y aviso ---------- */
  .comprar__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .comprar__acciones {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }
  .comprar__boton {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    padding: 0 22px 0 18px;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font: 600 14px/1 var(--font-body);
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 0.3s ease;
  }
  .comprar__boton:hover {
    background: var(--accent);
  }
  .comprar__boton:hover .punto {
    background: var(--textura), var(--paper);
  }
  .flecha {
    display: inline-block;
    transition: transform 0.35s ease;
  }
  .comprar__boton:hover .flecha {
    transform: translateX(4px);
  }
  .comprar__enlace {
    font: 600 13px/1.4 var(--font-body);
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 100% 1px;
    transition: background-size 0.5s var(--ease-out);
  }
  .comprar__enlace:hover {
    background-position: right bottom;
    background-size: 0 1px;
  }
  .comprar__aviso {
    margin: 0;
    max-width: 44em;
    display: flex;
    align-items: flex-start;
    gap: 9px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--muted);
  }
  .comprar__aviso svg {
    flex: 0 0 auto;
    margin-top: 2px;
    color: var(--accent);
  }

  @media (max-width: 980px) {
    .comprar__cabeza {
      grid-template-columns: minmax(0, 1fr);
    }
    .pasos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pasos::before,
    .pasos::after {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .metodos,
    .pasos {
      grid-template-columns: minmax(0, 1fr);
    }
    .paso {
      display: grid;
      grid-template-columns: 36px minmax(0, 1fr);
      column-gap: 16px;
    }
    .paso__n {
      grid-row: span 2;
      margin-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .paso__n,
    .flecha,
    .comprar__boton {
      transition: none;
    }
  }
</style>
