---
/** Tira horizontal «Cómo se hizo» con scroll-snap. Si no hay pasos, no se pinta. */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Paso {
  imagen: ImageMetadata;
  titulo?: string;
  texto?: string;
}
interface Props {
  pasos: Paso[];
  titulo: string;
  numero?: string;
}

const { pasos, titulo, numero = '(02)' } = Astro.props;
const n = (i: number) => String(i + 1).padStart(2, '0');
---

{
  pasos.length > 0 && (
    <section id="proceso" class="proceso" aria-labelledby="proceso-titulo">
      <div class="proceso__cabeza">
        <div class="proceso__titulos">
          <p class="etiqueta">{numero} Proceso</p>
          <h2 id="proceso-titulo" class="proceso__h2">
            Cómo se hizo<span class="acento">.</span>
          </h2>
        </div>
        {pasos.length > 1 && (
          <span class="proceso__desliza" aria-hidden="true">
            Desliza
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
        )}
      </div>
      <ol class="proceso__tira" tabindex="0" aria-label={`Etapas del proceso de «${titulo}», desplazable`}>
        {pasos.map((p, i) => (
          <li class="paso">
            <Image
              src={p.imagen}
              alt={p.titulo ? `${p.titulo} (${titulo})` : `Paso ${i + 1} del proceso de «${titulo}»`}
              widths={[320, 480, 840]}
              sizes="(max-width: 640px) 78vw, 420px"
              class="paso__img"
            />
            <div class="paso__cab">
              <span class="paso__n" aria-hidden="true">{n(i)}</span>
              <h3 class="paso__titulo">
                <span class="sr-only">Paso {i + 1}: </span>
                {p.titulo ?? `Paso ${i + 1}`}
              </h3>
            </div>
            {p.texto && <p class="paso__texto">{p.texto}</p>}
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .proceso {
    background: #edeae3;
    padding: clamp(72px, 9vw, 128px) 0;
  }
  .proceso__cabeza {
    max-width: var(--container);
    margin: 0 auto 48px;
    padding: 0 var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px 32px;
  }
  .proceso__titulos {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .proceso__h2 {
    font-weight: 800;
    font-size: clamp(44px, 8vw, 132px);
    line-height: 0.88;
    letter-spacing: -0.045em;
  }
  .acento {
    color: var(--accent);
  }
  .proceso__desliza {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-soft);
  }
  .proceso__tira {
    list-style: none;
    margin: 0;
    display: flex;
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    /* alinea el primer paso con el contenedor */
    --margen: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    padding: 0 var(--margen) 24px;
    scroll-padding-inline: var(--margen);
    scrollbar-width: thin;
    scrollbar-color: #5f5e5a transparent;
  }
  .paso {
    /* contexto para el .sr-only (si no, se escapa del carrusel y desborda la página) */
    position: relative;
    flex: 0 0 min(78vw, 420px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .paso :global(.paso__img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #d9d6cf;
  }
  .paso__cab {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }
  .paso__n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 56px;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--accent);
  }
  .paso__titulo {
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }
  .paso__texto {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-soft);
  }
  @media (prefers-reduced-motion: no-preference) {
    .proceso__tira {
      scroll-behavior: smooth;
    }
  }
</style>
