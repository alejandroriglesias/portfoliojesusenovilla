---
/**
 * Vista «en casa»: la obra colgada en fotografías reales de estancias
 * (ver estancias.ts: fotos de Unsplash, calibradas a escala).
 *
 * - Se monta la obra en todas las estancias; cada visita enseña una al azar
 *   entre aquellas en las que cabe a escala, y el botón «Otra estancia» pasa
 *   a la siguiente. Sin JavaScript se ve una fija (según la obra).
 * - Dentro de cada foto, 1em = 1 cm de la escena.
 * - Realismo: encima de la obra se superpone la propia foto en «multiplicar»
 *   (las sombras y la luz de la habitación cruzan también el cuadro) y la
 *   sombra arrojada sigue la luz de cada estancia.
 * - Papel: marco negro fino, paspartú y reflejo de cristal. Lienzo: canto.
 */
import { getImage } from 'astro:assets';
import { ESTANCIAS } from './estancias';

interface Props {
  src: string;
  srcset: string;
  /** Ancho / alto de la imagen de la obra. */
  ratio: number;
  tipo: 'lienzo' | 'papel';
  /** Lado largo de la obra en cm (sin marco). */
  ladoLargo: number;
  /** true si ladoLargo sale de las medidas de la ficha. */
  aEscala: boolean;
}

const { src, srcset, ratio, tipo, ladoLargo, aEscala } = Astro.props;

// ---- Medidas de lo que cuelga (cm) ----
const PASPARTU = tipo === 'papel' ? Math.max(5, Math.min(10, ladoLargo * 0.12)) : 0;
const MARCO = tipo === 'papel' ? 2.4 : 0;
const ancho = ratio >= 1 ? ladoLargo : ladoLargo * ratio;
const alto = ratio >= 1 ? ladoLargo / ratio : ladoLargo;
const bruto = { w: ancho + 2 * (PASPARTU + MARCO), h: alto + 2 * (PASPARTU + MARCO) };

const r = (x: number) => +x.toFixed(4);

const capas = await Promise.all(
  ESTANCIAS.map(async (e) => {
    const W = e.foto.width;
    const H = e.foto.height;
    // Si no cabe en el hueco de la pared, se reduce todo en proporción.
    const reduccion = Math.min(1, e.max.w / bruto.w, e.max.h / bruto.h);
    const exterior = { w: bruto.w * reduccion, h: bruto.h * reduccion };
    const anchoPx = exterior.w * e.pxCm;
    const altoPx = exterior.h * e.pxCm;
    // Borde inferior: centrada a la altura de los ojos, sin bajar de `base`.
    const abajo = e.centro !== undefined ? Math.min(e.base, e.centro + altoPx / 2) : e.base;

    // Rectángulo de la obra en % de la foto (para recortar la capa de luz).
    const rect = {
      izq: ((e.x - anchoPx / 2) / W) * 100,
      der: 100 - ((e.x + anchoPx / 2) / W) * 100,
      arr: ((abajo - altoPx) / H) * 100,
      aba: 100 - (abajo / H) * 100,
    };

    const zoom = e.zoom ?? 1;
    const fondo = await getImage({
      src: e.foto,
      widths: [800, 1200, 1600, 2000, 2400].filter((w) => w <= W),
      format: 'webp',
      quality: 80,
    });
    const [s1, s2] = e.sombra;
    const estilo = [
      `--ar: ${r(W / H)}`,
      `--ra: ${r(H / W)}`,
      `--em: ${r(e.pxCm / W)}`,
      `--fx: ${e.foco.x}`,
      `--fy: ${e.foco.y}`,
      `--zoom: ${zoom}`,
      `--obra-w: ${r(exterior.w)}`,
      `--obra-h: ${r(exterior.h)}`,
      `--paspartu: ${r(PASPARTU * reduccion)}`,
      `--marco: ${r(MARCO * reduccion)}`,
      `--x: ${r((e.x / W) * 100)}%`,
      `--base: ${r(100 - (abajo / H) * 100)}%`,
      // Borde superior de la obra (fracción de la foto): para dejarle aire arriba.
      `--arte-y: ${r((abajo - altoPx) / H)}`,
      `--recorte: inset(${r(rect.arr)}% ${r(rect.der)}% ${r(rect.aba)}% ${r(rect.izq)}%)`,
      `--s1: ${s1[0]}em ${s1[1]}em ${s1[2]}em rgba(30, 24, 18, ${s1[3]})`,
      `--s2: ${s2[0]}em ${s2[1]}em ${s2[2]}em rgba(30, 24, 18, ${s2[3]})`,
      `--luz-op: ${e.luz.opacidad}`,
      `--luz-brillo: ${e.luz.brillo}`,
      `--luz-contraste: ${e.luz.contraste}`,
    ].join('; ');

    const cabe = reduccion === 1;
    return {
      id: e.id,
      cabe,
      canto: e.canto,
      fondo: { src: fondo.src, srcset: fondo.srcSet.attribute },
      sizes: `(max-width: 900px) ${Math.round(100 * zoom)}vw, ${Math.round(56 * zoom)}vw`,
      estilo,
      pie:
        aEscala && cabe
          ? `La obra colgada en ${e.descripcion}, a escala`
          : `La obra colgada en ${e.descripcion} (recreación orientativa)`,
    };
  })
);

// Sin JavaScript: una estancia fija por obra (de las que cabe a escala).
const candidatas = capas.some((c) => c.cabe) ? capas.filter((c) => c.cabe) : capas;
const semilla = [...Astro.url.pathname].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) >>> 0, 7);
const inicial = candidatas[semilla % candidatas.length];
---

<figure class:list={['ambiente', `ambiente--${tipo}`, 'tema-claro']} data-marco data-ambiente style={`--ar-obra: ${r(ratio)}`}>
  {
    capas.map((c) => (
      <div class="estancia" data-estancia={c.id} data-cabe={c.cabe ? '' : undefined} data-canto={c.canto} data-pie={c.pie} hidden={c !== inicial} style={c.estilo}>
        <div class="foto" aria-hidden="true">
          <img class="foto__fondo" src={c.fondo.src} srcset={c.fondo.srcset} sizes={c.sizes} alt="" loading="lazy" decoding="async" draggable="false" />

          <div class="cuadro">
            <div class="cuadro__obra">
              <img src={src} srcset={srcset} sizes="(max-width: 900px) 50vw, 25vw" alt="" loading="lazy" decoding="async" draggable="false" />
            </div>
          </div>

          <!-- La luz de la habitación sobre la obra: la misma foto, en «multiplicar» y recortada a la obra -->
          <img class="foto__luz" src={c.fondo.src} srcset={c.fondo.srcset} sizes={c.sizes} alt="" loading="lazy" decoding="async" draggable="false" />
        </div>
      </div>
    ))
  }
  {
    candidatas.length > 1 && (
      <button class="ambiente__otra" type="button" data-otra hidden>
        <svg aria-hidden="true" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 11a8 8 0 0 0-14.9-4M4 4v4h4" />
          <path d="M4 13a8 8 0 0 0 14.9 4M20 20v-4h-4" />
        </svg>
        Otra estancia
      </button>
    )
  }
  <figcaption class="sr-only" data-pie-activo aria-live="polite">{inicial.pie}</figcaption>
</figure>

<style>
  .ambiente {
    position: relative;
    margin: 0;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    container-type: size;
    background: #e6e4e0;
    /* Hueco libre arriba (la cabecera superpuesta en móvil) */
    --despeje: 0px;
    /* Aire mínimo entre el borde de arriba y la obra (y la cabecera, si se ve) */
    --margen: max(96px, 11cqh);
  }
  .estancia {
    position: absolute;
    inset: 0;
  }
  .estancia[hidden] {
    display: none;
  }

  /* La foto cubre el marco (como object-fit: cover, con zoom opcional) y deja
     el foco de la estancia en el centro del hueco visible, pero sin que la
     obra quede a menos de --margen del borde de arriba (si no cabe todo, se
     recorta antes el mueble de abajo que el aire de encima). 1em = 1 cm. */
  .foto {
    --fw: calc(max(100cqw, 100cqh * var(--ar)) * var(--zoom));
    --fh: calc(var(--fw) * var(--ra));
    position: absolute;
    width: var(--fw);
    height: var(--fh);
    left: clamp(calc(100cqw - var(--fw)), calc(50cqw - var(--fx) * var(--fw)), 0px);
    top: clamp(
      calc(100cqh - var(--fh)),
      max(calc(50cqh + var(--despeje) / 2 - var(--fy) * var(--fh)), calc(var(--margen) - var(--arte-y) * var(--fh))),
      var(--despeje)
    );
    font-size: calc(var(--fw) * var(--em));
  }
  .foto__fondo,
  .foto__luz {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
  }
  /* La luz real de la estancia sobre el cuadro */
  .foto__luz {
    clip-path: var(--recorte);
    mix-blend-mode: multiply;
    filter: brightness(var(--luz-brillo)) contrast(var(--luz-contraste));
    opacity: var(--luz-op);
    pointer-events: none;
  }

  /* ---------- La obra ---------- */
  .cuadro {
    position: absolute;
    left: var(--x);
    bottom: var(--base);
    width: calc(var(--obra-w) * 1em);
    height: calc(var(--obra-h) * 1em);
    transform: translateX(-50%);
    box-shadow: var(--s1), var(--s2);
  }
  .cuadro__obra {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .cuadro__obra img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Papel: marco negro fino con bisel, paspartú y cristal */
  .ambiente--papel .cuadro {
    padding: calc(var(--marco) * 1em);
    background: linear-gradient(135deg, #3b3835, #141312 45%, #201e1c);
  }
  .ambiente--papel .cuadro__obra {
    padding: calc(var(--paspartu) * 1em);
    background: linear-gradient(160deg, #fbfaf7, #f0ede6);
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.2),
      inset 0.25em 0.25em 0.5em rgba(0, 0, 0, 0.16);
  }
  .ambiente--papel .cuadro__obra img {
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.12),
      inset 0 0 0.4em rgba(0, 0, 0, 0.1);
  }
  .ambiente--papel .cuadro::after {
    content: '';
    position: absolute;
    inset: calc(var(--marco) * 1em);
    background: linear-gradient(118deg, transparent 0 30%, rgba(255, 255, 255, 0.14) 36%, transparent 47%, transparent 64%, rgba(255, 255, 255, 0.06) 68%, transparent 73%);
    pointer-events: none;
  }

  /* Lienzo: canto del bastidor, del lado que ve la cámara */
  .ambiente--lienzo .cuadro__obra {
    box-shadow:
      inset -0.35em 0 0.45em rgba(0, 0, 0, 0.2),
      inset 0 -0.3em 0.45em rgba(0, 0, 0, 0.12);
  }
  .ambiente--lienzo [data-canto='izq'] .cuadro__obra {
    box-shadow:
      inset 0.35em 0 0.45em rgba(0, 0, 0, 0.2),
      inset 0 -0.3em 0.45em rgba(0, 0, 0, 0.12);
  }
  .ambiente--lienzo [data-canto='der'] .cuadro::before,
  .ambiente--lienzo [data-canto='izq'] .cuadro::before {
    content: '';
    position: absolute;
    top: 0.5em;
    width: 1.1em;
    height: calc(100% - 0.5em);
  }
  .ambiente--lienzo [data-canto='der'] .cuadro::before {
    right: -1.1em;
    background: linear-gradient(90deg, rgba(40, 32, 24, 0.5), rgba(40, 32, 24, 0.18));
    transform: skewY(-35deg);
    transform-origin: left top;
  }
  .ambiente--lienzo [data-canto='izq'] .cuadro::before {
    left: -1.1em;
    background: linear-gradient(270deg, rgba(40, 32, 24, 0.5), rgba(40, 32, 24, 0.18));
    transform: skewY(35deg);
    transform-origin: right top;
  }

  /* ---------- Otra estancia ---------- */
  .ambiente__otra {
    position: absolute;
    z-index: 2;
    right: 20px;
    bottom: 20px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    padding: 0 18px 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: var(--radius-pill);
    background: rgba(250, 250, 248, 0.72);
    -webkit-backdrop-filter: blur(10px) saturate(1.4);
    backdrop-filter: blur(10px) saturate(1.4);
    box-shadow: 0 8px 24px -12px rgba(20, 16, 10, 0.45);
    font: 600 13px/1 var(--font-body);
    letter-spacing: 0.02em;
    color: var(--ink);
    cursor: pointer;
    transition:
      background 0.3s ease,
      transform 0.3s var(--ease-out);
  }
  .ambiente__otra[hidden] {
    display: none;
  }
  .ambiente__otra:hover {
    background: rgba(250, 250, 248, 0.92);
  }
  .ambiente__otra svg {
    transition: transform 0.6s var(--ease-out);
  }
  .ambiente__otra:hover svg {
    transform: rotate(180deg);
  }
  .ambiente__otra:active {
    transform: scale(0.97);
  }
  .ambiente__otra:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 900px) {
    .ambiente {
      flex: 0 0 100%;
      /* Al menos tan alta como la foto principal del carrusel (misma fórmula
         que .marco en GaleriaObra: 84 px arriba + 56 px abajo), para que no
         quede hueco debajo. Altura explícita: con «auto» las unidades cqh
         valen 0 y la foto se descoloca. */
      height: max(420px, min(86svh, 125vw), min(86svh, calc(100vw / var(--ar-obra) + 140px)));
      min-height: 0;
      scroll-snap-align: start;
      /* La cabecera superpuesta ocupa la parte de arriba: la foto baja para
         que la obra quede debajo. */
      --despeje: 64px;
      --margen: calc(var(--despeje) + 28px);
    }
    .ambiente__otra {
      right: 14px;
      bottom: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ambiente__otra,
    .ambiente__otra svg {
      transition: none;
    }
  }
</style>

<script>
  // Cada visita, una estancia al azar (de las que la obra cabe a escala);
  // «Otra estancia» pasa a la siguiente con un fundido.
  const reducir = matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-ambiente]').forEach((fig) => {
    const capas = [...fig.querySelectorAll<HTMLElement>('[data-estancia]')];
    const boton = fig.querySelector<HTMLButtonElement>('[data-otra]');
    const pie = fig.querySelector<HTMLElement>('[data-pie-activo]');
    const caben = capas.filter((c) => c.hasAttribute('data-cabe'));
    const orden = (caben.length ? caben : capas).slice();
    if (orden.length < 2) return;

    // Orden aleatorio (Fisher–Yates): la primera es la de esta visita.
    for (let i = orden.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [orden[i], orden[j]] = [orden[j], orden[i]];
    }
    let actual = capas.find((c) => !c.hidden)!;
    let i = 0;

    // Deja visible solo la estancia actual.
    const recoger = () =>
      capas.forEach((c) => {
        c.hidden = c !== actual;
        c.style.zIndex = '';
        c.style.opacity = '';
      });

    const mostrar = async (nueva: HTMLElement, fundido: boolean) => {
      if (nueva === actual) return;
      actual = nueva;
      if (pie) pie.textContent = nueva.dataset.pie ?? '';
      if (!fundido || reducir.matches) {
        recoger();
        return;
      }
      // Encima de la anterior y transparente hasta que su foto esté lista.
      nueva.style.zIndex = '1';
      nueva.style.opacity = '0';
      nueva.hidden = false;
      const fondo = nueva.querySelector<HTMLImageElement>('.foto__fondo');
      if (fondo) {
        fondo.loading = 'eager';
        await fondo.decode().catch(() => {});
      }
      if (actual !== nueva) return; // otro clic mientras cargaba
      nueva.style.opacity = '';
      await nueva
        .animate([{ opacity: 0 }, { opacity: 1 }], { duration: 650, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' })
        .finished.catch(() => {});
      if (actual === nueva) recoger();
    };

    mostrar(orden[0], false);
    if (boton) {
      boton.hidden = false;
      boton.addEventListener('click', () => {
        i = (i + 1) % orden.length;
        mostrar(orden[i], true);
      });
    }
  });
</script>
