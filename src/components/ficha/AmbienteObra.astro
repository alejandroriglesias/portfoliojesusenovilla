---
/**
 * Vista «en casa»: la obra montada sobre una fotografía real de un salón
 * (aparador de roble acanalado, pared blanca con luz de ventana).
 *
 * Foto: Imani Bahati en Unsplash (licencia Unsplash: uso libre, también
 * comercial, sin atribución obligatoria).
 * https://unsplash.com/photos/UrQeWGobTnI
 *
 * Cómo se monta:
 * - Escala: el aparador mide unos 2250 px en la foto original (2400 × 2999) y
 *   unos 180 cm en la realidad → 12,5 px por cm. Dentro de la foto, 1em = 1 cm.
 * - La obra cuelga en la pared libre sobre la lámpara, a la izquierda de las
 *   ramas del jarrón. Si es más grande que ese hueco, se reduce (y deja de
 *   estar a escala).
 * - Realismo: encima de la obra se superpone la propia foto en modo
 *   «multiplicar», así la sombra de la ventana cruza también el cuadro; la
 *   sombra arrojada va hacia la derecha, como la de la lámpara.
 * - Papel: marco negro fino, paspartú y reflejo de cristal. Lienzo: canto.
 */
import { getImage } from 'astro:assets';
import salon from '../../assets/ambiente/salon.jpg';

interface Props {
  src: string;
  srcset: string;
  /** Ancho / alto de la imagen de la obra. */
  ratio: number;
  tipo: 'lienzo' | 'papel';
  /** Lado largo de la obra en cm (sin marco). */
  ladoLargo: number;
  /** true si ladoLargo sale de las medidas de la ficha. */
  aEscala: boolean;
}

const { src, srcset, ratio, tipo, ladoLargo, aEscala } = Astro.props;

// ---- Geometría de la foto original (px) ----
const FOTO = { w: 2400, h: 2999 };
const PX_CM = 12.5;
const CENTRO_X = 640; // centro del hueco libre en la pared
const BASE_Y = 1040; // borde inferior de la obra (por encima de la lámpara)
const MAX = { w: 88, h: 74 }; // cm que caben en ese hueco

// ---- Medidas de lo que cuelga (cm) ----
const PASPARTU = tipo === 'papel' ? Math.max(5, Math.min(10, ladoLargo * 0.12)) : 0;
const MARCO = tipo === 'papel' ? 2.4 : 0;
const ancho = ratio >= 1 ? ladoLargo : ladoLargo * ratio;
const alto = ratio >= 1 ? ladoLargo / ratio : ladoLargo;
const bruto = { w: ancho + 2 * (PASPARTU + MARCO), h: alto + 2 * (PASPARTU + MARCO) };
// Si no cabe en el hueco de la pared, se reduce todo en proporción.
const reduccion = Math.min(1, MAX.w / bruto.w, MAX.h / bruto.h);
const exterior = { w: bruto.w * reduccion, h: bruto.h * reduccion };
const escala = aEscala && reduccion === 1;

// Rectángulo de la obra en % de la foto (para recortar la capa de luz).
const rect = {
  izq: ((CENTRO_X - (exterior.w * PX_CM) / 2) / FOTO.w) * 100,
  der: 100 - ((CENTRO_X + (exterior.w * PX_CM) / 2) / FOTO.w) * 100,
  arr: ((BASE_Y - exterior.h * PX_CM) / FOTO.h) * 100,
  aba: 100 - (BASE_Y / FOTO.h) * 100,
};

const fondo = await getImage({ src: salon, widths: [800, 1200, 1600, 2400], format: 'webp', quality: 80 });
const fondoSizes = '(max-width: 900px) 100vw, 56vw';

const r = (x: number) => +x.toFixed(3);
const estilo = [
  `--obra-w: ${r(exterior.w)}`,
  `--obra-h: ${r(exterior.h)}`,
  `--paspartu: ${r(PASPARTU * reduccion)}`,
  `--marco: ${r(MARCO * reduccion)}`,
  `--x: ${r((CENTRO_X / FOTO.w) * 100)}%`,
  `--base: ${r(100 - (BASE_Y / FOTO.h) * 100)}%`,
  `--recorte: inset(${r(rect.arr)}% ${r(rect.der)}% ${r(rect.aba)}% ${r(rect.izq)}%)`,
].join('; ');
const pie = escala ? 'La obra colgada en un salón, a escala' : 'La obra colgada en un salón (recreación orientativa)';
---

<figure class:list={['ambiente', `ambiente--${tipo}`]} data-marco data-ambiente style={estilo}>
  <div class="foto" aria-hidden="true">
    <img class="foto__fondo" src={fondo.src} srcset={fondo.srcSet.attribute} sizes={fondoSizes} alt="" loading="lazy" decoding="async" draggable="false" />

    <div class="cuadro">
      <div class="cuadro__obra">
        <img src={src} srcset={srcset} sizes="(max-width: 900px) 50vw, 25vw" alt="" loading="lazy" decoding="async" draggable="false" />
      </div>
    </div>

    <!-- La luz de la habitación sobre la obra: la misma foto, en «multiplicar» y recortada a la obra -->
    <img class="foto__luz" src={fondo.src} srcset={fondo.srcSet.attribute} sizes={fondoSizes} alt="" loading="lazy" decoding="async" draggable="false" />
  </div>
  <figcaption class="sr-only">{pie}</figcaption>
</figure>

<style>
  .ambiente {
    position: relative;
    margin: 0;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    container-type: size;
    background: #e6e4e0;
  }

  /* La foto cubre el marco (como object-fit: cover), centrada cerca de la obra.
     Dentro, 1em = 1 cm de la escena. */
  .foto {
    --fw: max(100cqw, calc(100cqh * 0.8003));
    --fh: calc(var(--fw) * 1.24958);
    position: absolute;
    width: var(--fw);
    height: var(--fh);
    left: clamp(calc(100cqw - var(--fw)), calc(50cqw - 0.3 * var(--fw)), 0px);
    top: clamp(calc(100cqh - var(--fh)), calc(50cqh - 0.4 * var(--fh)), 0px);
    font-size: calc(var(--fw) * 0.0052083);
  }
  .foto__fondo,
  .foto__luz {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    user-select: none;
  }
  /* La luz real (sombra de la ventana) sobre el cuadro */
  .foto__luz {
    clip-path: var(--recorte);
    mix-blend-mode: multiply;
    filter: brightness(1.12) contrast(1.08);
    opacity: 0.75;
    pointer-events: none;
  }

  /* ---------- La obra ---------- */
  .cuadro {
    position: absolute;
    left: var(--x);
    bottom: var(--base);
    width: calc(var(--obra-w) * 1em);
    height: calc(var(--obra-h) * 1em);
    transform: translateX(-50%);
    /* Sombra hacia la derecha y abajo, como la de la lámpara */
    box-shadow:
      0.35em 0.5em 0.7em rgba(30, 24, 18, 0.32),
      1.6em 2.4em 4.5em rgba(30, 24, 18, 0.2);
  }
  .cuadro__obra {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }
  .cuadro__obra img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Papel: marco negro fino con bisel, paspartú y cristal */
  .ambiente--papel .cuadro {
    padding: calc(var(--marco) * 1em);
    background: linear-gradient(135deg, #3b3835, #141312 45%, #201e1c);
  }
  .ambiente--papel .cuadro__obra {
    padding: calc(var(--paspartu) * 1em);
    background: linear-gradient(160deg, #fbfaf7, #f0ede6);
    box-shadow:
      inset 0 0 0 1px rgba(0, 0, 0, 0.2),
      inset 0.25em 0.25em 0.5em rgba(0, 0, 0, 0.16);
  }
  .ambiente--papel .cuadro__obra img {
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.12),
      inset 0 0 0.4em rgba(0, 0, 0, 0.1);
  }
  .ambiente--papel .cuadro::after {
    content: '';
    position: absolute;
    inset: calc(var(--marco) * 1em);
    background: linear-gradient(118deg, transparent 0 30%, rgba(255, 255, 255, 0.14) 36%, transparent 47%, transparent 64%, rgba(255, 255, 255, 0.06) 68%, transparent 73%);
    pointer-events: none;
  }

  /* Lienzo: canto del bastidor */
  .ambiente--lienzo .cuadro__obra {
    box-shadow:
      inset -0.35em 0 0.45em rgba(0, 0, 0, 0.2),
      inset 0 -0.3em 0.45em rgba(0, 0, 0, 0.12);
  }
  .ambiente--lienzo .cuadro::before {
    content: '';
    position: absolute;
    top: 0.5em;
    right: -1.1em;
    width: 1.1em;
    height: calc(100% - 0.5em);
    background: linear-gradient(90deg, rgba(40, 32, 24, 0.5), rgba(40, 32, 24, 0.18));
    transform: skewY(-35deg);
    transform-origin: left top;
  }

  @media (max-width: 900px) {
    .ambiente {
      flex: 0 0 100%;
      height: min(86svh, 125vw);
      min-height: 420px;
      scroll-snap-align: start;
    }
    /* La cabecera ocupa ~110 px arriba: la foto baja para que la obra quede
       debajo (se recorta el sofá de abajo). */
    .foto {
      top: 104px;
    }
  }
</style>
