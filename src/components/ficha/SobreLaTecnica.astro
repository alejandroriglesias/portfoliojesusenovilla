---
/** Bloque negro «Sobre la técnica» de la ficha v2. */
import { render } from 'astro:content';
import type { Tecnica } from '../../lib/contenido';

interface Props {
  tecnica: Tecnica;
  numero?: string;
  /** Enlace a la página de la técnica (no tiene sentido dentro de ella). */
  enlace?: boolean;
}

const { tecnica, numero = '(03)', enlace = true } = Astro.props;
const tieneTexto = !!tecnica.body?.trim();
const { Content } = await render(tecnica);

// Titular con la última palabra en color de acento.
const titular = tecnica.data.titular ?? `${tecnica.data.nombre}.`;
const palabras = titular.trim().split(/\s+/);
const ultima = palabras.pop();
const resto = palabras.join(' ');
const letrasMax = Math.max(...titular.split(/\s+/).map((p) => p.length));
---

{
  tieneTexto && (
    <section class="tecnica" aria-labelledby="tecnica-titulo">
      <div class="tecnica__in">
        <div class="tecnica__col">
        <p id="tecnica-titulo" class="tecnica__titular" style={`--n: ${letrasMax}`} data-ajustar>
          {resto && `${resto} `}
          <span class="acento">{ultima}</span>
        </p>
        </div>
        <div class="tecnica__texto">
          <h2 class="etiqueta tecnica__etiqueta">
            {numero && `${numero} `}La técnica · {tecnica.data.nombre}
          </h2>
          <div class="tecnica__cuerpo">
            <Content />
          </div>
          {enlace && (
            <a class="tecnica__enlace" href={`/tecnicas/${tecnica.id}`}>
              Ver más obras en {tecnica.data.nombre.toLowerCase()} <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

<style>
  .tecnica {
    background: var(--black);
    color: var(--paper);
  }
  .tecnica__in {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(88px, 11vw, 160px) var(--gutter);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 40px 80px;
    align-items: end;
  }
  /* La columna es un contenedor: el titular se ajusta a su ancho real. */
  .tecnica__col {
    container-type: inline-size;
    min-width: 0;
  }
  .tecnica__titular {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    /* Tamaño del prototipo; data-ajustar lo reduce si una palabra no cabe.
       Sin JS, la estimación por letras (≈0.8em) evita desbordes graves. */
    font-size: clamp(32px, min(max(7.5vw, 11cqi), calc(100cqi / (var(--n) * 0.8))), 128px);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  .acento {
    color: var(--accent-on-dark);
  }
  .tecnica__texto {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 460px;
  }
  .tecnica__etiqueta {
    font-family: var(--font-body);
    color: #a8a59e;
  }
  .tecnica__cuerpo {
    font-size: 17px;
    line-height: 1.65;
    color: #c9c6bf;
  }
  .tecnica__cuerpo :global(p) {
    margin: 0 0 1em;
  }
  .tecnica__cuerpo :global(p:last-child) {
    margin-bottom: 0;
  }
  .tecnica__enlace {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--tap);
    color: var(--paper);
    font-weight: 600;
    font-size: 15px;
    text-underline-offset: 5px;
  }
  .tecnica :focus-visible {
    outline-color: var(--accent-on-dark);
  }
</style>
