---
/**
 * Foto de detalle (segunda vista de la ficha): la obra ampliada alrededor de
 * un punto (Keystatic → «Foto de detalle»), a sangre en su marco, como una
 * foto macro. Al entrar en pantalla, la ampliación se hace despacio, como
 * acercarse a mirar. Un pequeño mapa en la esquina muestra la obra entera y
 * marca qué parte se está viendo.
 */
interface Props {
  /** Versión grande de la imagen (hasta 3000 px). */
  src: string;
  /** Miniatura para el mapa. */
  mini: string;
  ratio: number;
  /** Punto ampliado, en % de la obra. */
  x: number;
  y: number;
  /** true: el punto no se eligió en el panel; se busca la zona con más detalle. */
  auto?: boolean;
  alt: string;
}
const { src, mini, ratio, x, y, auto = false, alt } = Astro.props;
const ZOOM = 2.2;
---

<figure class="detalle" data-marco data-detalle data-auto={auto ? '' : undefined} style={`--x: ${x}%; --y: ${y}%; --z: ${ZOOM}; --ar: ${ratio}`}>
  <div class="detalle__lupa">
    <img src={src} alt={`Detalle: ${alt}`} loading="lazy" decoding="async" draggable="false" data-lupa />
  </div>
  <figcaption class="detalle__pie">
    <span class="punto" aria-hidden="true"></span>Detalle · ×{String(ZOOM).replace('.', ',')}
  </figcaption>
  <div class="detalle__mapa" aria-hidden="true">
    <img src={mini} alt="" loading="lazy" decoding="async" draggable="false" data-mini />
    <span class="detalle__caja" data-caja></span>
  </div>
</figure>

<style>
  .detalle {
    position: relative;
    margin: 0;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    background: var(--card);
  }
  .detalle__lupa {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .detalle__lupa img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--x) var(--y);
    transform-origin: var(--x) var(--y);
    transform: scale(var(--z));
    user-select: none;
  }
  /* Acercarse despacio al entrar en pantalla */
  @media (prefers-reduced-motion: no-preference) {
    .detalle:not(.is-cerca) .detalle__lupa img {
      transform: scale(1.15);
    }
    .detalle__lupa img {
      transition: transform 2.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .detalle__caja {
      transition:
        left 2.4s cubic-bezier(0.22, 1, 0.36, 1),
        top 2.4s cubic-bezier(0.22, 1, 0.36, 1),
        width 2.4s cubic-bezier(0.22, 1, 0.36, 1),
        height 2.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
  }

  .detalle__pie {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: rgba(250, 248, 242, 0.92);
    backdrop-filter: blur(6px);
    font: 600 11px/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
    white-space: nowrap;
  }
  .punto {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Mapa: la obra entera con la zona ampliada marcada */
  .detalle__mapa {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: clamp(72px, 8vw, 112px);
    aspect-ratio: var(--ar);
    max-height: 140px;
    overflow: hidden;
    border: 3px solid #fafaf8;
    border-radius: 3px;
    box-shadow: 0 8px 22px -8px rgba(20, 16, 10, 0.5);
    background: var(--card);
  }
  .detalle__mapa img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .detalle__caja {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    border: 1.5px solid var(--accent);
    /* Oscurece lo que queda fuera de la zona ampliada */
    box-shadow: 0 0 0 200px rgba(12, 10, 8, 0.42);
  }

  @media (max-width: 900px) {
    .detalle {
      flex: 0 0 100%;
      height: min(86svh, 125vw);
      min-height: 420px;
      scroll-snap-align: start;
    }
    .detalle__pie {
      bottom: 14px;
      left: 16px;
      transform: none;
    }
    .detalle__mapa {
      right: 14px;
      bottom: 14px;
      width: 72px;
    }
  }
</style>

<script>
  /** Calcula qué parte de la obra se ve y la marca en el mapa. */
  const marcar = (fig: HTMLElement) => {
    const img = fig.querySelector<HTMLImageElement>('[data-lupa]');
    const caja = fig.querySelector<HTMLElement>('[data-caja]');
    if (!img || !caja) return;
    const W = fig.clientWidth;
    const H = fig.clientHeight;
    const ar = parseFloat(getComputedStyle(fig).getPropertyValue('--ar')) || 1;
    const px = parseFloat(getComputedStyle(fig).getPropertyValue('--x')) / 100;
    const py = parseFloat(getComputedStyle(fig).getPropertyValue('--y')) / 100;
    const z = fig.classList.contains('is-cerca') || matchMedia('(prefers-reduced-motion: reduce)').matches
      ? parseFloat(getComputedStyle(fig).getPropertyValue('--z')) || 2
      : 1.15;
    // object-fit: cover
    const rw = Math.max(W, H * ar);
    const rh = rw / ar;
    const ox = (W - rw) * px;
    const oy = (H - rh) * py;
    // scale(z) con origen en el punto elegido
    const cx = px * W;
    const cy = py * H;
    const x0 = cx - cx / z;
    const x1 = cx + (W - cx) / z;
    const y0 = cy - cy / z;
    const y1 = cy + (H - cy) / z;
    const f = (v: number, o: number, r: number) => Math.min(1, Math.max(0, (v - o) / r));
    const l = f(x0, ox, rw);
    const r = f(x1, ox, rw);
    const t = f(y0, oy, rh);
    const b = f(y1, oy, rh);
    caja.style.left = `${l * 100}%`;
    caja.style.top = `${t * 100}%`;
    caja.style.width = `${(r - l) * 100}%`;
    caja.style.height = `${(b - t) * 100}%`;
  };

  /**
   * Sin punto elegido en el panel: busca en la miniatura la zona con más
   * detalle (más contraste local), con algo de preferencia por el centro.
   */
  const buscarDetalle = (fig: HTMLElement) => {
    const mini = fig.querySelector<HTMLImageElement>('[data-mini]');
    if (!mini) return;
    const analizar = () => {
      const N = 48;
      const ar = mini.naturalWidth / mini.naturalHeight || 1;
      const w = ar >= 1 ? N : Math.round(N * ar);
      const h = ar >= 1 ? Math.round(N / ar) : N;
      const lienzo = document.createElement('canvas');
      lienzo.width = w;
      lienzo.height = h;
      const ctx = lienzo.getContext('2d', { willReadFrequently: true });
      if (!ctx) return;
      ctx.drawImage(mini, 0, 0, w, h);
      let datos: Uint8ClampedArray;
      try {
        datos = ctx.getImageData(0, 0, w, h).data;
      } catch {
        return;
      }
      const lum = (i: number, j: number) => {
        const k = (j * w + i) * 4;
        return 0.3 * datos[k] + 0.59 * datos[k + 1] + 0.11 * datos[k + 2];
      };
      // Energía de bordes por píxel
      const borde = new Float32Array(w * h);
      for (let j = 1; j < h - 1; j++)
        for (let i = 1; i < w - 1; i++)
          borde[j * w + i] = Math.abs(lum(i + 1, j) - lum(i - 1, j)) + Math.abs(lum(i, j + 1) - lum(i, j - 1));
      // Ventana del tamaño aproximado de lo que se ve ampliado
      const vw = Math.max(4, Math.round(w / 2.6));
      const vh = Math.max(4, Math.round(h / 2.6));
      let mejor = -1;
      let bx = w / 2;
      let by = h / 2;
      for (let j = 0; j + vh <= h; j += 2)
        for (let i = 0; i + vw <= w; i += 2) {
          let suma = 0;
          for (let y = j; y < j + vh; y++) for (let x = i; x < i + vw; x++) suma += borde[y * w + x];
          const cx = (i + vw / 2) / w - 0.5;
          const cy = (j + vh / 2) / h - 0.5;
          const puntuacion = suma * (1 - 0.6 * Math.hypot(cx, cy));
          if (puntuacion > mejor) {
            mejor = puntuacion;
            bx = i + vw / 2;
            by = j + vh / 2;
          }
        }
      fig.style.setProperty('--x', `${((bx / w) * 100).toFixed(1)}%`);
      fig.style.setProperty('--y', `${((by / h) * 100).toFixed(1)}%`);
      marcar(fig);
    };
    if (mini.complete && mini.naturalWidth) analizar();
    else mini.addEventListener('load', analizar, { once: true });
  };

  document.querySelectorAll<HTMLElement>('[data-detalle]').forEach((fig) => {
    if (fig.hasAttribute('data-auto')) {
      // La miniatura es diminuta: se carga ya para poder analizarla.
      fig.querySelector<HTMLImageElement>('[data-mini]')?.setAttribute('loading', 'eager');
      buscarDetalle(fig);
    }
    marcar(fig);
    new ResizeObserver(() => marcar(fig)).observe(fig);
    new IntersectionObserver(
      ([e], obs) => {
        if (!e.isIntersecting) return;
        fig.classList.add('is-cerca');
        marcar(fig);
        obs.disconnect();
      },
      { threshold: 0.35 }
    ).observe(fig);
  });
</script>
