---
/**
 * Bloque de contacto de las portadas.
 * - galeria (01): «¿Te interesa alguna obra?» con botones.
 * - luz (02): pantalla completa en color de acento, «Hablemos de una obra →».
 * - taller (04–06): «Escríbeme →» subrayado al pasar + email e Instagram.
 */
import { usuarioInstagram } from '../../lib/ajustes';
import { esMarcador } from '../../lib/contenido';
import type { DatosPortada } from '../../lib/portada';

interface Props {
  ajustes: DatosPortada['ajustes'];
  variante?: 'galeria' | 'luz' | 'taller';
  etiqueta?: string;
}

const { ajustes: a, variante = 'galeria', etiqueta } = Astro.props;
const emailValido = !!a.email && !esMarcador(a.email) && a.email.includes('@');
const mailto = emailValido ? `mailto:${a.email}` : '/contacto';
const insta = usuarioInstagram(a.instagram);
---

{
  variante === 'galeria' && (
    <section id="contacto" class="c-galeria" aria-labelledby="contacto-titulo">
      <div class="c-galeria__in">
        <p class="etiqueta">{etiqueta ?? 'Contacto'}</p>
        <h2 id="contacto-titulo" class="c-galeria__h2" data-ajustar>
          ¿Te interesa
          <br />
          alguna obra<span class="acento">?</span>
        </h2>
        <p class="c-galeria__texto">Escríbeme para consultar disponibilidad, precios o encargos.</p>
        <div class="c-galeria__botones">
          <a class="boton boton--acento" href={mailto}>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
            {a.email}
          </a>
          {a.instagram && (
            <a class="boton boton--borde" href={a.instagram} rel="me noopener">
              <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="0.5" /></svg>
              {insta}
            </a>
          )}
        </div>
      </div>
    </section>
  )
}

{
  variante === 'luz' && (
    <section id="contacto" class="c-luz" aria-labelledby="contacto-titulo">
      <div class="c-luz__in">
        <p class="etiqueta c-luz__etiqueta">{etiqueta ?? 'Contacto'}</p>
        <h2 id="contacto-titulo" class="c-luz__h2">
          <a href={mailto} data-ajustar>
            Hablemos
            <br />
            <span class="nowrap">
              de una obra&nbsp;<span class="flecha" aria-hidden="true">→</span>
            </span>
          </a>
        </h2>
        <div class="c-luz__enlaces">
          <a href={mailto}>{a.email}</a>
          {a.instagram && <a href={a.instagram} rel="me noopener">Instagram · {insta}</a>}
        </div>
      </div>
    </section>
  )
}

{
  variante === 'taller' && (
    <section id="contacto" class="c-taller" aria-labelledby="contacto-titulo">
      <div class="c-taller__in">
        <div class="c-taller__col">
          <p class="etiqueta">{etiqueta ?? 'Consultas y encargos'}</p>
          <h2 id="contacto-titulo" class="c-taller__h2">
            <a class="subrayado" href={mailto} data-ajustar>
              Escríbeme&nbsp;<span aria-hidden="true">→</span>
            </a>
          </h2>
        </div>
        <div class="c-taller__enlaces">
          <a href={mailto}>{a.email}</a>
          {a.instagram && <a href={a.instagram} rel="me noopener">Instagram · {insta}</a>}
        </div>
      </div>
    </section>
  )
}

<style>
  .acento {
    color: var(--accent);
  }
  .nowrap {
    white-space: nowrap;
  }
  /* Galería */
  .c-galeria {
    border-top: 1px solid var(--line);
  }
  .c-galeria__in {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(80px, 10vw, 144px) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .c-galeria__h2 {
    font-weight: 800;
    font-size: clamp(44px, 8.5vw, 140px);
    line-height: 0.92;
    letter-spacing: -0.015em;
  }
  .c-galeria__texto {
    margin: 0;
    max-width: 560px;
    font-size: 20px;
    color: var(--text-soft);
  }
  .c-galeria__botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .c-galeria__botones .boton {
    min-height: 56px;
    font-size: 16px;
  }

  /* Luz */
  .c-luz {
    background: var(--accent);
    color: var(--on-accent);
  }
  .c-luz__in {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(88px, 11vw, 160px) var(--gutter);
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .c-luz__etiqueta {
    color: inherit;
  }
  .c-luz__h2 {
    font-weight: 800;
    font-size: clamp(44px, 9vw, 156px);
    line-height: 0.9;
    letter-spacing: -0.015em;
  }
  .c-luz__h2 a {
    display: block;
    max-width: 100%;
    color: inherit;
    text-decoration: none;
  }
  .flecha {
    display: inline-block;
    transition: transform 0.35s ease;
  }
  .c-luz__h2 a:hover .flecha {
    transform: translateX(18px);
  }
  .c-luz__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    font-size: 18px;
  }
  .c-luz__enlaces a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: inherit;
    text-underline-offset: 5px;
  }
  .c-luz :focus-visible {
    outline-color: #fff;
  }

  /* Taller */
  .c-taller {
    border-top: 1px solid var(--line);
  }
  .c-taller__in {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(80px, 10vw, 136px) var(--gutter);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 32px 48px;
  }
  .c-taller__col {
    display: flex;
    flex-direction: column;
    gap: 20px;
    min-width: 0;
    max-width: 100%;
  }
  .c-taller__h2 {
    font-weight: 800;
    font-size: clamp(44px, 8vw, 132px);
    line-height: 0.95;
    letter-spacing: -0.015em;
  }
  .subrayado {
    display: inline-block;
    max-width: 100%;
    color: var(--ink);
    text-decoration: none;
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 4px;
    background-repeat: no-repeat;
    background-position: 0 100%;
    transition: background-size 0.5s ease;
  }
  .subrayado:hover,
  .subrayado:focus-visible {
    background-size: 100% 4px;
  }
  .c-taller__enlaces {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 18px;
  }
  .c-taller__enlaces a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--ink);
    text-underline-offset: 4px;
  }
</style>
