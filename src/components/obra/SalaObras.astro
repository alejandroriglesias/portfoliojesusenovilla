---
/**
 * Vista «Sala» del índice de obra: una pared por técnica con un carrusel
 * horizontal (como las colecciones de la referencia), con el estilo de la
 * ficha: obras enteras, sin recortar, a la misma altura y con su sombra
 * sobre el color de pared.
 *
 * - El carril sale por la derecha de la pantalla, invitando a deslizar.
 * - Se recorre con flechas, arrastrando con el ratón (con inercia), con el
 *   gesto lateral del trackpad, con el dedo o con el teclado.
 * - Barra de progreso fina bajo el carril, como el selector de la ficha.
 * - Al entrar la pared en pantalla, las obras llegan desde la derecha una
 *   tras otra. Al pasar el ratón, la obra se adelanta.
 * - La imagen pulsada crece hasta la ficha (TransicionObras).
 */
import { getImage } from 'astro:assets';
import type { Obra, Tecnica } from '../../lib/contenido';
import { esMarcador } from '../../lib/contenido';

interface Grupo {
  tecnica: Tecnica;
  obras: Obra[];
  /** Etiqueta concreta de cada obra («Grabado · Manera negra»…). */
  etiquetas: string[];
}
interface Props {
  grupos: Grupo[];
}

const { grupos } = Astro.props;
const ANCHOS = [320, 480, 720, 960];

const salas = await Promise.all(
  grupos.map(async (g, gi) => ({
    id: g.tecnica.id,
    numero: String(gi + 1).padStart(2, '0'),
    nombre: g.tecnica.data.nombre,
    resumen: esMarcador(g.tecnica.data.resumen) ? undefined : g.tecnica.data.resumen,
    piezas: await Promise.all(
      g.obras.map(async (o, i) => {
        const im = o.data.imagen;
        const anchos = [...ANCHOS.filter((a) => a < im.width), Math.min(im.width, 960)];
        const img = await getImage({ src: im, widths: [...new Set(anchos)], format: 'webp', quality: 78 });
        // En el grabado, la subtécnica; en el resto, solo el año.
        const sub = g.etiquetas[i].split(' · ')[1];
        return {
          href: `/obra/${o.id}`,
          src: img.src,
          srcset: img.srcSet.attribute,
          ancho: im.width,
          alto: im.height,
          ratio: +(im.width / im.height).toFixed(4),
          titulo: o.data.titulo,
          meta: [sub, o.data.anio].filter(Boolean).join(' · '),
          alt: o.data.alt ?? o.data.titulo,
          aviso: import.meta.env.DEV && (o.data.ejemplo || !o.data.publicada) ? (o.data.ejemplo ? 'ejemplo' : 'oculta') : undefined,
        };
      })
    ),
  }))
);
---

<div class="salas">
  {
    salas.map((s, si) => (
      <section class="sala" data-sala={s.id} aria-labelledby={`sala-${s.id}`}>
        <carrusel-sala class="sala__in">
          <header class="sala__cabeza">
            <p class="sala__n" aria-hidden="true">
              {s.numero}
            </p>
            <h2 id={`sala-${s.id}`} class="sala__titulo">
              {s.nombre}
            </h2>
            <div class="sala__lado">
              <p class="sala__cuenta">
                <span class="punto" aria-hidden="true" />
                {s.piezas.length} {s.piezas.length === 1 ? 'obra' : 'obras'}
              </p>
              {s.resumen && <p class="sala__resumen">{s.resumen}</p>}
              <a class="sala__enlace" href={`/tecnicas/${s.id}`}>
                Sobre la técnica <span aria-hidden="true">→</span>
              </a>
            </div>
            <div class="sala__flechas" role="group" aria-label={`Recorrer ${s.nombre.toLowerCase()}`}>
              <button class="flecha" type="button" data-paso="-1" aria-label="Obras anteriores">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
              </button>
              <button class="flecha" type="button" data-paso="1" aria-label="Obras siguientes">
                <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </button>
            </div>
          </header>

          <ul class="carril" role="list" tabindex="0" aria-label={`${s.nombre}: ${s.piezas.length} obras, desplazable en horizontal`} data-carril>
            {s.piezas.map((p, i) => (
              <li class="pieza" style={`--r: ${p.ratio}; --i: ${Math.min(i, 8)}`}>
                <a class="pieza__enlace" href={p.href} draggable="false">
                  <span class="pieza__marco">
                    <img
                      src={p.src}
                      srcset={p.srcset}
                      sizes="(max-width: 640px) 70vw, 30vw"
                      width={p.ancho}
                      height={p.alto}
                      alt={p.alt}
                      loading={si === 0 && i < 5 ? 'eager' : 'lazy'}
                      decoding="async"
                      draggable="false"
                    />
                  </span>
                  <span class="pieza__pie">
                    <span class="pieza__titulo">{p.titulo}</span>
                    {(p.meta || p.aviso) && (
                      <span class="pieza__meta">
                        {p.meta}
                        {p.aviso && <span class="pieza__aviso"> · {p.aviso}</span>}
                      </span>
                    )}
                  </span>
                </a>
              </li>
            ))}
            <li class="fin" style={`--i: ${Math.min(s.piezas.length, 8)}`}>
              <a class="fin__enlace" href={`/tecnicas/${s.id}`} draggable="false">
                <span class="fin__eti">Fin de la sala</span>
                <span class="fin__titulo">
                  Sobre la técnica
                  <br />
                  {s.nombre.toLowerCase()} <span aria-hidden="true">→</span>
                </span>
              </a>
            </li>
          </ul>

          <div class="progreso" aria-hidden="true">
            <span class="progreso__barra" data-barra />
            <span class="progreso__pista">
              <span class="progreso__raton">Arrastra para recorrer</span>
              <span class="progreso__tactil">Desliza para recorrer</span>
            </span>
          </div>
        </carrusel-sala>
      </section>
    ))
  }
</div>

<style>
  .salas {
    display: flex;
    flex-direction: column;
  }
  .sala {
    --h: clamp(240px, 27vw, 400px);
    --hueco: clamp(28px, 3.4vw, 56px);
    /* Margen izquierdo alineado con el contenedor de la web */
    --margen: max(var(--gutter), calc((100vw - var(--container)) / 2 + var(--gutter)));
    padding: clamp(64px, 8vw, 120px) 0 clamp(56px, 7vw, 96px);
    background: var(--band);
    overflow: hidden;
  }
  .sala + .sala {
    border-top: 1px solid rgba(20, 16, 10, 0.08);
  }
  .sala[hidden] {
    display: none;
  }
  .sala__in {
    display: block;
  }

  /* ---------- Cabecera ---------- */
  /* Título en su propia línea (con las flechas a la derecha) y, debajo,
     número de obras, resumen y enlace: así cabe «Acuarela» a cualquier tamaño. */
  .sala__cabeza {
    padding: 0 var(--margen);
    margin-bottom: clamp(36px, 4.5vw, 64px);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-areas:
      'n titulo flechas'
      '. lado lado';
    align-items: end;
    gap: 18px clamp(16px, 2.4vw, 36px);
  }
  .sala__n {
    grid-area: n;
    align-self: start;
    margin: 0;
    padding-top: 0.5em;
    font: 600 13px/1 var(--font-body);
    letter-spacing: 0.14em;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
  }
  .sala__titulo {
    grid-area: titulo;
    min-width: 0;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(52px, 8vw, 132px);
    line-height: 0.86;
    letter-spacing: -0.015em;
  }
  .sala__lado {
    grid-area: lado;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 28px;
  }
  .sala__resumen {
    max-width: 46em;
  }
  .sala__cuenta {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }
  .sala__resumen {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-soft);
  }
  .sala__enlace {
    align-self: flex-start;
    font: 600 13px/1.4 var(--font-body);
    letter-spacing: 0.04em;
    color: var(--ink);
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat left bottom / 100% 1px;
    transition: background-size 0.5s var(--ease-out);
  }
  .sala__enlace:hover {
    background-position: right bottom;
    background-size: 0 1px;
  }
  .sala__flechas {
    grid-area: flechas;
    display: flex;
    gap: 8px;
    padding-bottom: 0.2em;
  }
  .flecha {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    padding: 0;
    border: 1px solid rgba(20, 20, 20, 0.22);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      background 0.3s ease,
      color 0.3s ease,
      border-color 0.3s ease,
      opacity 0.3s ease;
  }
  .flecha:hover:not(:disabled) {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .flecha:disabled {
    opacity: 0.3;
    cursor: default;
  }

  /* ---------- Carril ---------- */
  .carril {
    display: flex;
    align-items: flex-start;
    gap: var(--hueco);
    margin: 0;
    padding: 12px var(--margen) 28px;
    list-style: none;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--margen);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
    cursor: grab;
  }
  .carril::-webkit-scrollbar {
    display: none;
  }
  .carril:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .carril.is-arrastrando {
    cursor: grabbing;
    scroll-snap-type: none;
    user-select: none;
  }
  .carril.is-arrastrando .pieza__enlace,
  .carril.is-arrastrando .fin__enlace {
    pointer-events: none;
  }

  .pieza {
    flex: 0 0 auto;
    width: min(calc(var(--h) * var(--r)), 78vw);
    scroll-snap-align: start;
  }
  .pieza__enlace {
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .pieza__marco {
    display: block;
    overflow: hidden;
    aspect-ratio: var(--r);
    background: var(--card);
    box-shadow:
      0 1px 2px rgba(20, 16, 10, 0.08),
      0 18px 36px -14px rgba(20, 16, 10, 0.32);
    transition: box-shadow 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .pieza__marco img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    user-select: none;
    -webkit-user-drag: none;
    transition: transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* Pie de la obra con el lenguaje de la cartela de la portada: título en
     la letra de títulos con el punto bermellón y datos en versalitas. Al pasar el ratón,
     detrás se despliega la misma tarjeta de papel de izquierda a derecha. */
  .pieza__pie {
    position: relative;
    isolation: isolate;
    align-self: flex-start;
    max-width: 100%;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    padding: 9px 14px 8px 12px;
    margin: -9px 0 0 -12px;
  }
  .pieza__pie::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 3px;
    background: rgba(250, 248, 242, 0.95);
    box-shadow: 0 6px 18px -8px rgba(20, 16, 10, 0.3);
    clip-path: inset(0 100% 0 0 round 3px);
    transition: clip-path 0.38s cubic-bezier(0.5, 0, 0.75, 0);
  }
  .pieza__titulo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pieza__titulo::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 0.14em;
    transform: scale(0);
    transition: transform 0.3s ease;
  }
  .pieza__meta {
    padding-left: 14px;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pieza__aviso {
    color: var(--accent);
  }
  /* Mismo movimiento que en la portada */
  .pieza__enlace:hover,
  .pieza__enlace:focus-visible {
    transform: translateY(-6px);
  }
  .pieza__enlace:hover .pieza__marco,
  .pieza__enlace:focus-visible .pieza__marco {
    box-shadow:
      0 2px 4px rgba(20, 16, 10, 0.1),
      0 28px 56px -18px rgba(20, 16, 10, 0.4);
  }
  .pieza__enlace:hover img,
  .pieza__enlace:focus-visible img {
    transform: scale(1.045);
  }
  .pieza__enlace:hover .pieza__pie::before,
  .pieza__enlace:focus-visible .pieza__pie::before {
    clip-path: inset(0 0 0 0 round 3px);
    transition: clip-path 0.7s cubic-bezier(0.65, 0, 0.2, 1) 0.05s;
  }
  .pieza__enlace:hover .pieza__titulo::before,
  .pieza__enlace:focus-visible .pieza__titulo::before {
    transform: scale(1);
    transition: transform 0.45s cubic-bezier(0.3, 1.4, 0.5, 1) 0.35s;
  }
  .pieza__enlace:focus-visible {
    outline: none;
  }
  .pieza__enlace:focus-visible .pieza__marco {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  /* Tarjeta final */
  .fin {
    flex: 0 0 auto;
    width: clamp(220px, 22vw, 300px);
    height: var(--h);
    scroll-snap-align: start;
  }
  .fin__enlace {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    border: 1px solid rgba(20, 20, 20, 0.18);
    color: var(--ink);
    text-decoration: none;
    transition:
      background 0.4s ease,
      color 0.4s ease;
  }
  .fin__enlace:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .fin__eti {
    font: 600 11px/1 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .fin__titulo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1;
    letter-spacing: -0.012em;
  }

  /* Llegada desde la derecha, una tras otra, al entrar la pared */
  /* (Se anima el contenido, no la tarjeta: así no se mueven los puntos de ajuste) */
  /* Solo se ocultan si el script del carrusel está activo (:defined): sin JS,
     las obras se ven siempre. */
  @media (prefers-reduced-motion: no-preference) {
    carrusel-sala:defined:not(.is-visible) .pieza__enlace,
    carrusel-sala:defined:not(.is-visible) .fin__enlace {
      opacity: 0;
      translate: 80px 0;
    }
    .pieza__enlace {
      transition:
        transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
        opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 70ms),
        translate 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 70ms);
    }
    .fin__enlace {
      transition:
        background 0.4s ease,
        color 0.4s ease,
        opacity 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 70ms),
        translate 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) calc(var(--i) * 70ms);
    }
  }

  /* ---------- Progreso ---------- */
  .progreso {
    display: flex;
    align-items: center;
    gap: 24px;
    margin: 8px var(--margen) 0;
  }
  /* Raya de progreso: el tramo oscuro es la parte visible del carril */
  .progreso__barra {
    position: relative;
    flex: 1;
    height: 2px;
    background: rgba(20, 20, 20, 0.14);
    overflow: hidden;
  }
  .progreso__barra::after {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    height: 100%;
    width: calc(var(--visible, 0.3) * 100%);
    background: var(--ink);
    transform: translateX(calc(var(--avance, 0) * (1 / var(--visible, 0.3) - 1) * 100%));
  }
  .progreso__pista {
    font: 600 11px/1 var(--font-body);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .progreso__tactil {
    display: none;
  }
  @media (hover: none) {
    .progreso__raton {
      display: none;
    }
    .progreso__tactil {
      display: inline;
    }
  }

  @media (max-width: 760px) {
    .sala {
      --h: clamp(220px, 62vw, 320px);
      --hueco: 20px;
    }
    .sala__cabeza {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'n titulo'
        'lado lado';
      gap: 14px 16px;
    }
    .sala__flechas {
      display: none;
    }
    /* «Grabado»/«Acuarela» ≈ 2,9em en Instrument Serif: caben de sobra junto al número */
    .sala__titulo {
      font-size: clamp(44px, 15vw, 72px);
    }
    .pieza__titulo {
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pieza__enlace,
    .pieza__marco,
    .pieza__marco img,
    .pieza__titulo::before,
    .pieza__pie::before,
    .flecha,
    .fin__enlace {
      transition: none;
    }
    .pieza__enlace:hover,
    .pieza__enlace:focus-visible {
      transform: none;
    }
  }
</style>

<script>
  class CarruselSala extends HTMLElement {
    private carril!: HTMLElement;
    private barra!: HTMLElement | null;
    private flechas: HTMLButtonElement[] = [];
    private reducir = matchMedia('(prefers-reduced-motion: reduce)');

    connectedCallback() {
      this.carril = this.querySelector('[data-carril]')!;
      this.barra = this.querySelector('[data-barra]');
      this.flechas = [...this.querySelectorAll<HTMLButtonElement>('[data-paso]')];

      // Llegada de las obras al entrar la pared en pantalla.
      new IntersectionObserver(
        ([e], obs) => {
          if (!e.isIntersecting) return;
          this.classList.add('is-visible');
          obs.disconnect();
        },
        { threshold: 0.15 }
      ).observe(this);

      // Progreso y estado de las flechas.
      let pendiente = false;
      const actualizar = () => {
        if (pendiente) return;
        pendiente = true;
        requestAnimationFrame(() => {
          pendiente = false;
          this.pintarProgreso();
        });
      };
      this.carril.addEventListener('scroll', actualizar, { passive: true });
      addEventListener('resize', actualizar);
      this.pintarProgreso();

      this.flechas.forEach((b) =>
        b.addEventListener('click', () => {
          const paso = Number(b.dataset.paso) * this.carril.clientWidth * 0.75;
          this.carril.scrollBy({ left: paso, behavior: this.reducir.matches ? 'instant' : 'smooth' });
        })
      );

      this.arrastre();
    }

    private pintarProgreso() {
      const { scrollLeft, scrollWidth, clientWidth } = this.carril;
      const max = Math.max(1, scrollWidth - clientWidth);
      const visible = Math.min(1, clientWidth / scrollWidth);
      this.barra?.style.setProperty('--visible', visible.toFixed(4));
      this.barra?.style.setProperty('--avance', (scrollLeft / max).toFixed(4));
      const [ant, sig] = this.flechas;
      if (ant) ant.disabled = scrollLeft <= 2;
      if (sig) sig.disabled = scrollLeft >= max - 2;
    }

    /** Arrastrar con el ratón, con inercia al soltar (en táctil, el desplazamiento nativo). */
    private arrastre() {
      const c = this.carril;
      let activo: { id: number; x: number; t: number; recorrido: number } | null = null;
      let velocidad = 0;
      let marco = 0;

      c.addEventListener('pointerdown', (e) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        cancelAnimationFrame(marco);
        activo = { id: e.pointerId, x: e.clientX, t: performance.now(), recorrido: 0 };
        velocidad = 0;
      });
      addEventListener(
        'pointermove',
        (e) => {
          if (!activo || e.pointerId !== activo.id) return;
          const ahora = performance.now();
          const dx = e.clientX - activo.x;
          activo.recorrido += Math.abs(dx);
          if (activo.recorrido > 6 && !c.classList.contains('is-arrastrando')) {
            c.classList.add('is-arrastrando');
            try {
              c.setPointerCapture(activo.id);
            } catch {
              /* sin captura */
            }
          }
          c.scrollLeft -= dx;
          velocidad = velocidad * 0.3 + (dx / Math.max(8, ahora - activo.t)) * 0.7;
          activo.x = e.clientX;
          activo.t = ahora;
        },
        { passive: true }
      );
      const soltar = (e: PointerEvent) => {
        if (!activo || e.pointerId !== activo.id) return;
        const arrastro = activo.recorrido > 6;
        const quieto = performance.now() - activo.t > 90;
        activo = null;
        if (arrastro) {
          // El clic que sigue a un arrastre no abre la obra.
          const bloquear = (ev: Event) => {
            ev.preventDefault();
            ev.stopPropagation();
          };
          addEventListener('click', bloquear, { capture: true, once: true });
          setTimeout(() => removeEventListener('click', bloquear, { capture: true }), 0);
        }
        if (!arrastro || quieto || this.reducir.matches) {
          c.classList.remove('is-arrastrando');
          return;
        }
        // Inercia: px/ms que se frenan; al parar vuelve el ajuste a cada obra.
        let v = Math.max(-4, Math.min(4, velocidad)) * 16;
        const paso = () => {
          c.scrollLeft -= v;
          v *= 0.92;
          if (Math.abs(v) > 0.5) marco = requestAnimationFrame(paso);
          else c.classList.remove('is-arrastrando');
        };
        marco = requestAnimationFrame(paso);
      };
      addEventListener('pointerup', soltar);
      addEventListener('pointercancel', soltar);
      c.addEventListener('dragstart', (e) => e.preventDefault());
    }
  }

  if (!customElements.get('carrusel-sala')) customElements.define('carrusel-sala', CarruselSala);
</script>
