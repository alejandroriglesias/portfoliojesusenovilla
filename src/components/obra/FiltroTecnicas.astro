---
/**
 * Píldoras para filtrar por técnica (aria-pressed).
 * Filtra los elementos [data-filtrable] (por su data-tecnica) dentro de los
 * contenedores [data-filtro-objetivo="<objetivo>"]; renumera los [data-num]
 * visibles y anuncia el resultado. Recuerda la elección en la URL (?tecnica=).
 */
interface Opcion {
  id: string;
  label: string;
  count: number;
}
interface Props {
  opciones: Opcion[];
  objetivo: string;
  /** Mostrar el número de obras en cada píldora. */
  contar?: boolean;
}

const { opciones, objetivo, contar = true } = Astro.props;
---

<filtro-tecnicas class="filtro" data-objetivo={objetivo}>
  <div role="group" aria-label="Filtrar por técnica" class="filtro__grupo">
    {
      opciones.map((o, i) => (
        <button type="button" class="pildora" data-id={o.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {o.label}
          {contar && <span class="pildora__n">{o.count}</span>}
        </button>
      ))
    }
  </div>
  <p class="sr-only" aria-live="polite" data-anuncio></p>
</filtro-tecnicas>

<style>
  .filtro {
    display: block;
  }
  .filtro__grupo {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .pildora {
    min-height: var(--tap);
    padding: 10px 18px;
    border-radius: var(--radius-pill);
    border: 1px solid #cfccc5;
    background: transparent;
    color: var(--ink);
    font: 600 14px/1 var(--font-body);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .pildora:hover {
    border-color: var(--ink);
  }
  .pildora[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
  .pildora__n {
    margin-left: 8px;
    opacity: 0.6;
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  class FiltroTecnicas extends HTMLElement {
    connectedCallback() {
      const botones = [...this.querySelectorAll<HTMLButtonElement>('.pildora')];
      const anuncio = this.querySelector<HTMLElement>('[data-anuncio]');
      const objetivo = this.dataset.objetivo;

      const aplicar = (id: string, anunciar = true) => {
        botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.id === id)));
        let visibles = 0;
        document.querySelectorAll(`[data-filtro-objetivo="${objetivo}"]`).forEach((cont) => {
          let n = 0;
          cont.querySelectorAll<HTMLElement>('[data-filtrable]').forEach((el) => {
            const ver = id === 'todo' || el.dataset.tecnica === id;
            el.hidden = !ver;
            if (ver) {
              n++;
              const num = el.querySelector('[data-num]');
              if (num) num.textContent = String(n).padStart(2, '0');
            }
          });
          visibles = n;
        });
        if (anuncio && anunciar) anuncio.textContent = `${visibles} ${visibles === 1 ? 'obra' : 'obras'}`;
        try {
          const url = new URL(location.href);
          if (id === 'todo') url.searchParams.delete('tecnica');
          else url.searchParams.set('tecnica', id);
          history.replaceState(history.state, '', url);
        } catch {
          /* sin acceso al historial: no pasa nada */
        }
      };

      botones.forEach((b) => b.addEventListener('click', () => aplicar(b.dataset.id ?? 'todo')));

      // Enlaces [data-filtrar="<id>"] (p. ej. las tarjetas de técnica de las
      // portadas): filtran aquí mismo y bajan hasta la obra, sin recargar.
      document.addEventListener('click', (e) => {
        const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-filtrar]');
        const id = a?.dataset.filtrar;
        if (!a || !id || !botones.some((b) => b.dataset.id === id)) return;
        e.preventDefault();
        aplicar(id);
        const destino = document.getElementById(a.hash.slice(1)) ?? this;
        destino.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        botones.find((b) => b.dataset.id === id)?.focus({ preventScroll: true });
      });

      const inicial = new URLSearchParams(location.search).get('tecnica');
      if (inicial && botones.some((b) => b.dataset.id === inicial)) aplicar(inicial, false);
    }
  }
  if (!customElements.get('filtro-tecnicas')) customElements.define('filtro-tecnicas', FiltroTecnicas);
</script>
