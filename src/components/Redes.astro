---
/**
 * Botones redondos con las redes del artista (las que estén rellenas en
 * Ajustes) y el correo. Solo aparecen las que tienen dirección.
 * - tono «claro»: sobre fondos claros (portada).
 * - tono «oscuro»: sobre el pie negro.
 */
import { getAjustes, esMarcador } from '../lib/ajustes';

interface Props {
  tono?: 'claro' | 'oscuro';
  /** Texto junto a los botones (p. ej. «Sigue mi obra»). */
  etiqueta?: string;
}
const { tono = 'claro', etiqueta } = Astro.props;
const a = await getAjustes();

const valida = (url?: string | null) => !!url && !esMarcador(url) && /^https?:\/\//.test(url);
const emailValido = !!a.email && !esMarcador(a.email) && a.email.includes('@');

// Iconos de 24×24 dibujados con trazo (mismo grosor que el resto de la web).
const ICONOS = {
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="0.6" fill="currentColor" stroke="none"/>',
  facebook: '<path d="M14.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.6-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H9v3h2.5V21"/>',
  tiktok: '<path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 3c.4 2.6 2.1 4.3 5 4.6"/>',
  youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.2 9.2v5.6l4.8-2.8z" fill="currentColor" stroke="none"/>',
  correo: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
} as const;

const redes = [
  { id: 'instagram', nombre: 'Instagram', href: a.instagram, rel: 'me noopener' },
  { id: 'facebook', nombre: 'Facebook', href: a.facebook, rel: 'me noopener' },
  { id: 'tiktok', nombre: 'TikTok', href: a.tiktok, rel: 'me noopener' },
  { id: 'youtube', nombre: 'YouTube', href: a.youtube, rel: 'me noopener' },
]
  .filter((r) => valida(r.href))
  .concat(emailValido ? [{ id: 'correo', nombre: 'Correo', href: `mailto:${a.email}`, rel: '' }] : []) as {
  id: keyof typeof ICONOS;
  nombre: string;
  href: string;
  rel: string;
}[];
---

{
  redes.length > 0 && (
    <ul class:list={['redes', `redes--${tono}`]} role="list">
      {etiqueta && (
        <li class="redes__etiqueta" aria-hidden="true">
          {etiqueta}
        </li>
      )}
      {redes.map((r) => (
        <li>
          <a class="redes__boton" href={r.href} rel={r.rel || undefined} aria-label={r.nombre} title={r.nombre}>
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={ICONOS[r.id]} />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .redes {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .redes__etiqueta {
    margin-right: 8px;
    font: 600 11px/1 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .redes__boton {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: 50%;
    text-decoration: none;
    transition:
      background 0.35s ease,
      color 0.35s ease,
      border-color 0.35s ease,
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .redes__boton:hover {
    transform: translateY(-3px);
  }

  .redes--claro .redes__etiqueta {
    color: var(--muted);
  }
  .redes--claro .redes__boton {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    color: var(--ink);
  }
  .redes--claro .redes__boton:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .redes--oscuro .redes__etiqueta {
    color: var(--footer-text);
  }
  .redes--oscuro .redes__boton {
    border: 1px solid rgba(250, 250, 248, 0.22);
    color: var(--footer-link);
  }
  .redes--oscuro .redes__boton:hover {
    background: var(--footer-link);
    border-color: var(--footer-link);
    color: var(--footer-bg);
  }
  .redes--oscuro .redes__boton:focus-visible {
    outline-color: var(--accent-on-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .redes__boton,
    .redes__boton:hover {
      transition: none;
      transform: none;
    }
  }
</style>
