<script>
  import { abrirAjustesCookies } from '../lib/consentimiento';

  const raiz = document.documentElement;
  const cabecera = document.querySelector<HTMLElement>('[data-cabecera-el]');
  const superpuesta = !!cabecera?.classList.contains('cabecera--superpuesta');
  const reducir = matchMedia('(prefers-reduced-motion: reduce)');
  const hayDialogo = () => !!document.querySelector('dialog[open]');

  /* ====================== Tono adaptativo ======================
   * «claro» u «oscuro» bajo la navegación (data-cabecera), bajo la firma
   * (data-cabecera-marca) y bajo los botones (data-cabecera-boton). Se salta
   * la propia cabecera y mira lo que hay debajo: si es una foto, su
   * luminosidad real en ese punto (miniatura en un canvas); si no, el primer
   * fondo opaco subiendo por el árbol. */
  const luminancia = (color: string) => {
    const m = color.match(/rgba?\(([^)]+)\)/);
    if (!m) return null;
    const [r, g, b, a = '1'] = m[1].split(/[\s,\/]+/).filter(Boolean);
    if (parseFloat(a) < 0.5) return null;
    return (0.2126 * +r + 0.7152 * +g + 0.0722 * +b) / 255;
  };
  const miniaturas = new WeakMap<HTMLImageElement, Uint8ClampedArray | null>();
  const N = 24;
  const lumFoto = (img: HTMLImageElement, x: number, y: number) => {
    if (!img.complete || !img.naturalWidth) return null;
    let datos = miniaturas.get(img);
    if (datos === undefined) {
      try {
        const c = document.createElement('canvas');
        c.width = N;
        c.height = N;
        const ctx = c.getContext('2d', { willReadFrequently: true })!;
        ctx.drawImage(img, 0, 0, N, N);
        datos = ctx.getImageData(0, 0, N, N).data;
      } catch {
        datos = null;
      }
      miniaturas.set(img, datos);
    }
    if (!datos) return null;
    // Punto de la pantalla → punto de la imagen (con object-fit: cover).
    const r = img.getBoundingClientRect();
    let u = (x - r.left) / r.width;
    let v = (y - r.top) / r.height;
    if (getComputedStyle(img).objectFit === 'cover') {
      const s = Math.max(r.width / img.naturalWidth, r.height / img.naturalHeight);
      const dw = img.naturalWidth * s;
      const dh = img.naturalHeight * s;
      u = (x - r.left - (r.width - dw) / 2) / dw;
      v = (y - r.top - (r.height - dh) / 2) / dh;
    }
    const i = Math.min(N - 1, Math.max(0, Math.floor(u * N)));
    const j = Math.min(N - 1, Math.max(0, Math.floor(v * N)));
    let suma = 0;
    let n = 0;
    for (let dj = -1; dj <= 1; dj++)
      for (let di = -1; di <= 1; di++) {
        const ii = Math.min(N - 1, Math.max(0, i + di));
        const jj = Math.min(N - 1, Math.max(0, j + dj));
        const k = (jj * N + ii) * 4;
        suma += (0.2126 * datos[k] + 0.7152 * datos[k + 1] + 0.0722 * datos[k + 2]) / 255;
        n++;
      }
    return suma / n;
  };
  const tonoEn = (x: number, y: number) => {
    for (const el of document.elementsFromPoint(x, y)) {
      if (el.closest('.cabecera, aviso-cookies')) continue;
      if (el instanceof HTMLImageElement) {
        const l = lumFoto(el, x, y);
        if (l !== null) return l < 0.42 ? 'oscuro' : 'claro';
        continue;
      }
      for (let n: Element | null = el; n && n !== raiz; n = n.parentElement) {
        const l = luminancia(getComputedStyle(n).backgroundColor);
        if (l !== null) return l < 0.4 ? 'oscuro' : 'claro';
      }
      return 'claro';
    }
    return 'claro';
  };
  const visible = (el?: Element | null) => {
    const r = el?.getBoundingClientRect();
    return r && r.width > 0 && r.height > 0 ? r : null;
  };
  const medir = () => {
    if (!cabecera || cabecera.classList.contains('is-oculta') || hayDialogo()) return;
    const nav = visible(cabecera.querySelector('.cabecera__nav'));
    const marca = visible(cabecera.querySelector('.cabecera__marca'));
    const acciones = visible(cabecera.querySelector('.cabecera__acciones'));
    if (nav) {
      const t = tonoEn(nav.left + nav.width * 0.5, nav.top + nav.height / 2);
      if (raiz.dataset.cabecera !== t) raiz.dataset.cabecera = t;
    }
    if (marca) {
      const t = tonoEn(marca.left + marca.width / 2, marca.top + marca.height / 2);
      if (raiz.dataset.cabeceraMarca !== t) raiz.dataset.cabeceraMarca = t;
      // En móvil no hay píldora: la navegación toma el tono de los botones.
      if (!nav && acciones) {
        const tb = tonoEn(acciones.left + acciones.width / 2, acciones.top + acciones.height / 2);
        if (raiz.dataset.cabecera !== tb) raiz.dataset.cabecera = tb;
      }
    }
    if (acciones) {
      const t = tonoEn(acciones.left + acciones.width * 0.6, acciones.top + acciones.height / 2);
      if (raiz.dataset.cabeceraBoton !== t) raiz.dataset.cabeceraBoton = t;
    }
  };
  let pendiente = false;
  const actualizar = () => {
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(() => {
      pendiente = false;
      medir();
    });
  };
  addEventListener('scroll', actualizar, { passive: true });
  addEventListener('resize', actualizar);
  addEventListener('load', actualizar);
  document.addEventListener('load', actualizar, true); // cada foto que termina de cargar
  // Sobre fondos que se mueven solos (portada, carruseles) se repasa a menudo.
  if (superpuesta) setInterval(() => !document.hidden && actualizar(), 400);
  actualizar();

  /* ====================== Resaltado que se desliza ====================== */
  const nav = cabecera?.querySelector<HTMLElement>('[data-nav]');
  const indicador = nav?.querySelector<HTMLElement>('[data-indicador]');
  if (nav && indicador) {
    nav.classList.add('con-js');
    const enlacesNav = [...nav.querySelectorAll<HTMLAnchorElement>('.cabecera__enlace')];
    const activoNav = enlacesNav.find((a) => a.getAttribute('aria-current') === 'page');
    const ir = (a?: HTMLElement, animar = true) => {
      if (!a) {
        nav.classList.remove('con-indicador');
        return;
      }
      if (!animar) nav.classList.add('sin-transicion');
      nav.style.setProperty('--ind-x', `${a.offsetLeft}px`);
      nav.style.setProperty('--ind-w', `${a.offsetWidth}px`);
      nav.classList.add('con-indicador');
      if (!animar) requestAnimationFrame(() => requestAnimationFrame(() => nav.classList.remove('sin-transicion')));
    };
    const colocar = () => ir(activoNav, false);
    colocar();
    document.fonts?.ready.then(colocar);
    addEventListener('resize', colocar);
    enlacesNav.forEach((a) => {
      a.addEventListener('pointerenter', () => ir(a));
      a.addEventListener('focus', () => ir(a));
    });
    nav.addEventListener('pointerleave', () => ir(activoNav));
    nav.addEventListener('focusout', (e) => {
      if (!nav.contains(e.relatedTarget as Node)) ir(activoNav);
    });
  }

  /* ====================== Se esconde al bajar ====================== */
  if (cabecera) {
    let ultimaY = scrollY;
    let encima = false;
    cabecera.addEventListener('pointerenter', () => (encima = true));
    cabecera.addEventListener('pointerleave', () => (encima = false));
    const ocultar = (si: boolean) => {
      if (cabecera.classList.contains('is-oculta') === si) return;
      cabecera.classList.toggle('is-oculta', si);
      if (!si) actualizar();
    };
    addEventListener(
      'scroll',
      () => {
        const y = scrollY;
        const dy = y - ultimaY;
        if (Math.abs(dy) < 6) return;
        ultimaY = y;
        const fijo = reducir.matches || encima || cabecera.contains(document.activeElement) || hayDialogo();
        if (y < 140 || dy < 0 || fijo) ocultar(false);
        else ocultar(true);
      },
      { passive: true }
    );
    cabecera.addEventListener('focusin', () => ocultar(false));
  }

  /* ====================== Menú de móvil ====================== */
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const botonMenu = document.querySelector<HTMLButtonElement>('[data-abrir-menu]');
  const cerrarMenu = () => {
    if (!menu?.open) return;
    if (reducir.matches) return menu.close();
    menu.classList.add('is-cerrando');
    menu.addEventListener(
      'animationend',
      () => {
        menu.classList.remove('is-cerrando');
        menu.close();
      },
      { once: true }
    );
  };
  if (menu && botonMenu) {
    botonMenu.addEventListener('click', () => {
      menu.showModal();
      botonMenu.setAttribute('aria-expanded', 'true');
    });
    menu.addEventListener('close', () => botonMenu.setAttribute('aria-expanded', 'false'));
    menu.querySelector('[data-cerrar-menu]')?.addEventListener('click', cerrarMenu);
    // Esc: con la animación de salida
    menu.addEventListener('cancel', (e) => {
      e.preventDefault();
      cerrarMenu();
    });
    // Al pasar a escritorio, fuera el menú
    matchMedia('(min-width: 761px)').addEventListener('change', (e) => e.matches && menu.open && menu.close());
  }

  /* ====================== Buscador ====================== */
  type Item = { t: string; u?: string; m?: string; d?: string; i?: string; x?: 1; accion?: string; fuera?: boolean; tipo?: string };
  const buscador = document.querySelector<HTMLDialogElement>('[data-buscador]');
  const campo = buscador?.querySelector<HTMLInputElement>('[data-buscador-campo]');
  const lista = buscador?.querySelector<HTMLElement>('[data-resultados]');
  const estado = buscador?.querySelector<HTMLElement>('[data-estado]');
  const datosFijos = JSON.parse(buscador?.querySelector('[data-buscador-datos]')?.textContent || '{}') as {
    paginas: Item[];
    atajos: Item[];
  };

  let indice: { obras: Item[]; tecnicas: Item[] } | null = null;
  let cargando: Promise<void> | null = null;
  const cargar = () =>
    (cargando ??= fetch('/buscar.json')
      .then((r) => r.json())
      .then((j) => {
        indice = j;
      })
      .catch(() => {
        cargando = null;
      }));

  // Normaliza sin acentos y en minúsculas, carácter a carácter (así los
  // índices coinciden con el texto original para resaltar).
  const norm1 = (c: string) => c.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase().charAt(0) || c;
  const norm = (s: string) => [...s].map(norm1).join('');
  const escapar = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const resaltar = (texto: string, palabras: string[]) => {
    if (!palabras.length) return escapar(texto);
    const n = norm(texto);
    const marcas = new Array(texto.length).fill(false);
    for (const p of palabras) {
      let k = n.indexOf(p);
      while (k !== -1) {
        for (let j = k; j < k + p.length; j++) marcas[j] = true;
        k = n.indexOf(p, k + p.length);
      }
    }
    let html = '';
    let dentro = false;
    [...texto].forEach((c, j) => {
      if (marcas[j] && !dentro) html += '<mark>';
      if (!marcas[j] && dentro) html += '</mark>';
      dentro = marcas[j];
      html += escapar(c);
    });
    return dentro ? html + '</mark>' : html;
  };

  const ICONOS: Record<string, string> = {
    pagina: '<path d="M7 3.5h7l4 4V20a.5.5 0 0 1-.5.5h-10A.5.5 0 0 1 7 20z"/><path d="M14 3.5V8h4"/>',
    tecnica: '<path d="M4 20c4-1 6-4 7-7l6-6a2.1 2.1 0 0 0-3-3l-6 6c-3 1-6 3-7 7"/><path d="M13 7l4 4"/>',
    azar: '<rect x="4" y="4" width="16" height="16" rx="3.5"/><circle cx="9" cy="9" r="1" fill="currentColor"/><circle cx="15" cy="15" r="1" fill="currentColor"/><circle cx="12" cy="12" r="1" fill="currentColor"/>',
    correo: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6.5l8.5 6.5 8.5-6.5"/>',
    enlace: '<path d="M14 4h6v6M10 14L20 4M19 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1h6"/>',
    cookies: '<circle cx="12" cy="12" r="8.5"/><circle cx="9" cy="10" r="1" fill="currentColor"/><circle cx="14.5" cy="14" r="1" fill="currentColor"/><circle cx="14" cy="8.5" r="0.8" fill="currentColor"/>',
  };
  const icono = (it: Item) => {
    if (it.i) return `<img src="${escapar(it.i)}" alt="" loading="lazy" decoding="async" />`;
    const clave =
      it.accion === 'azar' ? 'azar' : it.accion === 'cookies' ? 'cookies' : it.u?.startsWith('mailto:') ? 'correo' : it.fuera ? 'enlace' : it.tipo === 'tecnica' ? 'tecnica' : 'pagina';
    return `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICONOS[clave]}</svg>`;
  };

  let opciones: { el: HTMLElement; item: Item }[] = [];
  let activa = -1;

  const marcar = (i: number, desplazar = true) => {
    if (!opciones.length || !campo) return;
    activa = (i + opciones.length) % opciones.length;
    opciones.forEach((o, k) => o.el.setAttribute('aria-selected', String(k === activa)));
    const el = opciones[activa].el;
    campo.setAttribute('aria-activedescendant', el.id);
    if (desplazar) el.scrollIntoView({ block: 'nearest' });
  };

  const puntuar = (it: Item, palabras: string[]) => {
    const t = norm(it.t);
    const resto = norm(`${it.m ?? ''} ${it.d ?? ''}`);
    let puntos = 0;
    for (const p of palabras) {
      if (t.startsWith(p)) puntos += 6;
      else if (t.split(/\s+/).some((w) => w.startsWith(p))) puntos += 4;
      else if (t.includes(p)) puntos += 3;
      else if (resto.includes(p)) puntos += 1;
      else return 0;
    }
    return puntos;
  };

  const pintar = () => {
    if (!lista || !campo) return;
    const q = norm(campo.value.trim());
    const palabras = q.split(/\s+/).filter(Boolean);
    const grupos: { titulo: string; items: Item[] }[] = [];
    const tecnicas = (indice?.tecnicas ?? []).map((t) => ({ ...t, tipo: 'tecnica' }));
    const obras = indice?.obras ?? [];

    if (!palabras.length) {
      grupos.push({ titulo: 'Ir a', items: datosFijos.paginas.slice(0, 4) });
      grupos.push({ titulo: 'Atajos', items: datosFijos.atajos });
      const destacadas = obras.filter((o) => o.x).slice(0, 6);
      if (destacadas.length) grupos.push({ titulo: 'Obras destacadas', items: destacadas });
    } else {
      const filtrar = (items: Item[], max: number) =>
        items
          .map((it, k) => ({ it, k, p: puntuar(it, palabras) }))
          .filter((r) => r.p > 0)
          .sort((a, b) => b.p - a.p || a.k - b.k)
          .slice(0, max)
          .map((r) => r.it);
      const gObras = filtrar(obras, 40);
      const gTec = filtrar(tecnicas, 8);
      const gPag = filtrar([...datosFijos.paginas, ...datosFijos.atajos], 6);
      if (gObras.length) grupos.push({ titulo: `Obras · ${gObras.length}`, items: gObras });
      if (gTec.length) grupos.push({ titulo: 'Técnicas', items: gTec });
      if (gPag.length) grupos.push({ titulo: 'Páginas y atajos', items: gPag });
    }

    let html = '';
    let n = 0;
    const items: Item[] = [];
    grupos.forEach((g, gi) => {
      html += `<div role="group" aria-labelledby="buscador-g${gi}"><p class="buscador__grupo" id="buscador-g${gi}">${escapar(g.titulo)}</p>`;
      g.items.forEach((it) => {
        const id = `buscador-op${n++}`;
        items.push(it);
        // La descripción de la imagen solo se enseña si es lo que coincide.
        const enDesc = palabras.length && it.d && !palabras.every((p) => norm(`${it.t} ${it.m ?? ''}`).includes(p));
        const fuera = it.fuera ? ' target="_blank" rel="noopener"' : '';
        const etiqueta = it.u ? `a href="${escapar(it.u)}"${fuera}` : 'div';
        html += `<${etiqueta} class="buscador__op" role="option" id="${id}" aria-selected="false" tabindex="-1">
          <span class="buscador__ico" aria-hidden="true">${icono(it)}</span>
          <span class="buscador__texto">
            <span class="buscador__t">${resaltar(it.t, palabras)}</span>
            ${it.m ? `<span class="buscador__m">${resaltar(it.m, palabras)}</span>` : ''}
            ${enDesc ? `<span class="buscador__d">${resaltar(it.d!, palabras)}</span>` : ''}
          </span>
          <span class="buscador__ir" aria-hidden="true">↵</span>
        </${it.u ? 'a' : 'div'}>`;
      });
      html += '</div>';
    });
    if (!n) {
      html = indice || !palabras.length
        ? `<p class="buscador__vacio">Nada para «${escapar(campo.value.trim())}». Prueba con una técnica, un año o lo que aparece en la obra.</p>`
        : '<p class="buscador__vacio">Cargando…</p>';
    }
    lista.innerHTML = html;
    opciones = [...lista.querySelectorAll<HTMLElement>('.buscador__op')].map((el, k) => ({ el, item: items[k] }));
    opciones.forEach((o, k) => {
      o.el.addEventListener('pointermove', () => activa !== k && marcar(k, false));
      o.el.addEventListener('click', (e) => {
        if (!o.item.u) {
          e.preventDefault();
          ejecutar(o.item);
        } else if (!o.item.fuera && !o.item.u.startsWith('mailto:')) {
          buscador?.close();
        }
      });
    });
    activa = -1;
    campo.removeAttribute('aria-activedescendant');
    if (opciones.length) marcar(0, false);
    if (estado) estado.textContent = palabras.length ? (n ? `${n} resultados` : 'Sin resultados') : '';
  };

  const azar = async () => {
    await cargar();
    const obras = indice?.obras ?? [];
    if (obras.length) location.href = obras[Math.floor(Math.random() * obras.length)].u!;
  };
  const ejecutar = (it: Item) => {
    if (it.accion === 'azar') return azar();
    if (it.accion === 'cookies') {
      buscador?.close();
      return abrirAjustesCookies();
    }
    if (!it.u) return;
    if (it.fuera) window.open(it.u, '_blank', 'noopener');
    else {
      buscador?.close();
      location.href = it.u;
    }
  };

  const abrirBuscador = () => {
    if (!buscador || !campo) return;
    if (menu?.open) menu.close();
    if (!buscador.open) buscador.showModal();
    campo.select();
    pintar();
    if (!indice) cargar()?.then(pintar);
  };

  if (buscador && campo) {
    // Atajo: Ctrl/⌘ K en Windows/Linux/Mac
    const mac = /Mac|iPhone|iPad/i.test(navigator.platform || navigator.userAgent);
    document.querySelectorAll<HTMLElement>('[data-atajo]').forEach((k) => (k.textContent = mac ? '⌘ K' : 'Ctrl K'));

    document.querySelectorAll<HTMLElement>('[data-abrir-buscador]').forEach((b) => {
      b.addEventListener('click', abrirBuscador);
      b.addEventListener('pointerenter', () => cargar(), { once: true });
    });
    buscador.querySelector('[data-cerrar-buscador]')?.addEventListener('click', () => buscador.close());
    // Clic fuera del panel: cerrar
    buscador.addEventListener('click', (e) => e.target === buscador && buscador.close());

    campo.addEventListener('input', pintar);
    campo.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        marcar(activa + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        marcar(activa - 1);
      } else if (e.key === 'Home' && opciones.length && !campo.value) {
        e.preventDefault();
        marcar(0);
      } else if (e.key === 'End' && opciones.length && !campo.value) {
        e.preventDefault();
        marcar(opciones.length - 1);
      } else if (e.key === 'Enter') {
        const o = opciones[activa];
        if (!o) return;
        e.preventDefault();
        if (o.item.u && (e.ctrlKey || e.metaKey)) window.open(o.item.u, '_blank', 'noopener');
        else ejecutar(o.item);
      }
    });

    document.addEventListener('keydown', (e) => {
      const escribiendo = (e.target as HTMLElement)?.closest?.('input, textarea, select, [contenteditable="true"]');
      if ((e.key === 'k' || e.key === 'K') && (e.ctrlKey || e.metaKey) && !e.altKey) {
        e.preventDefault();
        buscador.open ? buscador.close() : abrirBuscador();
      } else if (e.key === '/' && !escribiendo && !hayDialogo()) {
        e.preventDefault();
        abrirBuscador();
      }
    });
  }

  // «Obra al azar» del menú de móvil
  document.querySelectorAll<HTMLAnchorElement>('[data-azar]').forEach((a) =>
    a.addEventListener('click', (e) => {
      e.preventDefault();
      azar();
    })
  );
</script>
