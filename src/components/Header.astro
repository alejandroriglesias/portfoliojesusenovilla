---
/**
 * Cabecera común.
 * - Escritorio: firma · píldora de cristal con los enlaces (un resaltado se
 *   desliza al enlace activo o al que está bajo el ratón) · Buscar (Ctrl/⌘ K)
 *   · Contacto.
 * - Móvil: firma · Buscar · «Menú», que abre un menú a pantalla completa con
 *   miniaturas, accesos rápidos, redes y enlaces legales.
 * - Se esconde al bajar y reaparece al subir (no con movimiento reducido, ni
 *   con el foco o el ratón dentro).
 * - Buscador: diálogo tipo paleta de órdenes con obras (también por lo que se
 *   ve en la imagen: «puente», «nieve»…), técnicas, páginas y atajos.
 *
 * Variantes: «solida» (fija arriba con fondo) y «superpuesta» (flota sobre el
 * contenido: portada y ficha de obra).
 *
 * Tono adaptativo: un script mira qué hay debajo de la firma, de la píldora y
 * de los botones (fondo de color o la luminosidad real de la foto) y pone en
 * <html> data-cabecera (enlaces), data-cabecera-marca (firma) y
 * data-cabecera-boton (botones): «claro» u «oscuro».
 */
import { getImage } from 'astro:assets';
import { getCollection } from 'astro:content';
import { rutaLimpia } from '../lib/rutas';
import { getObras, getTecnicas, getSobreMi } from '../lib/contenido';
import { getAjustes, esMarcador } from '../lib/ajustes';
import Firma from './marca/Firma.astro';
import Redes from './Redes.astro';

interface Props {
  variante?: 'solida' | 'superpuesta';
}

const { variante = 'solida' } = Astro.props;
const ruta = rutaLimpia(Astro.url.pathname);
const activo = (href: string) => ruta === href || ruta.startsWith(href + '/');

const enlaces = [
  { href: '/obra', texto: 'Obra' },
  { href: '/tecnicas', texto: 'Técnicas' },
  { href: '/sobre-mi', texto: 'Sobre mí' },
];

// ---- Datos del menú de móvil ----
const ajustes = await getAjustes();
const emailValido = !!ajustes.email && !esMarcador(ajustes.email) && ajustes.email.includes('@');
const instagram = ajustes.instagram && !esMarcador(ajustes.instagram) ? ajustes.instagram : undefined;
const obras = await getObras();
const principales = await getTecnicas('principal');
const sobreMi = await getSobreMi();
// Para «Obra», una obra en color (el grabado ya sale en «Técnicas»): una
// destacada que no sea grabado o, si no hay, el primer óleo.
const destacada =
  obras.find((o) => o.data.destacada && o.data.tecnica.discriminant !== 'grabado') ??
  obras.find((o) => o.data.tecnica.discriminant === 'oleo') ??
  obras.find((o) => o.data.tecnica.discriminant !== 'grabado') ??
  obras[0];
const grabado = obras.find((o) => o.data.tecnica.discriminant === 'grabado');
const mini = async (im?: ImageMetadata | null) =>
  im ? (await getImage({ src: im, width: Math.min(im.width, 200), format: 'webp', quality: 65 })).src : undefined;

const enlacesMenu = [
  { href: '/obra', texto: 'Obra', meta: `${obras.length} obras`, img: await mini(destacada?.data.imagen) },
  {
    href: '/tecnicas',
    texto: 'Técnicas',
    meta: principales.map((t) => t.data.nombre).join(' · '),
    img: await mini(grabado?.data.imagenPlancha ?? grabado?.data.imagen),
  },
  { href: '/sobre-mi', texto: 'Sobre mí', meta: 'Pintor y grabador', img: await mini(sobreMi.data.retrato) },
  { href: '/contacto', texto: 'Contacto', meta: emailValido ? ajustes.email : 'Escríbeme', img: undefined },
];
const legales = (await getCollection('legal')).sort((a, b) => a.data.orden - b.data.orden);

// ---- Páginas y atajos del buscador (las obras y técnicas llegan de /buscar.json) ----
const paginas = [
  { t: 'Toda la obra', u: '/obra', m: 'Óleo, acuarela y grabado', d: 'obra catalogo galeria cuadros pinturas grabados' },
  { t: 'Técnicas', u: '/tecnicas', m: 'Óleo · Acuarela · Grabado', d: 'tecnicas como pinta proceso materiales' },
  { t: 'Sobre mí', u: '/sobre-mi', m: 'Pintor y grabador', d: 'biografia artista quien jesus senovilla' },
  { t: 'Contacto', u: '/contacto', m: 'Consultas, precios y encargos', d: 'correo email escribir comprar precio encargo' },
  ...legales.map((l) => ({ t: l.data.titulo, u: `/${l.id}`, m: 'Información legal', d: 'legal pago transferencia bizum envio privacidad cookies' })),
];
const atajos = [
  { t: 'Obra al azar', m: 'Abre una obra cualquiera', d: 'aleatoria sorpresa azar', accion: 'azar' },
  ...(emailValido ? [{ t: 'Escribir un correo', m: ajustes.email, d: 'email correo contacto', u: `mailto:${ajustes.email}` }] : []),
  ...(instagram ? [{ t: 'Instagram', m: 'Obra reciente y proceso', d: 'redes sociales instagram', u: instagram, fuera: true }] : []),
  { t: 'Ajustes de cookies', m: 'Revisar lo que aceptaste', d: 'cookies privacidad consentimiento', accion: 'cookies' },
];
---

<header class:list={['cabecera', `cabecera--${variante}`]} data-cabecera-el>
  <div class="cabecera__barra">
    <a class="cabecera__marca" href="/">
      <Firma alto="var(--alto-firma)" />
      <span class="sr-only">Jesús Senovilla — Inicio</span>
    </a>

    <nav aria-label="Principal" class="cabecera__nav" data-nav>
      <span class="cabecera__indicador" aria-hidden="true" data-indicador></span>
      {
        enlaces.map((e) => (
          <a class="cabecera__enlace" href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>
            {e.texto}
          </a>
        ))
      }
    </nav>

    <div class="cabecera__acciones">
      <button class="cabecera__buscar" type="button" data-abrir-buscador aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg>
        <span class="cabecera__buscar-texto">Buscar</span>
        <kbd class="cabecera__atajo" data-atajo>Ctrl K</kbd>
        <span class="sr-only cabecera__buscar-sr">Buscar en la web</span>
      </button>
      <a class="cabecera__cta" href="/contacto" aria-current={activo('/contacto') ? 'page' : undefined}>
        <span class="cabecera__cta-punto" aria-hidden="true"></span>
        Contacto
        <svg class="cabecera__cta-flecha" aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M8 7h9v9"></path></svg>
      </a>
      <button class="cabecera__menu" type="button" data-abrir-menu aria-haspopup="dialog" aria-controls="menu-movil">
        <span class="cabecera__menu-icono" aria-hidden="true"><i></i><i></i></span>
        Menú
      </button>
    </div>
  </div>
</header>

<!-- Menú a pantalla completa (móvil) -->
<dialog id="menu-movil" class="menu" aria-label="Menú" data-menu data-lenis-prevent>
  <div class="menu__cabeza">
    <a class="menu__marca" href="/">
      <Firma alto="44px" />
      <span class="sr-only">Jesús Senovilla — Inicio</span>
    </a>
    <button class="menu__cerrar" type="button" data-cerrar-menu>
      Cerrar
      <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
    </button>
  </div>

  <nav aria-label="Menú principal" class="menu__nav">
    <ol class="menu__lista" role="list">
      {
        enlacesMenu.map((e, i) => (
          <li class="menu__item" style={`--i: ${i}`}>
            <a class="menu__enlace" href={e.href} aria-current={activo(e.href) ? 'page' : undefined}>
              <span class="menu__num" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="menu__texto">
                <span class="menu__nombre">{e.texto}</span>
                <span class="menu__meta">{e.meta}</span>
              </span>
              {e.img ? (
                <span class="menu__mini" aria-hidden="true">
                  <img src={e.img} alt="" loading="lazy" decoding="async" />
                </span>
              ) : (
                <span class="menu__flecha" aria-hidden="true">
                  ↗
                </span>
              )}
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="menu__acciones menu__item" style={`--i: ${enlacesMenu.length}`}>
    <button class="menu__accion" type="button" data-abrir-buscador>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg>
      Buscar
    </button>
    <a class="menu__accion" href="/obra" data-azar>
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="3.5" width="17" height="17" rx="3.5"></rect><circle cx="8.5" cy="8.5" r="1.1" fill="currentColor" stroke="none"></circle><circle cx="15.5" cy="15.5" r="1.1" fill="currentColor" stroke="none"></circle><circle cx="12" cy="12" r="1.1" fill="currentColor" stroke="none"></circle></svg>
      Obra al azar
    </a>
  </div>

  <div class="menu__pie menu__item" style={`--i: ${enlacesMenu.length + 1}`}>
    <Redes tono="oscuro" />
    {
      legales.length > 0 && (
        <nav aria-label="Información legal" class="menu__legal">
          {legales.map((l) => (
            <a href={`/${l.id}`}>{l.data.titulo}</a>
          ))}
        </nav>
      )
    }
  </div>
</dialog>

<!-- Buscador (Ctrl/⌘ K o «/») -->
<dialog class="buscador" aria-label="Buscar en la web" data-buscador data-lenis-prevent>
  <div class="buscador__campo">
    <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"></circle><path d="M16 16l4.5 4.5"></path></svg>
    <input
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="buscador-resultados"
      aria-autocomplete="list"
      aria-label="Busca obras, técnicas o páginas"
      placeholder="Busca obras, técnicas, años… (p. ej. «puente»)"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      enterkeyhint="go"
      data-buscador-campo
    />
    <button class="buscador__cerrar" type="button" data-cerrar-buscador>
      <span class="buscador__esc">Esc</span>
      <span class="sr-only">Cerrar el buscador</span>
    </button>
  </div>
  <div class="buscador__resultados" id="buscador-resultados" role="listbox" aria-label="Resultados" data-resultados></div>
  <p class="sr-only" aria-live="polite" data-estado></p>
  <div class="buscador__pie" aria-hidden="true">
    <span><kbd>↑</kbd><kbd>↓</kbd> moverse</span>
    <span><kbd>↵</kbd> abrir</span>
    <span><kbd>esc</kbd> cerrar</span>
  </div>
  <script is:inline type="application/json" data-buscador-datos set:html={JSON.stringify({ paginas, atajos }).replace(/</g, '\\u003c')} />
</dialog>

<style>
  .cabecera {
    /* Alto de la firma manuscrita (el ancho sale de su proporción, ≈ 1.5). */
    --alto-firma: 64px;
    /* Píldoras (navegación y buscar) y el resaltado que se desliza */
    --pildora-fondo: rgba(20, 20, 20, 0.05);
    --pildora-borde: transparent;
    --pildora-sombra: none;
    --indicador-fondo: #ffffff;
    --indicador-sombra: 0 1px 2px rgba(20, 16, 10, 0.1), 0 6px 14px -6px rgba(20, 16, 10, 0.28);
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cabecera--superpuesta {
    --alto-firma: 62px;
  }

  /* Marca a la izquierda, enlaces centrados y acciones a la derecha */
  .cabecera__barra {
    max-width: var(--container);
    margin: 0 auto;
    padding: 8px var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas: 'marca nav acciones';
    align-items: center;
    gap: 8px 24px;
  }
  .cabecera__marca {
    grid-area: marca;
    justify-self: start;
    display: flex;
    align-items: center;
    min-height: var(--tap);
    color: inherit;
    text-decoration: none;
  }

  /* ---------- Píldora de navegación ---------- */
  .cabecera__nav {
    grid-area: nav;
    justify-self: center;
    position: relative;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 4px;
    border: 1px solid var(--pildora-borde);
    border-radius: var(--radius-pill);
    background: var(--pildora-fondo);
    box-shadow: var(--pildora-sombra);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    backdrop-filter: blur(16px) saturate(1.5);
    transition:
      background 0.45s ease,
      border-color 0.45s ease,
      box-shadow 0.45s ease,
      color 0.45s ease;
  }
  .cabecera__enlace {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    font-size: 14.5px;
    font-weight: 550;
    letter-spacing: 0.005em;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  /* El enlace activo lleva un punto bermellón */
  .cabecera__enlace[aria-current='page']::before {
    content: '';
    width: 5px;
    height: 5px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--accent);
  }
  .cabecera__indicador {
    position: absolute;
    z-index: 0;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: var(--ind-w, 0px);
    border-radius: var(--radius-pill);
    background: var(--indicador-fondo);
    box-shadow: var(--indicador-sombra);
    opacity: 0;
    transform: translateX(var(--ind-x, 0px));
    transition:
      transform 0.5s cubic-bezier(0.3, 0.9, 0.3, 1),
      width 0.5s cubic-bezier(0.3, 0.9, 0.3, 1),
      opacity 0.3s ease,
      background 0.45s ease;
  }
  .cabecera__nav.con-indicador .cabecera__indicador {
    opacity: 1;
  }
  .cabecera__nav.sin-transicion .cabecera__indicador {
    transition: none;
  }
  /* Sin JavaScript: el activo con su fondo */
  .cabecera__nav:not(.con-js) .cabecera__enlace[aria-current='page'] {
    background: var(--indicador-fondo);
    box-shadow: var(--indicador-sombra);
  }

  /* ---------- Acciones: buscar, contacto, menú ---------- */
  .cabecera__acciones {
    grid-area: acciones;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .cabecera__buscar {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: var(--tap);
    padding: 0 7px 0 15px;
    border: 1px solid var(--pildora-borde);
    border-radius: var(--radius-pill);
    background: var(--pildora-fondo);
    box-shadow: var(--pildora-sombra);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    backdrop-filter: blur(16px) saturate(1.5);
    font: 550 14px/1 var(--font-body);
    color: inherit;
    cursor: pointer;
    transition:
      background 0.45s ease,
      border-color 0.45s ease,
      color 0.45s ease;
  }
  .cabecera__buscar:hover {
    background: var(--indicador-fondo);
  }
  .cabecera__atajo {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 0 9px;
    border-radius: var(--radius-pill);
    background: var(--indicador-fondo);
    box-shadow: var(--indicador-sombra);
    font: 600 11px/1 var(--font-body);
    letter-spacing: 0.04em;
    color: inherit;
  }
  .cabecera__buscar:hover .cabecera__atajo {
    box-shadow: none;
    background: var(--pildora-fondo);
  }

  /* Contacto: píldora con el punto bermellón que late despacio y una flecha
     que aparece al pasar el ratón. */
  .cabecera__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: var(--tap);
    padding: 0 20px 0 16px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    box-shadow: 0 6px 18px -8px rgba(20, 16, 10, 0.45);
    transition:
      background 0.35s ease,
      color 0.35s ease,
      border-color 0.35s ease,
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s ease;
  }
  .cabecera__cta:hover,
  .cabecera__cta:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--on-accent);
    transform: translateY(-2px);
    box-shadow: 0 12px 26px -10px rgba(200, 55, 26, 0.6);
  }
  .cabecera__cta-punto {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }
  .cabecera__cta:hover .cabecera__cta-punto,
  .cabecera__cta:focus-visible .cabecera__cta-punto {
    background: var(--on-accent);
  }
  .cabecera__cta-punto::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: inherit;
    animation: cta-latido 2.6s ease-out infinite;
  }
  @keyframes cta-latido {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    60%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }
  .cabecera__cta-flecha {
    width: 0;
    margin-left: -9px;
    opacity: 0;
    transform: translate(-4px, 4px);
    transition:
      width 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      margin 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      opacity 0.3s ease,
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cabecera__cta:hover .cabecera__cta-flecha,
  .cabecera__cta:focus-visible .cabecera__cta-flecha {
    width: 14px;
    margin-left: 0;
    opacity: 1;
    transform: none;
  }

  /* Menú (solo móvil) */
  .cabecera__menu {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    padding: 0 18px 0 16px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font: 600 14px/1 var(--font-body);
    cursor: pointer;
    box-shadow: 0 6px 18px -8px rgba(20, 16, 10, 0.45);
    transition:
      background 0.35s ease,
      color 0.35s ease,
      border-color 0.35s ease;
  }
  .cabecera__menu-icono {
    display: grid;
    gap: 4px;
    width: 16px;
  }
  .cabecera__menu-icono i {
    display: block;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cabecera__menu-icono i:last-child {
    width: 70%;
  }
  .cabecera__menu:hover .cabecera__menu-icono i:last-child {
    transform: translateX(30%);
  }

  /* ---------- Sólida ---------- */
  .cabecera--solida {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--header-bg);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    transition:
      transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1),
      background 0.45s ease,
      color 0.45s ease,
      border-color 0.45s ease;
  }
  /* Se esconde al bajar */
  .cabecera--solida.is-oculta {
    transform: translateY(-101%);
  }

  /* Sobre zonas oscuras (data-cabecera en <html>, ver script) */
  :global(html[data-cabecera='oscuro']) .cabecera--solida {
    --pildora-fondo: rgba(255, 255, 255, 0.08);
    --indicador-fondo: rgba(255, 255, 255, 0.16);
    --indicador-sombra: none;
    background: rgba(14, 13, 12, 0.82);
    border-bottom-color: rgba(250, 250, 248, 0.1);
    color: var(--paper);
  }
  :global(html[data-cabecera='oscuro']) .cabecera--solida .cabecera__cta,
  :global(html[data-cabecera='oscuro']) .cabecera--solida .cabecera__menu {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
    box-shadow: 0 8px 22px -12px rgba(0, 0, 0, 0.6);
  }
  :global(html[data-cabecera='oscuro']) .cabecera--solida .cabecera__cta:hover,
  :global(html[data-cabecera='oscuro']) .cabecera--solida .cabecera__cta:focus-visible {
    background: var(--accent);
    border-color: var(--accent);
